import Flapjack.Parser
import Guest.IncludeStr

/-!
The guest as text, and its parse.

`Guest/guest-software.pp.pnk` is the cpp-expanded translation unit rooted at
`guest/src/main.pnk`, regenerated by `tools/gen-guest-ast.sh`. The challenge
fixes the committed AST in `Guest.SoftwareAst`. The older accelerated build is
retained for comparison. Parser agreement is not a certificate premise.

Lake only tracks this file's own text, not the files `include_str%` reads, so
the generator stamps the sources' hashes below; a changed source therefore
changes this module and forces its rebuild.
-/

-- guest.pp.pnk sha256: 414d70d031f9e367ad9e5c70bc6dbd523238a3c542fba59a09aed866f3e5f860
-- guest-software.pp.pnk sha256: 9b45fc47c61771c906d32a07ee9de1b9b876f5362084eb4e37bcd19d0a860713

namespace Guest

open Flapjack

/-- The older cpp-expanded accelerated guest source. -/
def guestSource : String := include_str% "guest.pp.pnk"

namespace Software

/-- The cpp-expanded software guest used by the challenge. -/
def guestSource : String := include_str% "guest-software.pp.pnk"

def guestParse : Except (List Parser.ParseError) (List (Decl (BitVec 64))) :=
  Parser.parseTopDecs (BitVec.ofInt 64) guestSource

end Software

/-- The guest parsed with flapjack's Pancake parser, constants
read as 64-bit words. -/
def guestParse : Except (List Parser.ParseError) (List (Decl (BitVec 64))) :=
  Parser.parseTopDecs (BitVec.ofInt 64) guestSource

/-- Optional text-parsed declarations; empty if parsing fails. The challenge
uses `guestAst` directly rather than this fallback. -/
def guestDeclarations : List (Decl (BitVec 64)) :=
  guestParse.toOption.getD []

end Guest
