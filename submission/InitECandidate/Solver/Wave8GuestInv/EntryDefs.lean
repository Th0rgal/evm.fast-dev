import InitECandidate.Solver.Wave8GuestInv.Defs

/-! Covered main-entry guards, independent of the source-clock bridge proof.
Ported from campaign/specs-proposed/GuestInv.lean (working tree based on ae2c240b83a9aa7d4af2d71a3ba479500e711f8e).
Generated by campaign/notes/guestinv/r10_inputs/split_spec.py. -/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option exponentiation.threshold 2000

namespace InitECandidate.Solver.Wave8GuestInv

open Flapjack Flapjack.Pancake.PanLang Flapjack.PanSemStateFiniteExact
open Flapjack.Basis.Pure.MlString
open InitE
open InitECandidate.Solver.GuestCodeLookup
open InitECandidate.Solver.UniformSourceClock
