      subst hb2_ast
      let ent2 := callEntryStateHOLFinite s1 cal2
      have hent2_A : ArenaReady ent2 := ⟨guestInv_callEntry s1 cal2 (heff_s_post1.locals_clock _ _).arena.1, heff_s_post1.arena.2⟩
