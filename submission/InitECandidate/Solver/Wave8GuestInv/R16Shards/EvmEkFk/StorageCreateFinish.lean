  · rw [h2.old_path x hx2]
    rcases h1.fresh_path x hx2 hnx1 with hz | hin
    · exact Or.inl hz
    · exact Or.inr ⟨hin.1, le_trans hin.2 h2.step.hp_le⟩
  · rcases h2.fresh_path x hx3 hx2 with hz | hin
    · exact Or.inl hz
    · exact Or.inr ⟨le_trans h1.step.hp_le hin.1, hin.2⟩

