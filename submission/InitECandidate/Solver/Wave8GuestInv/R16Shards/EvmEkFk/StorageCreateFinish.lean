        (memW cur (p + 8) = 2 ∧ slot.toNat = memW cur (p + 32)) := by
      rwa [hp_eq] at hslot_disj
    have hslot_lt : slot.toNat < 17 := by
      rcases hslot_nat with ⟨_, hlt⟩ | ⟨_, heq⟩
      · omega
      · rcases hf.2.2.2.2 with ⟨hk1, _⟩ | ⟨_, hcnt16, _⟩
        · omega
        · omega
