    let v := arrN + 16 * slot.toNat
    unfold resolveBranch
    refine dwRunOK_dec_ws (ofString "arr") .one (.load .one (offsetE "top" 24))
      (by intro n hn; simp at hn; rcases hn with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide)
      ?_
