private def branchIncrement_ws : ProgHOL 64 :=
  .seq (.assign .local (ofString "i") (.op .add [localE "i", .const 1]))
    (.ite (.cmp .less (localE "i") (.const 16)) branchNext_ws branchValueCall_ws)

private def branchOccupancy_ws : ProgHOL 64 :=
