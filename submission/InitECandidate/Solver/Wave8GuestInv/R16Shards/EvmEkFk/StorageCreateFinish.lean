    refine ⟨hp, hres_final, hhp_eq, hhp_al, by rw [hpost_hp, hq_eq], hmw_0, hmw_16, hmw_32, hmw_40, hmw_48, ?_⟩
    intro st0 Nd hNd hchild_root hKey hKey_fresh
