    have hhp2_lim : globN s2 "heap_ptr" ≤ heapLimit := heff_s2.arena.2.2.1
    by_cases htag0 : tag = 0#64
    · subst htag0
      have hNd2 : NodeHeap s2 Nd := hdec_s2.step.heap
