  have hcurA : ArenaReady cur := heff.arena
  have hNd : NodeHeap cur Nd := hdec.step.heap
  have hsp0_hi : globN s0 "scratch_ptr" ≤ scratchEnd := hA0.2.2.2.2.2.1
  have hse64 : scratchEnd < 2 ^ 64 := by decide
