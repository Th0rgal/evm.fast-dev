      have hpw_hi : pw.toNat + nw.toNat ≤ heapLimit := by
        rw [hnw8] at hpw_end; omega
      have hm1_sc : m1.locals.lookup (ofString "stored_code") = some (.val (.word pw)) := by
        rw [hm1_loc]; simp [HolFiniteMapExact.lookup_update, FUPDATE]
