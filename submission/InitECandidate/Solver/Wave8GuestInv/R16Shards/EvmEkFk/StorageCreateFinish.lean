private theorem progWStep_seq_worldEff_wsAcct {p1 p2 : ProgHOL 64} {F : Type}
    {s0 cur : PanSemStateFiniteExact 64 F}
    (hW0 : WorldOK s0)
    (heff1 : (evaluateHOLFiniteState cur p1).1 ≠ some .timeOut →
      ContOrRes (evaluateHOLFiniteState cur p1).1 →
