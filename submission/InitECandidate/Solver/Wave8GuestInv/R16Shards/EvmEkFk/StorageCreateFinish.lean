theorem DecoderNodeStep.trans {F : Type} {a b c : PanSemStateFiniteExact 64 F}
    {Nd1 Nd2 Nd3 : List Nat} (ha : ArenaReady a)
    (h1 : DecoderNodeStep a b Nd1 Nd2) (h2 : DecoderNodeStep b c Nd2 Nd3) :
    DecoderNodeStep a c Nd1 Nd3 := by
