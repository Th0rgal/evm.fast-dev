            (Wave8Contracts.M26.updW
              (Wave8Contracts.M26.updW
                (Wave8Contracts.M26.updW
                  (Wave8Contracts.M26.updW s.memory (hp + BitVec.ofNat 64 0) (BitVec.ofNat 64 2))
