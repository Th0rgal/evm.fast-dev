    obtain ⟨hgap, hheap⟩ := allocated_disj_free_regions (o := (n, nodeSize (memW s n))) ha.2 (Or.inl ⟨hlo, hhi_hp⟩)
    have hu : InitECandidate.Solver.Wave8Contracts.M08.IvlUnhit s post (n, nodeSize (memW s n)) :=
