  have hlim40 : heapLimit < 2 ^ 40 := by decide
  have hhl_bd := R16Shards.WkBlockTxEnc.rlpHeaderLenPure_bounds pw.toNat
  have hdisj_ext : ∀ r ∈ Rl_ext, ∀ o ∈ nodeExtents s Nd, Disj r o := by
    intro r hr o ho
