  have hMptIn_post : MptObjInWith post S Nm' (locN s "m") := by
    refine ⟨hag.allocated hm_al, wordsOK_transfer hAs.1 hAp.1 hm_w, ?_, ?_, hNH_Nm', hRoot_Nm', ?_⟩
    · intro t ht i hi
