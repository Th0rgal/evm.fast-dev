  have hmark_res : locN resumed "mark" = locN state "mark" :=
    locN_setVar_ne postCaller "mark" (ofString "m") (.val (.word wm)) (by decide)
  refine ⟨⟨hready_res, hinv, ?_, ?_, ?_, ?_⟩, ?_⟩
  · rw [harr_res, hn_res, hmark_res]
