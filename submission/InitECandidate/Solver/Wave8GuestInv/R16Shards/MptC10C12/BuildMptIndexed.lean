  left
  refine ⟨(nw.toNat + 8, 24), List.mem_append_left _ (List.mem_map.2 ⟨nw.toNat, hn_in, rfl⟩), ?_, ?_⟩
  · rw [hadd_nat]; rcases hoff with rfl | rfl | rfl <;> omega
  · rw [hadd_nat]; rcases hoff with rfl | rfl | rfl <;> omega

