    obtain ⟨_, hin_f, _⟩ := hf_c
    rw [hm_loc]
    exact hin_f.1
  · refine ⟨S1, Nd1, ?_, ?_⟩
    · exact (worldTypedWith_build_locals postCaller resumed.locals resumed.clock S1 Nd1).2
