  subst hsame
  obtain ⟨hp, q, _, hhp_eq, hhp_al, hq_eq, hq_hi, _, _, hpost_m, _, _, _, _, _, _⟩ :=
    R13Shards.mpt_new_resumes_props entry 0 0 hcode hentryW.1 hc1 hc2
