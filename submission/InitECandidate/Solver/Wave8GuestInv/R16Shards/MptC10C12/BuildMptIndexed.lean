    ((memW s nw.toNat = 1 ∨ memW s nw.toNat = 2) →
      1 ≤ memW post (frw.toNat + 32) ∧
      memW post (frw.toNat + 32) < 2 ^ 40 ∧
      globN s "heap_ptr" = memW post (frw.toNat + 24) ∧
      memW post (frw.toNat + 24) + memW post (frw.toNat + 32) ≤ globN post "heap_ptr") ∧
