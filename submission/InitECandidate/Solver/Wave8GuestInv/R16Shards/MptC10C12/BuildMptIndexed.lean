private theorem call_local_nibble_compact_exact {F : Type}
    (hnilc : ∀ (s : PanSemStateFiniteExact 64 F) (nibsw nw islw dst0 : BitVec 64) (cap : Nat) (v : ValueHOL 64),
      GuestInv s →
      dst0.toNat + cap ≤ heapLimit →
