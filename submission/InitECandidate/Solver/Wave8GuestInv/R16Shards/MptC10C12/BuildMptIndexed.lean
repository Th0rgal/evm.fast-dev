  refine ⟨localsFree_arenaReady s _ _ ha, Nd, hm.2.2.2.2.1, ?_⟩
  rw [locN_setVar_same, hw]
  simpa using hm.2.2.2.2.2.1

private theorem relaxedRoot_entry :
