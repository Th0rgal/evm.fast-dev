    · change (HolFiniteMapExact.resVarEq _ _).lookup _ = _
      repeat rw [InitECandidate.Solver.PanRunBounded.resVarEq_lookup]
      rw [if_neg (show ofString "top" ≠ ofString "nd" by decide),
          if_neg (show ofString "top" ≠ ofString "k" by decide),
          if_neg (show ofString "top" ≠ ofString "child" by decide),
