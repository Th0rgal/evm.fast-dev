          have hv_lt := hleaf_v h1
          have hv_bd := (rlpEncBytesLen_bounds s (memW s (nodew.toNat + 48)) (memW s (nodew.toNat + 56))).2.2
          omega
        · have hp := hk2_pay1 h2
          have hr_bd := nodeRefBytes_le33 s (memW s (nodew.toNat + 48))
          omega
      exact Or.inr ⟨pay1w, rfl, hs1_eq, hs1_node, hs1_k, hs1_pay, hs1_cbuf, hs1_clen,
        hpay_lt, hk1_pay, hk2_pay1, fun h3 => absurd h3 hkw_ne3⟩

