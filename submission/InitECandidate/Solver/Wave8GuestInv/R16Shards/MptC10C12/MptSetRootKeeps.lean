                  eval_decCall_alloc_resumes s1 "h" (.const 32) contK R24 gw hc hAR_s1 hgw hnt_dc hres_dc
                have hn32 : n32 = 32 := by simp [evalHOLExact] at hn32_ev; exact hn32_ev.symm
                subst hn32
                have h32_nat : (32 : BitVec 64).toNat = 32 := rfl
