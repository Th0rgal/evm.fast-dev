      out.1 = some (.returned (.val (.word hp))) ∧
      hp.toNat = globN s "heap_ptr" ∧
      globN out.2 "heap_ptr" = hp.toNat + 16 ∧
      globN out.2 "scratch_ptr" = globN s "scratch_ptr" ∧
      keccakBufIvls out.2 = keccakBufIvls s ∧
      HeapByteEff s out.2 [] ["heap_ptr"] ∧
      memW out.2 hp.toNat = locN s "root_node" ∧
      memW out.2 (hp.toNat + 8) = locN s "secured" ∧
      NodeHeapValuePtrOK out.2 [] ∧
