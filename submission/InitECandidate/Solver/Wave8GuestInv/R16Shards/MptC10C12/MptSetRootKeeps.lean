      rw [hd, he]; simp [flattenHOL, panMemStoresHOL, panMemStoreHOL, hdom]; rfl
    have step_store_var : ∀ (st : PanSemStateFiniteExact 64 F) (k : Nat) (nm : String) (w : BitVec 64),
