            (R10Shards.GbodyMptDelete.Unwind.lvar "res") = some (.val (.word wres)) := hu_res
        rw [hev_res]
        change u.memaddrs (wfnode + 32 + widx * 8) at hdom_ch
        simp only [flattenHOL, panMemStoresHOL, panMemStoreHOL, hdom_ch, ↓reduceIte]
