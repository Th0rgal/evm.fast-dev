  rw [hdc_eq, hcont_ev]; dsimp only
  let post : PanSemStateFiniteExact 64 F :=
    { st2.emptyLocalsHOLFinite with
      locals := HolFiniteMapExact.resVarEq st2.emptyLocalsHOLFinite.locals
        (ofString "m", s.locals.lookup (ofString "m")) }
  have heff_16 : HeapByteEff s post [(hp.toNat, 16)] ["heap_ptr"] :=
    ((heff_mid.mono (fun _ h => by simp at h) (fun _ hg => hg)).trans
      (heff_st1.trans heff_st2)).locals_clock post.locals post.clock
  have heff_empty : HeapByteEff s post [] ["heap_ptr"] := by
    refine ⟨heff_16.arena, heff_16.memaddrs, heff_16.hp_le, heff_16.fp_eq, heff_16.sp_le,
      heff_16.be, heff_16.globals, heff_16.out_dom, fun a hne => ?_, fun b hb hne => ?_⟩
    · rcases heff_16.cell_frame a hne with ⟨iv, hiv, _, hc1, hc2⟩ | hfg | hhf
      · simp only [List.mem_singleton] at hiv; subst hiv
        exact Or.inr (Or.inr ⟨by dsimp [heapFree]; omega, by dsimp [heapFree]; omega, by dsimp [heapFree]; omega⟩)
      · exact Or.inr (Or.inl hfg)
      · exact Or.inr (Or.inr hhf)
    · rcases heff_16.byte_frame b hb hne with ⟨iv, hiv, hi1, hi2⟩ | hfg | hhf
      · simp only [List.mem_singleton] at hiv; subst hiv
        exact Or.inr (Or.inr ⟨by dsimp [heapFree]; omega, by dsimp [heapFree]; omega⟩)
      · exact Or.inr (Or.inl hfg)
      · exact Or.inr (Or.inr hhf)
  have hpost_g : post.globals = mid.globals := hg_st2'.trans hg_st1'
  have hhp_post : globN post "heap_ptr" = hp.toNat + 16 := by
    have : globN post "heap_ptr" = globN mid "heap_ptr" := by unfold globN; rw [hpost_g]
    rw [this, hmid_hp, hq16]
  have hsp_post : globN post "scratch_ptr" = globN s "scratch_ptr" := by
    unfold globN; rw [← heff_empty.globals (ofString "scratch_ptr") (by decide)]
  have hkc_post : keccakBufIvls post = keccakBufIvls s := by
    have hkp : globN post "keccak_pad" = globN s "keccak_pad" := by
      unfold globN; rw [← heff_empty.globals (ofString "keccak_pad") (by decide)]
    have hks : globN post "keccak_st" = globN s "keccak_st" := by
      unfold globN; rw [← heff_empty.globals (ofString "keccak_st") (by decide)]
    simp [keccakBufIvls, bufferRegion, hkp, hks]
  have hmw0 : memW post hp.toNat = locN s "root_node" := by
    have h264 : heapEnd < 2 ^ 64 := by rw [heapEnd_val]; decide
    have hm_st2_st1 := hmem_st2' hp.toNat (by omega) (by omega)
    have hpm : post.memory = st2.memory := rfl
    have : memW post hp.toNat = memW st1 (hp.toNat + 0) := by
      unfold memW; rw [hpm, Nat.add_zero, hm_st2_st1]
    rw [this, hw0_st1']; simp [locN, hrn]
  have hmw8 : memW post (hp.toNat + 8) = locN s "secured" := by
    have : memW post (hp.toNat + 8) = memW st2 (hp.toNat + 8) := rfl
    rw [this, hw8_st2']; simp [locN, hsec]
  have hvs_nil : NodeHeapValuePtrOK post [] := by
    intro _ h; cases h
  exact ⟨hp, rfl, hhp_nat, hhp_post, hsp_post, hkc_post, heff_empty, hmw0, hmw8,
    hvs_nil,
    fun Nd hN hvs => nodeHeapValuePtrOK_of_empty_heapByteEff hAR hN heff_empty hsp_post hkc_post hvs⟩

/-! ## `NodeHeap` Intersection, `ValFrom`, `ValExtNodeStep`, and `NodeHeapValuePtrOK` Lifting -/

theorem keyIn_mono_superset {F : Type} {s : PanSemStateFiniteExact 64 F}
    {Nd_sub Nd : List Nat} {p len : Nat}
    (hsub : ∀ n ∈ Nd_sub, n ∈ Nd)
    (hk : KeyIn s Nd p len) : KeyIn s Nd_sub p len := by
  rcases hk with hz | ⟨hnib, hal, hins, hdj⟩
  · exact Or.inl hz
  · exact Or.inr ⟨hnib, hal, hins, fun m hm => hdj m (hsub m hm)⟩

theorem rootIn_inter {Nd1 Nd2 : List Nat} {r : Nat}
    (hr1 : RootIn Nd1 r) (hr2 : RootIn Nd2 r) :
    RootIn (Nd1.filter (fun x => decide (x ∈ Nd2))) r := by
  rcases hr1 with rfl | hm1
  · exact Or.inl rfl
  · rcases hr2 with rfl | hm2
    · exact Or.inl rfl
    · exact Or.inr (List.mem_filter.2 ⟨hm1, decide_eq_true hm2⟩)

theorem nodeHeap_inter {F : Type} {s : PanSemStateFiniteExact 64 F}
    {Nd1 Nd2 : List Nat} (h1 : NodeHeap s Nd1) (h2 : NodeHeap s Nd2) :
    NodeHeap s (Nd1.filter (fun x => decide (x ∈ Nd2))) := by
  refine ⟨fun n hn => ?_, fun n hn m hm hne => ?_⟩
  · obtain ⟨hn1, hn2_b⟩ := List.mem_filter.1 hn
    have hn2 : n ∈ Nd2 := of_decide_eq_true hn2_b
    obtain ⟨hk, hal, hins, hw, hext1, hbr1, hkey1, hc16, hv1, hv3⟩ := h1.1 n hn1
    obtain ⟨_, _, _, _, hext2, hbr2, _, _, _, _⟩ := h2.1 n hn2
    refine ⟨hk, hal, hins, hw,
      fun h2k => rootIn_inter (hext1 h2k) (hext2 h2k),
      fun h3k i hi => rootIn_inter (hbr1 h3k i hi) (hbr2 h3k i hi),
      fun hk12 => keyIn_mono_superset (fun m hm => (List.mem_filter.1 hm).1) (hkey1 hk12),
      hc16, hv1, hv3⟩
  · exact h1.2 n (List.mem_filter.1 hn).1 m (List.mem_filter.1 hm).1 hne

theorem nodeValuesSafe_subset {F : Type} {sp0 : Nat} {s : PanSemStateFiniteExact 64 F}
    {Nd_sub Nd : List Nat} (hsub : ∀ n ∈ Nd_sub, n ∈ Nd)
    (hvs : NodeValuesSafe sp0 s Nd) : NodeValuesSafe sp0 s Nd_sub := by
  intro n hn
  obtain ⟨hl, hb⟩ := hvs n (hsub n hn)
  refine ⟨fun hk1 hvl1 hord => ?_, fun hk3 hvl3 hord => ?_⟩
  · obtain ⟨hcache, hkc, hfg, hhf⟩ := hl hk1 hvl1 hord
    exact ⟨fun m hm => hcache m (hsub m hm), hkc, hfg, hhf⟩
  · obtain ⟨hcache, hkc, hfg, hhf⟩ := hb hk3 hvl3 hord
    exact ⟨fun m hm => hcache m (hsub m hm), hkc, hfg, hhf⟩

theorem nodeHeapValuePtrOK_subset {F : Type} {s : PanSemStateFiniteExact 64 F}
    {Nd_sub Nd : List Nat} (hsub : ∀ n ∈ Nd_sub, n ∈ Nd)
    (hvs : NodeHeapValuePtrOK s Nd) : NodeHeapValuePtrOK s Nd_sub :=
  nodeValuesSafe_subset hsub hvs

theorem valuePtrSafe_subset {F : Type} {s : PanSemStateFiniteExact 64 F}
    {Nd_sub Nd : List Nat} {vptr vlen : Nat}
    (hsub : ∀ n ∈ Nd_sub, n ∈ Nd)
    (hvp : ValuePtrSafe s Nd vptr vlen) : ValuePtrSafe s Nd_sub vptr vlen := by
  intro hv1 hord
  obtain ⟨hcache, hkc, hfg, hhf⟩ := hvp hv1 hord
  exact ⟨fun m hm => hcache m (hsub m hm), hkc, hfg, hhf⟩

theorem nodeExtents_subset {F : Type} {s : PanSemStateFiniteExact 64 F}
    {Nd_sub Nd : List Nat} (hsub : ∀ n ∈ Nd_sub, n ∈ Nd) :
    ∀ o ∈ nodeExtents s Nd_sub, o ∈ nodeExtents s Nd := by
  intro o ho
  unfold nodeExtents at ho ⊢
  obtain ⟨n, hn, hnp⟩ := List.mem_flatMap.1 ho
  exact List.mem_flatMap.2 ⟨n, hsub n hn, hnp⟩

/-- Provenance of a value slice `(vp, vlen)` wrt pre-state `(s, Nd)` and extra allowed pairs `V`. -/
def ValFrom {F : Type} (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
    (V : List (Nat × Nat)) (vp vlen : Nat) : Prop :=
  vlen = 0 ∨ (vp, vlen) ∈ V ∨
  (∃ m ∈ Nd, memW s m = 1 ∧ vp = memW s (m + 48) ∧ vlen = memW s (m + 56)) ∨
  (∃ m ∈ Nd, memW s m = 3 ∧ vp = memW s (m + 160) ∧ vlen = memW s (m + 168))

/-- `ExtNodeStep K s post Nd Nd'` augmented with value-pointer provenance `ValFrom s Nd V`. -/
def ValExtNodeStep {F : Type} (K : List Ivl) (V : List (Nat × Nat))
    (s post : PanSemStateFiniteExact 64 F) (Nd Nd' : List Nat) : Prop :=
  ExtNodeStep K s post Nd Nd' ∧
  ∀ n ∈ Nd',
    (memW post n = 1 → ValFrom s Nd V (memW post (n + 48)) (memW post (n + 56))) ∧
    (memW post n = 3 → ValFrom s Nd V (memW post (n + 160)) (memW post (n + 168)))

theorem ValFrom.mono {F : Type} {s : PanSemStateFiniteExact 64 F}
    {Nd : List Nat} {V V' : List (Nat × Nat)} {vp vlen : Nat}
    (h : ValFrom s Nd V vp vlen) (hV : ∀ pv ∈ V, pv ∈ V') :
    ValFrom s Nd V' vp vlen := by
  rcases h with h0 | hmem | hl | hb
  · exact Or.inl h0
  · exact Or.inr (Or.inl (hV _ hmem))
  · exact Or.inr (Or.inr (Or.inl hl))
  · exact Or.inr (Or.inr (Or.inr hb))

theorem ValFrom.trans {F : Type} {a b : PanSemStateFiniteExact 64 F}
    {Nd1 Nd2 : List Nat} {V : List (Nat × Nat)} {vp vlen : Nat}
    (h1 : ∀ n ∈ Nd2,
      (memW b n = 1 → ValFrom a Nd1 V (memW b (n + 48)) (memW b (n + 56))) ∧
      (memW b n = 3 → ValFrom a Nd1 V (memW b (n + 160)) (memW b (n + 168))))
    (h2 : ValFrom b Nd2 V vp vlen) :
    ValFrom a Nd1 V vp vlen := by
  rcases h2 with h0 | hmem | ⟨m, hm, hk1, rfl, rfl⟩ | ⟨m, hm, hk3, rfl, rfl⟩
  · exact Or.inl h0
  · exact Or.inr (Or.inl hmem)
  · exact (h1 m hm).1 hk1
  · exact (h1 m hm).2 hk3

theorem ValExtNodeStep.refl {F : Type} {s : PanSemStateFiniteExact 64 F}
    {Nd : List Nat} (K : List Ivl) (V : List (Nat × Nat))
    (ha : ArenaReady s) (hn : NodeHeap s Nd) :
    ValExtNodeStep K V s s Nd Nd :=
  ⟨ExtNodeStep.refl K ha hn, fun n hmem =>
    ⟨fun hk1 => Or.inr (Or.inr (Or.inl ⟨n, hmem, hk1, rfl, rfl⟩)),
     fun hk3 => Or.inr (Or.inr (Or.inr ⟨n, hmem, hk3, rfl, rfl⟩))⟩⟩

theorem ValExtNodeStep.with_locals_clock {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)} {s post : PanSemStateFiniteExact 64 F} {Nd Nd' : List Nat}
    (h : ValExtNodeStep K V s post Nd Nd')
    (L : HolFiniteMapExact MlS (ValueHOL 64)) (C : Nat) :
    ValExtNodeStep K V s { post with locals := L, clock := C } Nd Nd' :=
  ⟨h.1.with_locals_clock L C, h.2⟩

theorem ValExtNodeStep.from_locals_clock {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)} {s post : PanSemStateFiniteExact 64 F} {Nd Nd' : List Nat}
    {L : HolFiniteMapExact MlS (ValueHOL 64)} {C : Nat}
    (h : ValExtNodeStep K V { s with locals := L, clock := C } post Nd Nd') :
    ValExtNodeStep K V s post Nd Nd' :=
  ⟨h.1.from_locals_clock, h.2⟩

theorem ValExtNodeStep.trans {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    {a b c : PanSemStateFiniteExact 64 F} {Nd1 Nd2 Nd3 : List Nat}
    (ha : ArenaReady a) (h1 : ValExtNodeStep K V a b Nd1 Nd2)
    (h2 : ValExtNodeStep K V b c Nd2 Nd3) : ValExtNodeStep K V a c Nd1 Nd3 :=
  ⟨ExtNodeStep.trans ha h1.1 h2.1, fun n hn =>
    ⟨fun hk1 => ValFrom.trans h1.2 ((h2.2 n hn).1 hk1),
     fun hk3 => ValFrom.trans h1.2 ((h2.2 n hn).2 hk3)⟩⟩

theorem ValExtNodeStep.mono_K {F : Type}
    {K K' : List Ivl} {V : List (Nat × Nat)}
    {s post : PanSemStateFiniteExact 64 F} {Nd Nd' : List Nat}
    (h : ValExtNodeStep K V s post Nd Nd') (hK : ∀ j ∈ K, j ∈ K') :
    ValExtNodeStep K' V s post Nd Nd' :=
  ⟨h.1.mono hK, h.2⟩

theorem ValExtNodeStep.mono_V {F : Type}
    {K : List Ivl} {V V' : List (Nat × Nat)}
    {s post : PanSemStateFiniteExact 64 F} {Nd Nd' : List Nat}
    (h : ValExtNodeStep K V s post Nd Nd') (hV : ∀ pv ∈ V, pv ∈ V') :
    ValExtNodeStep K V' s post Nd Nd' :=
  ⟨h.1, fun n hn =>
    ⟨fun hk1 => (h.2 n hn).1 hk1 |>.mono hV,
     fun hk3 => (h.2 n hn).2 hk3 |>.mono hV⟩⟩

theorem ValExtNodeStep.absorb_fresh {F : Type}
    {K K' : List Ivl} {V : List (Nat × Nat)}
    {a b c : PanSemStateFiniteExact 64 F} {Nd1 Nd2 Nd3 : List Nat}
    (ha : ArenaReady a) (h1 : ValExtNodeStep K' V a b Nd1 Nd2)
    (h2 : ValExtNodeStep K V b c Nd2 Nd3)
    (hK : ∀ j ∈ K, j ∈ K' ∨ Inside j (globN a "heap_ptr") (globN b "heap_ptr")) :
    ValExtNodeStep K' V a c Nd1 Nd3 :=
  ⟨ExtNodeStep.absorb_fresh ha h1.1 h2.1 hK, fun n hn =>
    ⟨fun hk1 => ValFrom.trans h1.2 ((h2.2 n hn).1 hk1),
     fun hk3 => ValFrom.trans h1.2 ((h2.2 n hn).2 hk3)⟩⟩

theorem ValExtNodeStep.drop_extent {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)} {ext : Ivl}
    {s post : PanSemStateFiniteExact 64 F} {Nd Nd' : List Nat}
    (h : ValExtNodeStep (ext :: K) V s post Nd Nd')
    (hext : ext = (0, 0) ∨ ∃ k ∈ K ++ nodeExtents s Nd, Inside ext k.1 (k.1 + k.2)) :
    ValExtNodeStep K V s post Nd Nd' :=
  ⟨h.1.drop_extent hext, h.2⟩

theorem ValExtNodeStep.restore_scratch {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    {s cur next : PanSemStateFiniteExact 64 F} {Nd Nd' : List Nat} {mw : BitVec 64}
    (hAR_s : ArenaReady s) (hmw_eq : mw.toNat = globN s "scratch_ptr")
    (hstep : ValExtNodeStep K V s cur Nd Nd')
    (hnext : next = { cur with
      globals := cur.globals.update (ofString "scratch_ptr", .val (.word mw)),
      locals := next.locals,
      clock := next.clock }) :
    ValExtNodeStep K V s next Nd Nd' := by
  refine ⟨hstep.1.restore_scratch hAR_s hmw_eq hnext, ?_⟩
  have hmem : ∀ a, memW next a = memW cur a := fun a => by rw [hnext]; rfl
  intro n hn
  simp only [hmem]
  exact hstep.2 n hn

theorem valExtNodeStep_of_locFrame {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    {s s1 post : PanSemStateFiniteExact 64 F} {Nd Nd' : List Nat}
    (hfr : SoloHtabSet.LocFrame s s1)
    (hstep : ValExtNodeStep K V s1 post Nd Nd') :
    ValExtNodeStep K V s post Nd Nd' := by
  refine ⟨extNodeStep_of_locFrame hfr hstep.1, ?_⟩
  have hmem : ∀ a, memW s1 a = memW s a := fun a => by unfold SoloHtabSet.LocFrame at hfr; rw [hfr]; rfl
  intro n hn
  obtain ⟨hl, hb⟩ := hstep.2 n hn
  refine ⟨fun hk1 => ?_, fun hk3 => ?_⟩
  · rcases hl hk1 with h0 | hv | ⟨m, hm, hmk, hvp, hvl⟩ | ⟨m, hm, hmk, hvp, hvl⟩
    · exact Or.inl h0
    · exact Or.inr (Or.inl hv)
    · simp only [hmem] at hmk hvp hvl
      exact Or.inr (Or.inr (Or.inl ⟨m, hm, hmk, hvp, hvl⟩))
    · simp only [hmem] at hmk hvp hvl
      exact Or.inr (Or.inr (Or.inr ⟨m, hm, hmk, hvp, hvl⟩))
  · rcases hb hk3 with h0 | hv | ⟨m, hm, hmk, hvp, hvl⟩ | ⟨m, hm, hmk, hvp, hvl⟩
    · exact Or.inl h0
    · exact Or.inr (Or.inl hv)
    · simp only [hmem] at hmk hvp hvl
      exact Or.inr (Or.inr (Or.inl ⟨m, hm, hmk, hvp, hvl⟩))
    · simp only [hmem] at hmk hvp hvl
      exact Or.inr (Or.inr (Or.inr ⟨m, hm, hmk, hvp, hvl⟩))

theorem nodeHeap_memW_eq_below_heap_aligned {F : Type}
    {s post : PanSemStateFiniteExact 64 F} {Nd : List Nat}
    (ha : ArenaReady s) (hn : NodeHeap s Nd)
    (hm : ∀ a : BitVec 64, a.toNat + 8 ≤ globN s "heap_ptr" →
      post.memory a = s.memory a)
    {n off : Nat} (hmem : n ∈ Nd) (hoff : off + 8 ≤ nodeSize (memW s n)) :
    memW post (n + off) = memW s (n + off) := by
  obtain ⟨_, hhi⟩ := nodeIvl_in_heap ha.2 hn hmem
  have hlim : heapLimit < 2 ^ 64 := by decide
  have hhp : globN s "heap_ptr" ≤ heapLimit := ha.2.2.1
  change n + nodeSize (memW s n) ≤ globN s "heap_ptr" at hhi
  have hfit : n + off < 2 ^ 64 := by omega
  apply memW_eq_of_cell_eq
  apply hm
  rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hfit]
  omega

theorem valExtNodeStep_of_heap_preserving {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    {s post : PanSemStateFiniteExact 64 F} {Nd : List Nat}
    (ha : ArenaReady s) (hn : NodeHeap s Nd)
    (hext : ExtNodeStep K s post Nd Nd)
    (hm : ∀ a : BitVec 64, a.toNat + 8 ≤ globN s "heap_ptr" → post.memory a = s.memory a) :
    ValExtNodeStep K V s post Nd Nd := by
  refine ⟨hext, fun n hmem => ?_⟩
  have hk_eq : memW post n = memW s n := hext.1.kinds n hmem
  refine ⟨fun hk1 => ?_, fun hk3 => ?_⟩
  · have h1 : memW s n = 1 := hk_eq.symm.trans hk1
    have hsz : nodeSize (memW s n) = 64 := by simp [nodeSize, h1]
    have h48 := nodeHeap_memW_eq_below_heap_aligned ha hn hm hmem (off := 48) (by omega)
    have h56 := nodeHeap_memW_eq_below_heap_aligned ha hn hm hmem (off := 56) (by omega)
    exact Or.inr (Or.inr (Or.inl ⟨n, hmem, h1, h48, h56⟩))
  · have h3 : memW s n = 3 := hk_eq.symm.trans hk3
    have hsz : nodeSize (memW s n) = 176 := by simp [nodeSize, h3]
    have h160 := nodeHeap_memW_eq_below_heap_aligned ha hn hm hmem (off := 160) (by omega)
    have h168 := nodeHeap_memW_eq_below_heap_aligned ha hn hm hmem (off := 168) (by omega)
    exact Or.inr (Or.inr (Or.inr ⟨n, hmem, h3, h160, h168⟩))

theorem ValExtNodeStep.to_nodeHeapValuePtrOK {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    {s post : PanSemStateFiniteExact 64 F} {Nd Nd' : List Nat}
    (hAs : ArenaReady s)
    (hstep : ValExtNodeStep K V s post Nd Nd')
    (hvs : NodeHeapValuePtrOK s Nd)
    (hV_safe : ∀ pv ∈ V, ValuePtrSafe s Nd pv.1 pv.2) :
    NodeHeapValuePtrOK post Nd' := by
  have hst := hstep.1.1
  have hAp : ArenaReady post := hst.arena
  have hkp : globN post "keccak_pad" = globN s "keccak_pad" := by
    unfold globN; rw [← hst.globals (ofString "keccak_pad") (by decide)]
  have hks : globN post "keccak_st" = globN s "keccak_st" := by
    unfold globN; rw [← hst.globals (ofString "keccak_st") (by decide)]
  have hkc_eq : keccakBufIvls post = keccakBufIvls s := by
    simp [keccakBufIvls, bufferRegion, hkp, hks]
  have hfp_eq : globN post "frame_mem_ptr" = globN s "frame_mem_ptr" := by
    unfold globN; rw [← hst.globals (ofString "frame_mem_ptr") (by decide)]
  have hfg_sub : ∀ b, InIvl b (freeGapTo (globN post "scratch_ptr") post) →
      InIvl b (freeGapTo (globN s "scratch_ptr") s) := by
    intro b hb
    have hsp := hst.sp_le
    dsimp [InIvl, freeGapTo] at hb ⊢
    rw [hfp_eq] at hb
    omega
  have hhf_sub : ∀ b, InIvl b (heapFree post) → InIvl b (heapFree s) := by
    intro b hb
    have hhp := hst.hp_le
    have hlim : globN post "heap_ptr" ≤ heapLimit := hAp.2.2.1
    dsimp [InIvl, heapFree] at hb ⊢
    omega
  have hsafe_from : ∀ vp vlen, ValFrom s Nd V vp vlen →
      vlen = 1 → ordinaryDomain (panByteAlignHOL (BitVec.ofNat 64 vp)) →
      (∀ m ∈ Nd', ¬ InIvl vp (m + 8, 24)) ∧
      (∀ iv ∈ keccakBufIvls post, 0 < iv.2 → ¬ InIvl vp iv) ∧
      ¬ InIvl vp (freeGapTo (globN post "scratch_ptr") post) ∧
      ¬ InIvl vp (heapFree post) := by
    intro vp vlen hvf hv1 hord
    have hpre : (∀ m ∈ Nd, ¬ InIvl vp (m + 8, 24)) ∧
        (∀ iv ∈ keccakBufIvls s, 0 < iv.2 → ¬ InIvl vp iv) ∧
        ¬ InIvl vp (freeGapTo (globN s "scratch_ptr") s) ∧
        ¬ InIvl vp (heapFree s) := by
      rcases hvf with h0 | hmem | ⟨m0, hm0, hk1, rfl, rfl⟩ | ⟨m0, hm0, hk3, rfl, rfl⟩
      · omega
      · obtain ⟨hc, hkc, hfg, hhf⟩ := hV_safe (vp, vlen) hmem hv1 hord
        have hfg_eq : freeGapTo (globN s "scratch_ptr") s = freeGap s := rfl
        rw [hfg_eq]
        exact ⟨hc, hkc, hfg, hhf⟩
      · exact (hvs m0 hm0).1 hk1 hv1 hord
      · exact (hvs m0 hm0).2 hk3 hv1 hord
    obtain ⟨hc_old, hkc_s, hfg_s, hhf_s⟩ := hpre
    refine ⟨fun m hm => ?_, ?_, fun h => hfg_s (hfg_sub vp h), fun h => hhf_s (hhf_sub vp h)⟩
    · rcases hst.fresh m hm with hold | hfr_m
      · exact hc_old m hold
      · intro hhit
        apply hhf_s
        have hsz := nodeSize_ge32 (memW post m)
        have hlim : globN post "heap_ptr" ≤ heapLimit := hAp.2.2.1
        dsimp [InIvl, Inside, nodeIvl, heapFree] at hhit hfr_m ⊢
        omega
    · rw [hkc_eq]
      exact hkc_s
  intro n hn
  obtain ⟨hl, hb⟩ := hstep.2 n hn
  exact ⟨fun hk1 hvl1 hord => hsafe_from _ _ (hl hk1) hvl1 hord,
         fun hk3 hvl3 hord => hsafe_from _ _ (hb hk3) hvl3 hord⟩

/-! ## Primitive `ValExtNodeStep` Helpers -/

theorem valExtNodeStep_single_old_node {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    {s post : PanSemStateFiniteExact 64 F} {Nd : List Nat} {node : Nat}
    (hNd : NodeHeap s Nd) (hnode : node ∈ Nd)
    (hext : ExtNodeStep K s post Nd Nd)
    (hm_out : ∀ a : BitVec 64,
      ¬ (node ≤ a.toNat ∧ a.toNat < node + nodeSize (memW s node)) → post.memory a = s.memory a)
    (hl1 : memW post node = 1 → ValFrom s Nd V (memW post (node + 48)) (memW post (node + 56)))
    (hb3 : memW post node = 3 → ValFrom s Nd V (memW post (node + 160)) (memW post (node + 168))) :
    ValExtNodeStep K V s post Nd Nd := by
  refine ⟨hext, fun n hn => ?_⟩
  by_cases hne : n = node
  · subst hne; exact ⟨hl1, hb3⟩
  · have hd := hNd.2 n hn node hnode hne
    have hn_ins := (hNd.1 n hn).2.2.1
    have hhl_lt : heapLimit < 2 ^ 64 := by decide
    have hoff_eq : ∀ off < nodeSize (memW s n), memW post (n + off) = memW s (n + off) := by
      intro off hoff
      have hlt : n + off < 2 ^ 64 := by dsimp [Inside, nodeIvl] at hn_ins; omega
      apply memW_eq_of_cell_eq
      apply hm_out
      rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt]
      dsimp [Disj, nodeIvl] at hd
      omega
    have hk_eq : memW post n = memW s n := hext.1.kinds n hn
    refine ⟨fun hk1 => ?_, fun hk3 => ?_⟩
    · have h1 : memW s n = 1 := hk_eq.symm.trans hk1
      have hsz : nodeSize (memW s n) = 64 := by simp [nodeSize, h1]
      rw [hoff_eq 48 (by omega), hoff_eq 56 (by omega)]
      exact Or.inr (Or.inr (Or.inl ⟨n, hn, h1, rfl, rfl⟩))
    · have h3 : memW s n = 3 := hk_eq.symm.trans hk3
      have hsz : nodeSize (memW s n) = 176 := by simp [nodeSize, h3]
      rw [hoff_eq 160 (by omega), hoff_eq 168 (by omega)]
      exact Or.inr (Or.inr (Or.inr ⟨n, hn, h3, rfl, rfl⟩))

theorem valExtNodeStep_prepended_fresh {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    {s post : PanSemStateFiniteExact 64 F} {Nd : List Nat} {w : Nat}
    (ha : ArenaReady s) (hNd : NodeHeap s Nd)
    (hext : ExtNodeStep K s post Nd (w :: Nd))
    (hm_lt : ∀ a : BitVec 64, a.toNat + 8 ≤ globN s "heap_ptr" → post.memory a = s.memory a)
    (hl1 : memW post w = 1 → ValFrom s Nd V (memW post (w + 48)) (memW post (w + 56)))
    (hb3 : memW post w = 3 → ValFrom s Nd V (memW post (w + 160)) (memW post (w + 168))) :
    ValExtNodeStep K V s post Nd (w :: Nd) := by
  refine ⟨hext, fun n hn => ?_⟩
  rcases List.mem_cons.1 hn with rfl | hold
  · exact ⟨hl1, hb3⟩
  · have hk_eq : memW post n = memW s n := hext.1.kinds n hold
    refine ⟨fun hk1 => ?_, fun hk3 => ?_⟩
    · have h1 : memW s n = 1 := hk_eq.symm.trans hk1
      have hsz : nodeSize (memW s n) = 64 := by simp [nodeSize, h1]
      have h48 := nodeHeap_memW_eq_below_heap_aligned ha hNd hm_lt hold (off := 48) (by omega)
      have h56 := nodeHeap_memW_eq_below_heap_aligned ha hNd hm_lt hold (off := 56) (by omega)
      exact Or.inr (Or.inr (Or.inl ⟨n, hold, h1, h48, h56⟩))
    · have h3 : memW s n = 3 := hk_eq.symm.trans hk3
      have hsz : nodeSize (memW s n) = 176 := by simp [nodeSize, h3]
      have h160 := nodeHeap_memW_eq_below_heap_aligned ha hNd hm_lt hold (off := 160) (by omega)
      have h168 := nodeHeap_memW_eq_below_heap_aligned ha hNd hm_lt hold (off := 168) (by omega)
      exact Or.inr (Or.inr (Or.inr ⟨n, hold, h3, h160, h168⟩))

theorem frame_mem_lt_heap_of_empty_writes {F : Type}
    {s post : PanSemStateFiniteExact 64 F} {Nd Nd' : List Nat}
    (ha : ArenaReady s) (hNd : NodeHeap s Nd)
    (hst : R16Shards.NodeStep s post Nd Nd')
    (hno_nodes : ∀ n ∈ Nd, ∀ off < nodeSize (memW s n),
      off % 8 = 0 → post.memory (BitVec.ofNat 64 (n + off)) = s.memory (BitVec.ofNat 64 (n + off))) :
    ∀ n ∈ Nd, ∀ off < nodeSize (memW s n), off % 8 = 0 →
      memW post (n + off) = memW s (n + off) := by
  intro n hn off hoff hoff8
  exact memW_eq_of_cell_eq (hno_nodes n hn off hoff hoff8)

theorem valExtNodeStep_branch_child_store {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    {s : PanSemStateFiniteExact 64 F} {Nd : List Nat}
    {br idx wch : BitVec 64}
    (ha : ArenaReady s) (hNd : NodeHeap s Nd)
    (hbr_in : br.toNat ∈ Nd) (hbr_k : memW s br.toNat = 3)
    (hidx_lt : idx.toNat < 16) (hch_root : RootIn Nd wch.toNat) :
    let slot := br + BitVec.ofNat 64 32 + idx * BitVec.ofNat 64 8
    let m1 := Wave8Contracts.M26.updW s.memory slot wch
    s.memaddrs slot ∧
    ValExtNodeStep K V s { s with memory := m1 } Nd Nd ∧
    memW { s with memory := m1 } br.toNat = 3 := by
  intro slot m1
  obtain ⟨hdom, hext, hbr3⟩ := extNodeStep_branch_child_store (K := K) ha hNd hbr_in hbr_k hidx_lt hch_root
  refine ⟨hdom, ?_, hbr3⟩
  have hbr_ins := (hNd.1 br.toNat hbr_in).2.2.1
  have hbr_sz : nodeSize (memW s br.toNat) = 176 := by simp [nodeSize, hbr_k]
  have hhl_lt : heapLimit < 2 ^ 64 := by decide
  have hslot_nat : slot.toNat = br.toNat + 32 + 8 * idx.toNat := by
    dsimp only [slot]
    have hlt : br.toNat + 32 + 8 * idx.toNat < 2 ^ 64 := by
      dsimp [Inside, nodeIvl] at hbr_ins; omega
    have heq : br + BitVec.ofNat 64 32 + idx * BitVec.ofNat 64 8 =
        BitVec.ofNat 64 (br.toNat + 32 + 8 * idx.toNat) := by
      apply BitVec.eq_of_toNat_eq
      simp only [BitVec.toNat_add, BitVec.toNat_mul, BitVec.toNat_ofNat]
      omega
    rw [heq, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt]
  refine valExtNodeStep_single_old_node hNd hbr_in hext ?_ ?_ ?_
  · intro a hout
    have hne : a ≠ slot := by
      intro heq; apply hout; rw [heq, hslot_nat, hbr_sz]; omega
    simp [m1, Wave8Contracts.M26.updW, if_neg hne]
  · intro hk1; rw [hbr3] at hk1; cases hk1
  · intro _
    have h160_eq : memW { s with memory := m1 } (br.toNat + 160) = memW s (br.toNat + 160) := by
      have hlt : br.toNat + 160 < 2 ^ 64 := by dsimp [Inside, nodeIvl] at hbr_ins; omega
      have hne : BitVec.ofNat 64 (br.toNat + 160) ≠ slot := by
        intro heq; have := congrArg BitVec.toNat heq
        rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt, hslot_nat] at this; omega
      unfold memW; simp [m1, Wave8Contracts.M26.updW, if_neg hne]
    have h168_eq : memW { s with memory := m1 } (br.toNat + 168) = memW s (br.toNat + 168) := by
      have hlt : br.toNat + 168 < 2 ^ 64 := by dsimp [Inside, nodeIvl] at hbr_ins; omega
      have hne : BitVec.ofNat 64 (br.toNat + 168) ≠ slot := by
        intro heq; have := congrArg BitVec.toNat heq
        rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt, hslot_nat] at this; omega
      unfold memW; simp [m1, Wave8Contracts.M26.updW, if_neg hne]
    rw [h160_eq, h168_eq]
    exact Or.inr (Or.inr (Or.inr ⟨br.toNat, hbr_in, hbr_k, rfl, rfl⟩))

theorem valExtNodeStep_branch_val_stores {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    {s : PanSemStateFiniteExact 64 F} {Nd : List Nat}
    {br vptr vlen : BitVec 64}
    (ha : ArenaReady s) (hNd : NodeHeap s Nd)
    (hbr_in : br.toNat ∈ Nd) (hbr_k : memW s br.toNat = 3)
    (hvlen_lt : vlen.toNat < 2 ^ 40)
    (hvf : ValFrom s Nd V vptr.toNat vlen.toNat) :
    let m1 := Wave8Contracts.M26.updW s.memory (br + BitVec.ofNat 64 160) vptr
    let m2 := Wave8Contracts.M26.updW m1 (br + BitVec.ofNat 64 168) vlen
    s.memaddrs (br + BitVec.ofNat 64 160) ∧ s.memaddrs (br + BitVec.ofNat 64 168) ∧
    ValExtNodeStep K V s { s with memory := m2 } Nd Nd ∧
    memW { s with memory := m2 } br.toNat = 3 := by
  intro m1 m2
  obtain ⟨hdom160, hdom168, hext, hbr3⟩ :=
    extNodeStep_branch_val_stores (K := K) ha hNd hbr_in hbr_k hvlen_lt
  refine ⟨hdom160, hdom168, ?_, hbr3⟩
  have hbr_ins := (hNd.1 br.toNat hbr_in).2.2.1
  have hbr_sz : nodeSize (memW s br.toNat) = 176 := by simp [nodeSize, hbr_k]
  have hhl_lt : heapLimit < 2 ^ 64 := by decide
  have h160_eq : br + BitVec.ofNat 64 160 = BitVec.ofNat 64 (br.toNat + 160) ∧
      (br + BitVec.ofNat 64 160).toNat = br.toNat + 160 := by
    have hlt : br.toNat + 160 < 2 ^ 64 := by dsimp [Inside, nodeIvl] at hbr_ins; omega
    have heq : br + BitVec.ofNat 64 160 = BitVec.ofNat 64 (br.toNat + 160) := by
      apply BitVec.eq_of_toNat_eq; simp only [BitVec.toNat_add, BitVec.toNat_ofNat]
    exact ⟨heq, by rw [heq, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt]⟩
  have h168_eq : br + BitVec.ofNat 64 168 = BitVec.ofNat 64 (br.toNat + 168) ∧
      (br + BitVec.ofNat 64 168).toNat = br.toNat + 168 := by
    have hlt : br.toNat + 168 < 2 ^ 64 := by dsimp [Inside, nodeIvl] at hbr_ins; omega
    have heq : br + BitVec.ofNat 64 168 = BitVec.ofNat 64 (br.toNat + 168) := by
      apply BitVec.eq_of_toNat_eq; simp only [BitVec.toNat_add, BitVec.toNat_ofNat]
    exact ⟨heq, by rw [heq, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt]⟩
  refine valExtNodeStep_single_old_node hNd hbr_in hext ?_ ?_ ?_
  · intro a hout
    have hne168 : a ≠ br + BitVec.ofNat 64 168 := by
      intro heq; apply hout; rw [heq, h168_eq.2, hbr_sz]; omega
    have hne160 : a ≠ br + BitVec.ofNat 64 160 := by
      intro heq; apply hout; rw [heq, h160_eq.2, hbr_sz]; omega
    simp [m2, m1, Wave8Contracts.M26.updW, if_neg hne168, if_neg hne160]
  · intro hk1; rw [hbr3] at hk1; cases hk1
  · intro _
    have hne_160_168 : br + BitVec.ofNat 64 160 ≠ br + BitVec.ofNat 64 168 := by
      intro heq; have := congrArg BitVec.toNat heq; omega
    have hmw160 : memW { s with memory := m2 } (br.toNat + 160) = vptr.toNat := by
      unfold memW; rw [← h160_eq.1]; simp [m2, m1, Wave8Contracts.M26.updW, if_neg hne_160_168]
    have hmw168 : memW { s with memory := m2 } (br.toNat + 168) = vlen.toNat := by
      unfold memW; rw [← h168_eq.1]; simp [m2, m1, Wave8Contracts.M26.updW]
    rw [hmw160, hmw168]
    exact hvf

theorem node_invalidate_body_valExt {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    (s : PanSemStateFiniteExact 64 F) (Nd : List Nat) (wnd : BitVec 64)
    (hAR : ArenaReady s) (hNd : NodeHeap s Nd)
    (hroot : RootIn Nd wnd.toNat)
    (hlk : s.locals.lookup (ofString "nd") = some (.val (.word wnd)))
    (hres : Resumes (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_invalidate)).1) :
    let post := (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_invalidate)).2
    wnd.toNat ∈ Nd ∧
    (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_invalidate)).1 =
      some (.returned (.val (.word 0))) ∧
    post = { R10Shards.GbodyMptDelete.clearCache s wnd.toNat with
      locals := post.locals, clock := post.clock } ∧
    ValExtNodeStep K V s post Nd Nd ∧
    nodeExtents post Nd = nodeExtents s Nd := by
  intro post
  obtain ⟨hnd_in, hret, hpost_eq, hext, hextents⟩ :=
    node_invalidate_body_ext (K := K) s Nd wnd hAR hNd hroot hlk hres
  refine ⟨hnd_in, hret, hpost_eq, ?_, hextents⟩
  have hnd_ins := (hNd.1 wnd.toNat hnd_in).2.2.1
  have hsz32 := nodeSize_ge32 (memW s wnd.toNat)
  have hhl_lt : heapLimit < 2 ^ 64 := by decide
  have hm_post : post.memory = (R10Shards.GbodyMptDelete.clearCache s wnd.toNat).memory := by
    change (s.evaluateHOLFiniteState (sourceFnBody Guest.Software.guestFn_node_invalidate)).2.memory = _
    rw [hpost_eq]
  have hmem_unchanged : ∀ a : BitVec 64,
      a.toNat ≠ wnd.toNat + 8 → a.toNat ≠ wnd.toNat + 16 → a.toNat ≠ wnd.toNat + 24 →
      post.memory a = s.memory a := by
    intro a h8 h16 h24
    rw [hm_post]
    dsimp only [R10Shards.GbodyMptDelete.clearCache]
    have c8 : a ≠ BitVec.ofNat 64 (wnd.toNat + 8) := by
      rintro rfl
      have hlt : wnd.toNat + 8 < 2 ^ 64 := by dsimp [Inside, nodeIvl] at hnd_ins; omega
      rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt] at h8; exact h8 rfl
    have c16 : a ≠ BitVec.ofNat 64 (wnd.toNat + 16) := by
      rintro rfl
      have hlt : wnd.toNat + 16 < 2 ^ 64 := by dsimp [Inside, nodeIvl] at hnd_ins; omega
      rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt] at h16; exact h16 rfl
    have c24 : a ≠ BitVec.ofNat 64 (wnd.toNat + 24) := by
      rintro rfl
      have hlt : wnd.toNat + 24 < 2 ^ 64 := by dsimp [Inside, nodeIvl] at hnd_ins; omega
      rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt] at h24; exact h24 rfl
    simp [c8, c16, c24]
  have hm_ge32 : ∀ off : Nat, 32 ≤ off → off < nodeSize (memW s wnd.toNat) →
      memW post (wnd.toNat + off) = memW s (wnd.toNat + off) := by
    intro off hge hlt_sz
    have hlt : wnd.toNat + off < 2 ^ 64 := by dsimp [Inside, nodeIvl] at hnd_ins; omega
    apply memW_eq_of_cell_eq
    apply hmem_unchanged <;> rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hlt] <;> omega
  refine valExtNodeStep_single_old_node hNd hnd_in hext ?_ ?_ ?_
  · intro a hout
    apply hmem_unchanged <;> omega
  · intro hk1
    have h1 : memW s wnd.toNat = 1 := (hext.1.kinds wnd.toNat hnd_in).symm.trans hk1
    have hsz : nodeSize (memW s wnd.toNat) = 64 := by simp [nodeSize, h1]
    rw [hm_ge32 48 (by decide) (by omega), hm_ge32 56 (by decide) (by omega)]
    exact Or.inr (Or.inr (Or.inl ⟨wnd.toNat, hnd_in, h1, rfl, rfl⟩))
  · intro hk3
    have h3 : memW s wnd.toNat = 3 := (hext.1.kinds wnd.toNat hnd_in).symm.trans hk3
    have hsz : nodeSize (memW s wnd.toNat) = 176 := by simp [nodeSize, h3]
    rw [hm_ge32 160 (by decide) (by omega), hm_ge32 168 (by decide) (by omega)]
    exact Or.inr (Or.inr (Or.inr ⟨wnd.toNat, hnd_in, h3, rfl, rfl⟩))

theorem node_new_branch_valExt_spec {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
    (hcode : s.code = originalRuntimeCode)
    (hAR : ArenaReady s) (hNd : NodeHeap s Nd)
    (hres : Resumes (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_new_branch)).1) :
    let r := (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_new_branch)).1
    let post := (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_new_branch)).2
    ∃ br : BitVec 64,
      r = some (.returned (.val (.word br))) ∧
      br.toNat = globN s "heap_ptr" ∧
      br.toNat % 8 = 0 ∧
      globN post "heap_ptr" = br.toNat + 176 ∧
      memW post br.toNat = 3 ∧
      (∀ i < 16, memW post (br.toNat + 32 + 8 * i) = 0) ∧
      memW post (br.toNat + 16) = 0 ∧
      memW post (br.toNat + 168) = 0 ∧
      ValExtNodeStep K V s post Nd (br.toNat :: Nd) ∧
      (∀ a : BitVec 64, a.toNat + 8 ≤ globN s "heap_ptr" → post.memory a = s.memory a) := by
  intro r post
  obtain ⟨br, hr, hbr_hp, hbr_al, hpost_hp, hmw0, hmw_ch, hmw16, hmw168, hext⟩ :=
    node_new_branch_ext_spec (K := K) s Nd hcode hAR hNd hres
  have hNd_nil : NodeHeap s ([] : List Nat) :=
    And.intro (fun _ h => nomatch h) (fun _ h => nomatch h)
  obtain ⟨_, _, _, br0, _, _, _, _, _, _, _, _, hstep_fn⟩ := R16Shards.node_new_branch_spec s hcode hAR hres
  have hstep_empty := hstep_fn [] hNd_nil
  have hm_lt : ∀ a : BitVec 64, a.toNat + 8 ≤ globN s "heap_ptr" → post.memory a = s.memory a := by
    intro a hlt
    have hhp_lim : globN s "heap_ptr" ≤ heapLimit := hAR.2.2.1
    have hfp_lo : scratchStart ≤ globN s "frame_mem_ptr" := hAR.2.2.2.1
    have hfp_sp : globN s "frame_mem_ptr" ≤ globN s "scratch_ptr" := hAR.2.2.2.2.1
    have hsep : heapLimit ≤ scratchStart := by decide
    apply hstep_empty.frame a
    · intro i hi
      rcases List.mem_append.1 hi with hi1 | hi2
      · cases hi1
      · rcases List.mem_cons.1 hi2 with rfl | hi3
        · dsimp [CellHits]; omega
        · cases hi3
    · dsimp [CellHits]
      omega
  refine ⟨br, hr, hbr_hp, hbr_al, hpost_hp, hmw0, hmw_ch, hmw16, hmw168,
    valExtNodeStep_prepended_fresh hAR hNd hext hm_lt ?_ ?_, hm_lt⟩
  · intro hk1; rw [hmw0] at hk1; cases hk1
  · intro _; exact Or.inl hmw168

theorem nibbles_concat_body_valExt_spec {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
    (wa wal wb wbl : BitVec 64)
    (hcode : s.code = originalRuntimeCode)
    (hAR : ArenaReady s) (hNd : NodeHeap s Nd)
    (hKeyA : KeyIn s Nd wa.toNat wal.toNat)
    (hKeyB : KeyIn s Nd wb.toNat wbl.toNat)
    (hlk_a : s.locals.lookup (ofString "a") = some (.val (.word wa)))
    (hlk_al : s.locals.lookup (ofString "al") = some (.val (.word wal)))
    (hlk_b : s.locals.lookup (ofString "b") = some (.val (.word wb)))
    (hlk_bl : s.locals.lookup (ofString "bl") = some (.val (.word wbl)))
    (rv : ValueHOL 64)
    (hret : (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_nibbles_concat)).1 =
      some (.returned rv)) :
    let post := (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_nibbles_concat)).2
    ∃ wcat : BitVec 64,
      rv = .val (.word wcat) ∧
      (wal + wbl).toNat = wal.toNat + wbl.toNat ∧
      ValExtNodeStep K V s post Nd Nd ∧
      KeyIn post Nd wcat.toNat (wal.toNat + wbl.toNat) ∧
      ((wal.toNat + wbl.toNat = 0) ∨
        Inside (wcat.toNat, wal.toNat + wbl.toNat) (globN s "heap_ptr") (globN post "heap_ptr")) ∧
      (∀ c : BitVec 64, c.toNat < globN s "heap_ptr" → post.memory c = s.memory c) := by
  intro post
  obtain ⟨wcat, hrv, hsum, hext, hKey, hProv, hm_lt⟩ :=
    nibbles_concat_body_ext_spec (K := K) s Nd wa wal wb wbl hcode hAR hNd hKeyA hKeyB
      hlk_a hlk_al hlk_b hlk_bl rv hret
  exact ⟨wcat, hrv, hsum,
    valExtNodeStep_of_heap_preserving hAR hNd hext (fun a ha => hm_lt a (by omega)),
    hKey, hProv, hm_lt⟩

theorem alloc8_storeByte_nibble_valExt_step {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
    (widx : BitVec 64)
