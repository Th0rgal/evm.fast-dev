      simp [s9, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hs8_loc, hs7_k,
        show ofString "off" ≠ ofString "k" by decide]
    have hs9_cbuf : s9.locals.lookup (ofString "cbuf") = some (.val (.word cbufw)) := by
      simp [s9, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hs8_loc, hs7_cbuf,
        show ofString "off" ≠ ofString "cbuf" by decide]
    have hs9_clen : s9.locals.lookup (ofString "clen") = some (.val (.word clenw)) := by
      simp [s9, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hs8_loc, hs7_clen,
        show ofString "off" ≠ ofString "clen" by decide]
    have hs9_buf : s9.locals.lookup (ofString "buf") = some (.val (.word bufw)) := by
      simp [s9, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hs8_loc, hs7_buf,
        show ofString "off" ≠ ofString "buf" by decide]
    have hs9_off : s9.locals.lookup (ofString "off") = some (.val (.word hlw)) := by
      simp [s9, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
    have hs9_c : s9.code = originalRuntimeCode := heff_78.arena.1.code
    -- Compose `HeapByteEff s s9 [(bufw.toNat, hlw.toNat + payw.toNat)] ["heap_ptr"]`
    have heff_s_s5 : HeapByteEff s s5 [(bufw.toNat, hlw.toNat + payw.toNat)] ["heap_ptr"] := by
      rw [hs5_eq_s]
      exact (HeapByteEff.refl hAR _ ["heap_ptr"]).locals_clock s5.locals s5.clock
    have heff_57 : HeapByteEff s5 s7 [(bufw.toNat, hlw.toNat + payw.toNat)] ["heap_ptr"] :=
      (heff_56.trans heff_67).mono (fun _ h => by simp at h) (fun _ h => h)
    have heff_s_s9 : HeapByteEff s s9 [(bufw.toNat, hlw.toNat + payw.toNat)] ["heap_ptr"] :=
      ((heff_s_s5.trans heff_57).trans heff_78).locals_clock s9.locals s9.clock
    have hkc_s9 : keccakBufIvls s9 = keccakBufIvls s :=
      keccakBufIvls_eq_of_eff heff_s_s9 (by decide) (by decide)
    -- Translate `hk1_pay`, `hk2_pay`, `hk3_pay` from `s4` to `s` (identical memory/globals!)
    have hs4_eq_s : s4 = { s with locals := s4.locals, clock := s4.clock } := by cases s; rfl
    have hk1_pay_s : memW s nodew.toNat = 1 →
        payw.toNat = rlpEncBytesLen s cbufw.toNat clenw.toNat +
          rlpEncBytesLen s (memW s (nodew.toNat + 48)) (memW s (nodew.toNat + 56)) := by
      intro h; have h4 : memW s4 nodew.toNat = 1 := h
      have hp := hk1_pay h4
      rw [hs4_eq_s] at hp
      cases s; exact hp
    have hk2_pay_s : memW s nodew.toNat = 2 →
        payw.toNat = rlpEncBytesLen s cbufw.toNat clenw.toNat +
          nodeRefBytes s (memW s (nodew.toNat + 48)) := by
      intro h; have h4 : memW s4 nodew.toNat = 2 := h
      have hp := hk2_pay h4
      rw [hs4_eq_s] at hp
      cases s; exact hp
    have hk3_pay_s : memW s nodew.toNat = 3 →
        payw.toNat = branchRefSum s nodew.toNat 16 +
          rlpEncBytesLen s (memW s (nodew.toNat + 160)) (memW s (nodew.toNat + 168)) := by
      intro h; have h4 : memW s4 nodew.toNat = 3 := h
      have hp := hk3_pay h4
      rw [hs4_eq_s] at hp
      cases s; exact hp
    have hk12_cb : (memW s nodew.toNat = 1 ∨ memW s nodew.toNat = 2) →
        clenw.toNat ≤ heapLimit / 2 + 1 ∧
        sourceBase ≤ cbufw.toNat ∧
        cbufw.toNat + clenw.toNat ≤ globN s "heap_ptr" := by
      intro hk12
      obtain ⟨_, hcl_hi, hcb_lo, hcb_hi, _, _⟩ := hrf.2 hk12
      have hcb_eq : cbufw.toNat = memW s (frw.toNat + 24) := hcbuf_nat
      have hcl_eq : clenw.toNat = memW s (frw.toNat + 32) := hclen_nat
      rw [hcb_eq, hcl_eq]
      exact ⟨hcl_hi, hcb_lo, hcb_hi⟩
    -- Run `eval_finishWrite_stage` on `s9`!
    rcases eval_finishWrite_stage s s9 sp0 Nd nodew kw payw cbufw clenw bufw hlw ["heap_ptr"]
        hs9_c hAR hN hvs hsp_le hkc_disj hnode_in hk1 hkw_nat_s hk12_cb
        hk1_pay_s hk2_pay_s hk3_pay_s (by omega) hbuf_fit heff_s_s9 hkc_s9
        (by simp) (by decide) (by decide)
        hs9_node hs9_k hs9_cbuf hs9_clen hs9_buf hs9_off hres_s7 with
      ⟨eid_w, ev_w, hne, hw_ex, heff_ex, hN_ex, hext_ex, hkc_ex, hvs_ex⟩ |
      ⟨hw_ret, heff_fin, hN_fin, hext_fin, hkc_fin, hvs_fin, hm8_fin, hm16_fin, hnc_fin⟩
    · -- Exception in `finishWriteIte`
      rcases hw_ev : evaluateHOLFiniteState s9 (.seq finishWriteIte finishStores) with ⟨rw9, sw9⟩
      rw [hw_ev] at hw_ex heff_ex hN_ex hext_ex hkc_ex hvs_ex hev_al
      dsimp only at hw_ex heff_ex hN_ex hext_ex hkc_ex hvs_ex hev_al
      subst hw_ex
      have h5_fst : (evaluateHOLFiniteState s5 tail4).1 = some (.exception eid_w ev_w) := by
        dsimp only [tail4]; rw [hev_hl]; dsimp only; rw [hev_al]
      have h5_snd : ∃ lf5, (evaluateHOLFiniteState s5 tail4).2 = { sw9 with locals := lf5 } := by
        dsimp only [tail4]; rw [hev_hl]; dsimp only; rw [hev_al]; dsimp only
        exact ⟨_, rfl⟩
      obtain ⟨lf5, h5_snd⟩ := h5_snd
      rw [h5_fst] at hfst_decs
      rcases hbr with ⟨eid', ev', hbe, _, hcall_eq⟩ | ⟨rv, post, hret, _, _⟩
      · rw [congrArg Prod.fst hbe] at hfst_decs
        injection hfst_decs with h1; injection h1 with he1 he2; subst he1 he2
        rw [hcall_eq]
        refine Or.inl ⟨eid', ev', hne, rfl, ?_, ?_, ?_, ?_, ?_⟩
        · dsimp only [emptyLocalsHOLFinite]
          rw [hsnd_decs, h5_snd]
          exact heff_ex.locals_clock _ sw9.clock
        · dsimp only [emptyLocalsHOLFinite]
          rw [hsnd_decs, h5_snd]
          exact hN_ex
        · dsimp only [emptyLocalsHOLFinite]
          rw [hsnd_decs, h5_snd]
          exact hext_ex
        · dsimp only [emptyLocalsHOLFinite]
          rw [hsnd_decs, h5_snd]
          exact hkc_ex
        · dsimp only [emptyLocalsHOLFinite]
          rw [hsnd_decs, h5_snd]
          exact hvs_ex
      · rw [congrArg Prod.fst hret] at hfst_decs; cases hfst_decs
    · -- Returned `.val (.word 0)`!
      rcases hw_ev : evaluateHOLFiniteState s9 (.seq finishWriteIte finishStores) with ⟨rw9, sw9⟩
      rw [hw_ev] at hw_ret heff_fin hN_fin hext_fin hkc_fin hvs_fin hm8_fin hm16_fin hnc_fin hev_al
      dsimp only at hw_ret heff_fin hN_fin hext_fin hkc_fin hvs_fin hm8_fin hm16_fin hnc_fin hev_al
      subst hw_ret
      have h5_fst : (evaluateHOLFiniteState s5 tail4).1 = some (.returned (.val (.word 0))) := by
        dsimp only [tail4]; rw [hev_hl]; dsimp only; rw [hev_al]
      have h5_snd : ∃ lf5, (evaluateHOLFiniteState s5 tail4).2 = { sw9 with locals := lf5 } := by
        dsimp only [tail4]; rw [hev_hl]; dsimp only; rw [hev_al]; dsimp only
        exact ⟨_, rfl⟩
      obtain ⟨lf5, h5_snd⟩ := h5_snd
      rw [h5_fst] at hfst_decs
      rcases hbr with ⟨eid', ev', hbe, _, _⟩ | ⟨rv, post, hret, _, hcall_eq⟩
      · rw [congrArg Prod.fst hbe] at hfst_decs; cases hfst_decs
      · have hpost_eq : (evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn__node_rlp_finish)).2 = post := by
          rw [hret]
        rw [hsnd_decs, h5_snd] at hpost_eq
        subst hpost_eq
        rw [hcall_eq]; dsimp only
        have hout_eq : ({ sw9 with locals := s.locals } : PanSemStateFiniteExact 64 F) =
            { { sw9 with locals := lf_decs } with locals := s.locals } := rfl
        rw [← hout_eq]
        refine Or.inr ⟨rfl, rfl, heff_fin.locals_clock s.locals sw9.clock, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
        · exact hN_fin
        · exact hext_fin
        · exact hkc_fin
        · exact hvs_fin
        · change sourceBase ≤ memW sw9 (nodew.toNat + 8)
          rw [hm8_fin, hbuf_hp]; exact hAR.2.1
        · change 1 ≤ memW sw9 (nodew.toNat + 16); omega
        · exact hnc_fin

private def noBCProg : ProgHOL 64 → Bool
  | .dec _ _ _ b => noBCProg b
  | .decCall _ _ _ _ b => noBCProg b
  | .seq a b => noBCProg a && noBCProg b
  | .ite _ a b => noBCProg a && noBCProg b
  | .while _ _ => true
  | .assign _ _ _ | .store _ _ | .storeByte _ _ => true
  | .call none _ _ | .call (some (_, none)) _ _ => true
  | .skip | .annot _ _ | .return _ => true
  | _ => false

private theorem evaluate_noBCProg {F : Type} (p : ProgHOL 64) (hp : noBCProg p = true)
    (u : PanSemStateFiniteExact 64 F) {r0 : PanSemResultExact 64}
    (hr0 : (evaluateHOLFiniteState u p).1 = some r0) :
    r0 ≠ .break ∧ r0 ≠ .continue := by
  have hnot_err : PanSemResultExact.error ≠ (.break : PanSemResultExact 64) ∧
      PanSemResultExact.error ≠ (.continue : PanSemResultExact 64) := ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
  have hnot_to : PanSemResultExact.timeOut ≠ (.break : PanSemResultExact 64) ∧
      PanSemResultExact.timeOut ≠ (.continue : PanSemResultExact 64) := ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
  cases p with
  | skip => rw [evaluateHOLFiniteState_skip] at hr0; simp at hr0
  | annot _ _ => rw [evaluateHOLFiniteState_annot] at hr0; simp at hr0
  | «return» _ =>
    rw [evaluateHOLFiniteState_return] at hr0
    split at hr0
    · injection hr0 with h; subst h; exact hnot_err
    · split at hr0 <;> (injection hr0 with h; subst h; exact ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩)
  | assign vk vn e => exact assign_no_bc u vk vn e hr0
  | store _ _ =>
    rw [evaluateHOLFiniteState_store] at hr0
    split at hr0
    · split at hr0
      · split at hr0
        · simp at hr0
        · injection hr0 with h; subst h; exact hnot_err
      · injection hr0 with h; subst h; exact hnot_err
    · injection hr0 with h; subst h; exact hnot_err
  | storeByte _ _ =>
    rw [evaluateHOLFiniteState_storeByte] at hr0
    split at hr0
    · split at hr0
      · split at hr0
        · simp at hr0
        · injection hr0 with h; subst h; exact hnot_err
      · injection hr0 with h; subst h; exact hnot_err
    · injection hr0 with h; subst h; exact hnot_err
  | call ret fn args =>
    have hret_no_hnd : ret = none ∨ ∃ lv, ret = some (lv, none) := by
      cases ret with
      | none => exact Or.inl rfl
      | some rp =>
        cases rp with
        | mk lv hnd =>
          cases hnd with
          | none => exact Or.inr ⟨lv, rfl⟩
          | some _ => simp [noBCProg] at hp
    rw [evaluateHOLFiniteState_call] at hr0
    rcases ha : evalListHOLFinite u (h := fun a => Classical.propDecidable (u.memaddrs a)) args with _ | vs
    · rw [ha] at hr0; injection hr0 with h; subst h; exact hnot_err
    · simp only [ha] at hr0
      rcases hl : lookupCodeHOLFinite u.code.lookup fn vs with _ | ⟨b', c', r'⟩
      · rw [hl] at hr0; injection hr0 with h; subst h; exact hnot_err
      · simp only [hl] at hr0
        by_cases hz : u.clock = 0
        · simp only [hz, ↓reduceIte] at hr0; injection hr0 with h; subst h; exact hnot_to
        · simp only [hz, ↓reduceIte] at hr0
          rcases hcal : evaluateHOLFiniteState (callEntryStateHOLFinite u c') b' with ⟨rc, st⟩
          have hcal' : evaluateHOLFiniteState (callEntryStateHOLFinite u c') b' = (rc, st) := hcal
          rw [hcal'] at hr0
          cases rc with
          | none => injection hr0 with h; subst h; exact hnot_err
          | some rc' =>
            cases rc' with
            | «break» | «continue» | error => injection hr0 with h; subst h; exact hnot_err
            | timeOut => injection hr0 with h; subst h; exact hnot_to
            | finalFfi _ => injection hr0 with h; subst h; exact ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
            | returned rv =>
              dsimp only at hr0
              split at hr0
              · rcases hret_no_hnd with rfl | ⟨lv, rfl⟩
                · injection hr0 with h; subst h; exact ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
                · cases lv with
                  | none => simp at hr0
                  | some kv =>
                    dsimp only at hr0
                    split at hr0
                    · simp at hr0
                    · injection hr0 with h; subst h; exact hnot_err
              · injection hr0 with h; subst h; exact hnot_err
            | exception eid ev =>
              rcases hret_no_hnd with rfl | ⟨lv, rfl⟩
              · injection hr0 with h; subst h; exact ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
              · injection hr0 with h; subst h; exact ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
  | dec x sh init b =>
    have hb : noBCProg b = true := by simpa [noBCProg] using hp
    rw [evaluateHOLFiniteState_dec_total] at hr0
    dsimp only at hr0
    split at hr0
    · injection hr0 with h; subst h; exact hnot_err
    · split at hr0
      · exact evaluate_noBCProg b hb _ hr0
      · injection hr0 with h; subst h; exact hnot_err
  | decCall vn sh fn args cont =>
    have hb : noBCProg cont = true := by simpa [noBCProg] using hp
    exact decCall_no_bc u vn sh fn args cont (fun u' _ h => evaluate_noBCProg cont hb u' h) hr0
  | seq a b =>
    have hab : noBCProg a = true ∧ noBCProg b = true := by
      simpa [noBCProg, Bool.and_eq_true] using hp
    exact seq_no_bc u a b (fun _ h => evaluate_noBCProg a hab.1 u h)
      (fun u' _ h => evaluate_noBCProg b hab.2 u' h) hr0
  | ite _ a b =>
    have hab : noBCProg a = true ∧ noBCProg b = true := by
      simpa [noBCProg, Bool.and_eq_true] using hp
    rw [evaluateHOLFiniteState_ite] at hr0
    split at hr0
    · split at hr0
      · exact evaluate_noBCProg b hab.2 u hr0
      · exact evaluate_noBCProg a hab.1 u hr0
    · injection hr0 with h; subst h; exact hnot_err
  | «while» cond body =>
    have hw : ∀ (ck : Nat) (v : PanSemStateFiniteExact 64 F), v.clock = ck →
        ∀ r1, (evaluateHOLFiniteState v (.while cond body)).1 = some r1 →
          r1 ≠ .break ∧ r1 ≠ .continue := by
      intro ck
      induction ck using Nat.strong_induction_on with
      | _ ck ih =>
        intro v hv r1 hr1
        rw [evaluateHOLFiniteState_while_fixClockRewrite] at hr1
        split at hr1
        · split at hr1
          · split at hr1
            · injection hr1 with h; subst h; exact hnot_to
            · have hrem := evaluateHOLFiniteState_clock_le (decClockHOLFinite v) body
              rcases hbr : evaluateHOLFiniteState (decClockHOLFinite v) body with ⟨rb, mid⟩
              simp only [hbr] at hr1 hrem
              have hlt : mid.clock < ck := by
                change mid.clock ≤ v.clock - 1 at hrem; omega
              cases rb with
              | none => exact ih mid.clock hlt mid rfl r1 hr1
              | some rb' =>
                cases rb' with
                | «break» => simp at hr1
                | «continue» => exact ih mid.clock hlt mid rfl r1 hr1
                | _ => injection hr1 with h; subst h; exact ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
          · simp at hr1
        · injection hr1 with h; subst h; exact hnot_err
    exact hw u.clock u rfl r0 hr0
  | _ => simp [noBCProg] at hp

/-! ### Scratch mark / alloc / release helpers on `HeapByteEff` -/

private theorem none_or_resumes_not_timeOut {r : Option (PanSemResultExact 64)}
    (h : r = none ∨ Resumes r) : r ≠ some .timeOut := by
  intro hto; rcases h with hn | hr
  · rw [hto] at hn; cases hn
  · exact resumes_not_timeOut hr hto

theorem eval_decCall_scratch_mark_or_exn {F : Type}
    (s : PanSemStateFiniteExact 64 F) (name : MlS) (cont : ProgHOL 64)
    (hc : s.code = originalRuntimeCode) (hAR : ArenaReady s)
    (hor : (evaluateHOLFiniteState s (.decCall name .one (ofString "scratch_mark") [] cont)).1 = none ∨
      Resumes (evaluateHOLFiniteState s (.decCall name .one (ofString "scratch_mark") [] cont)).1) :
    ∃ (spw : BitVec 64),
      let mid := { s with locals := s.locals.update (name, .val (.word spw)), clock := s.clock - 1 }
      s.globals.lookup (ofString "scratch_ptr") = some (.val (.word spw)) ∧
      spw.toNat = globN s "scratch_ptr" ∧
      spw.toNat % 8 = 0 ∧
      globN s "frame_mem_ptr" ≤ spw.toNat ∧
      ((evaluateHOLFiniteState mid cont).1 = none ∨ Resumes (evaluateHOLFiniteState mid cont).1) ∧
      evaluateHOLFiniteState s (.decCall name .one (ofString "scratch_mark") [] cont) =
        ((evaluateHOLFiniteState mid cont).1,
         { (evaluateHOLFiniteState mid cont).2 with
           locals := HolFiniteMapExact.resVarEq (evaluateHOLFiniteState mid cont).2.locals
             (name, s.locals.lookup name) }) := by
  have hnt := none_or_resumes_not_timeOut hor
  have hnot_err : (evaluateHOLFiniteState s (.decCall name .one (ofString "scratch_mark") [] cont)).1 ≠ some .error := by
    intro herr; rcases hor with hn | hr
    · rw [herr] at hn; cases hn
    · rw [herr] at hr; exact not_resumes_error hr
  have hlook_sm : originalRuntimeCode.lookup (ofString "scratch_mark") =
      some ([], sourceFnBody Guest.Software.guestFn_scratch_mark, .one) :=
    lookup_of_guestAst_getElem 14 (by rw [guestAst_len]; decide)
      (extractFn Guest.Software.guestFn_scratch_mark) rfl
  have hl_sm : lookupCodeHOLFinite s.code.lookup (ofString "scratch_mark") [] =
      some (sourceFnBody Guest.Software.guestFn_scratch_mark, HolFiniteMapExact.empty, .one) := by
    rw [hc]
    unfold PanSemStateFiniteExact.lookupCodeHOLFinite
    have hraw : lookupCodeHOLExact originalRuntimeCode.lookup (ofString "scratch_mark") [] =
        some (sourceFnBody Guest.Software.guestFn_scratch_mark, FEMPTY, .one) := by
      simp only [lookupCodeHOLExact, hlook_sm, List.length_nil, List.zip_nil_left, List.all_nil]
      rfl
    split
    · rename_i hnone; rw [hraw] at hnone; cases hnone
    · rename_i b' l' r' hsome
      have heq := Option.some.inj (hsome.symm.trans hraw)
      obtain ⟨rfl, hrest⟩ := Prod.mk.inj heq
      obtain ⟨hl_eq, rfl⟩ := Prod.mk.inj hrest
      refine congrArg some (Prod.ext rfl (Prod.ext ?_ rfl))
      apply HolFiniteMapExact.ext; funext k
      simp [HolFiniteMapExact.empty, hl_eq]; rfl
  rw [evaluateHOLFiniteState_decCall_fixClockRewrite] at hor hnt hnot_err ⊢
  have hargs_sm : evalListHOLFinite s (h := fun a => Classical.propDecidable (s.memaddrs a)) [] = some [] := rfl
  simp only [hargs_sm, hl_sm] at hor hnt hnot_err ⊢
  by_cases hz : s.clock = 0
  · rw [if_pos hz] at hnt; exact absurd rfl hnt
  · rw [if_neg hz] at hor hnt hnot_err ⊢
    obtain ⟨_, _, spw, _, _, _, _, hsp_lk, hsp_glob⟩ := InitECandidate.Solver.Wave8Contracts.M26.arenaOK_globals s hAR.2
    have hsm_run : evaluateHOLFiniteState (callEntryStateHOLFinite s HolFiniteMapExact.empty)
        (sourceFnBody Guest.Software.guestFn_scratch_mark) =
        (some (.returned (.val (.word spw))), emptyLocalsHOLFinite (callEntryStateHOLFinite s HolFiniteMapExact.empty)) := by
      have hbsm : sourceFnBody Guest.Software.guestFn_scratch_mark = .return (.var .global (ofString "scratch_ptr")) := rfl
      rw [hbsm, evaluateHOLFiniteState_return]
      have hg_sp : (callEntryStateHOLFinite s HolFiniteMapExact.empty).globals.lookup (ofString "scratch_ptr") =
          some (.val (.word spw)) := hsp_lk
      simp [evalHOLExact, hg_sp, shapeOfHOLExact]
    simp only [hsm_run] at hor ⊢
    have hsh_sp : (shapeEqHOL (shapeOfHOLExact (.val (.word spw) : ValueHOL 64)) .one &&
        shapeEqHOL (shapeOfHOLExact (.val (.word spw) : ValueHOL 64)) .one) = true := by
      simp [shapeOfHOLExact, shapeEqHOL]
    simp only [hsh_sp, ↓reduceIte] at hor ⊢
    let mid := { s with locals := s.locals.update (name, .val (.word spw)), clock := s.clock - 1 }
    have hmid_eq : setVarHOLFinite name (.val (.word spw))
        { (emptyLocalsHOLFinite (callEntryStateHOLFinite s HolFiniteMapExact.empty)) with locals := s.locals } = mid := rfl
    rw [hmid_eq] at hor ⊢
    exact ⟨spw, hsp_lk, hsp_glob, hsp_glob.symm ▸ hAR.2.2.2.2.2.2.2.2.1,
      hsp_glob.symm ▸ hAR.2.2.2.2.1, hor, rfl⟩

theorem eval_decCall_scratch_alloc_48_or_exn {F : Type}
    (s : PanSemStateFiniteExact 64 F) (name : MlS) (cont : ProgHOL 64)
    (Rl : List Ivl) (gw : List String)
    (hc : s.code = originalRuntimeCode) (hAR : ArenaReady s)
    (hgw_sp : "scratch_ptr" ∈ gw)
    (hor : (evaluateHOLFiniteState s (.decCall name .one (ofString "scratch_alloc") [.const 48] cont)).1 = none ∨
