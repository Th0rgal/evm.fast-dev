  obtain ⟨values, body, callee, retShape, _, hargs, hl,
    ⟨eid, ev, hbe, hne, hfull⟩ | ⟨rv, sc, hrun, _, hcont_in, hr_eq, hp_eq⟩⟩ := decCall_flow_or_exn hor
  · have hvals : values = [.val (.word pw), .val (.word nw)] := by
