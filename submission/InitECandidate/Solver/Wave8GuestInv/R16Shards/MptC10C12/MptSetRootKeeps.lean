  have hmid_sec : mid.locals.lookup (ofString "secured") = some (.val (.word w_sec)) := by
    rw [hmid_loc]; simp [HolFiniteMapExact.lookup_update, FUPDATE, hsec,
      show ofString "m" ≠ ofString "secured" by decide]
  let store0 : ProgHOL 64 :=
    .store (.op .add [.var .local (ofString "m"), .const 0]) (.var .local (ofString "root_node"))
