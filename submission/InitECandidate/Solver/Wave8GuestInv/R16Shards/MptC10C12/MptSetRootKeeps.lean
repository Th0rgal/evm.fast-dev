      · have hu_ite : evaluateHOLFiniteState u
            (.ite (.cmp .notEqual (.var .local (ofString "eq")) (.const 0))
              (.assign .local (ofString "res") (.const 0))
              .skip) = (none, u) := by
          rw [evaluateHOLFiniteState_ite, hcond_eq, if_neg hweq_nz]
          simp [evaluateHOLFiniteState_skip]
        have hout_s := (congrArg Prod.snd hout1).trans (hp_eq.trans (by rw [hu_ite]))
        change (evaluateHOLFiniteState s delKind1).2.memory = s.memory
        rw [show (evaluateHOLFiniteState s delKind1).2 = out.2 from rfl, hout_s]
        dsimp; rw [hu_eq]; rfl
    · rw [if_neg hlen_eq] at hout1
      simp only [↓reduceIte, evaluateHOLFiniteState_skip] at hout1
      change (evaluateHOLFiniteState s delKind1).2.memory = s.memory
      rw [show (evaluateHOLFiniteState s delKind1).2 = out.2 from rfl, hout1]
      rfl
