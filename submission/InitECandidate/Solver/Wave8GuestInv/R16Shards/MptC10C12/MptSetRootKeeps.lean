  rw [evaluateHOLFiniteState_ite, hcond_ev] at hout0
  by_cases hw168_z : w168 = 0
  · rw [if_pos hw168_z] at hout0
    simp only [show (1 : BitVec 64) ≠ 0 by decide, ↓reduceIte] at hout0
    have hass : evaluateHOLFiniteState s
