    ∃ fw : BitVec 64,
      out.1 = none ∧
      (fw ≠ 0 → child0.toNat ∈ Nd ∧ 1 ≤ memW s child0.toNat ∧ memW s child0.toNat ≤ 3) ∧
      (fw = 0 → child0.toNat = 0 ∨ memW s child0.toNat = 0 ∨ memW s (child0.toNat + 8) ≠ 0) ∧
      out.2 = { s with locals := s.locals.update (ofString lname, .val (.word fw)),
                       clock := out.2.clock } := by
  intro out; dsimp only [out]
  obtain ⟨values, body, callee, retShape, _, hargs, hl,
    ⟨eid, ev, hbe, _, _⟩ | ⟨rv, sc, hrun, _, hcall_eq⟩⟩ := call_assign_local_flow_or_exn hor
  · have hvals : values = [.val (.word child0)] := by
      rw [evalListHOLFinite_eq_toExact] at hargs
      simpa [evalListHOLExact, hchild_ev] using hargs.symm
    subst hvals
    have hlk := pan_one_word_lookup s.code.lookup (ofString "_node_needs_rlp") (ofString "child")
      (sourceFnBody Guest.Software.guestFn__node_needs_rlp) child0
      (by rw [hc]; exact lookup__node_needs_rlp_sc)
    rw [hlk] at hl
    obtain ⟨rfl, hrest⟩ := Prod.mk.inj (Option.some.inj hl.symm)
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj hrest
    exact absurd (congrArg Prod.fst hbe)
      (evaluate_noExnProgSc (sourceFnBody Guest.Software.guestFn__node_needs_rlp) rfl _ eid ev)
  · have hvals : values = [.val (.word child0)] := by
      rw [evalListHOLFinite_eq_toExact] at hargs
      simpa [evalListHOLExact, hchild_ev] using hargs.symm
    subst hvals
    have hlk := pan_one_word_lookup s.code.lookup (ofString "_node_needs_rlp") (ofString "child")
      (sourceFnBody Guest.Software.guestFn__node_needs_rlp) child0
      (by rw [hc]; exact lookup__node_needs_rlp_sc)
    rw [hlk] at hl
    obtain ⟨rfl, hrest⟩ := Prod.mk.inj (Option.some.inj hl.symm)
    obtain ⟨hcal_eq, rfl⟩ := Prod.mk.inj hrest
    subst hcal_eq
    set cmap : HolFiniteMapExact MlS (ValueHOL 64) :=
      HolFiniteMapExact.empty.update (ofString "child", .val (.word child0))
    let ent := callEntryStateHOLFinite s cmap
    have hent_child : ent.locals.lookup (ofString "child") = some (.val (.word child0)) := by
      simp [ent, cmap, callEntryStateHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
    have hrun_ent : evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn__node_needs_rlp) =
        (some (.returned rv), sc) := hrun
    obtain ⟨fw, rfl, hnz, hz, hsc_eq⟩ :=
      eval__node_needs_rlp_returned_sc ent Nd child0 rv hc hN hchild_in hent_child (congrArg Prod.fst hrun_ent)
    rw [hrun_ent] at hsc_eq; dsimp only at hsc_eq
    obtain ⟨w_old, hw_old⟩ := hl_old
    refine ⟨fw, congrArg Prod.fst hcall_eq, hnz, hz, ?_⟩
    rw [hcall_eq]; dsimp only [setVarHOLFinite]
    rw [hsc_eq]; cases s; rfl

private def fillBranchCond : ExpHOL 64 :=
  .op .and
    [.cmp .notEqual (.const 0) (.cmp .less (.var .local (ofString "i")) (.const 16)),
     .cmp .notEqual (.const 0) (.cmp .equal (.var .local (ofString "found")) (.const 0))]

private def fillBranchBody : ProgHOL 64 :=
  .seq
    (.assign .local (ofString "child")
      (.load .one
        (.op .add
          [.var .local (ofString "nd"), .const 32,
           .panop .mul [.var .local (ofString "i"), .const 8]])))
    (.seq
      (.assign .local (ofString "i") (.op .add [.var .local (ofString "i"), .const 1]))
      (.call (some (some (.local, ofString "found"), none)) (ofString "_node_needs_rlp")
        [.var .local (ofString "child")]))

theorem eval_fillBranch_loop :
    ∀ (rem : Nat) {F : Type} (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
      (ndw iw cw fw : BitVec 64)
      (hc : s.code = originalRuntimeCode) (hN : NodeHeap s Nd)
      (hnd_in : ndw.toNat ∈ Nd) (hk3 : memW s ndw.toNat = 3)
      (hi_le : iw.toNat ≤ 16) (hrem : rem = 16 - iw.toNat)
      (hfw_inv : fw ≠ 0 → cw.toNat ∈ Nd ∧ 1 ≤ memW s cw.toNat ∧ memW s cw.toNat ≤ 3)
      (hl_nd : s.locals.lookup (ofString "nd") = some (.val (.word ndw)))
      (hl_i : s.locals.lookup (ofString "i") = some (.val (.word iw)))
      (hl_c : s.locals.lookup (ofString "child") = some (.val (.word cw)))
      (hl_f : s.locals.lookup (ofString "found") = some (.val (.word fw)))
      (hor : (evaluateHOLFiniteState s (.while fillBranchCond fillBranchBody)).1 = none ∨
        Resumes (evaluateHOLFiniteState s (.while fillBranchCond fillBranchBody)).1),
      ∃ (iw' cw' fw' : BitVec 64),
        (evaluateHOLFiniteState s (.while fillBranchCond fillBranchBody)).1 = none ∧
        iw'.toNat ≤ 16 ∧
        (fw' ≠ 0 → cw'.toNat ∈ Nd ∧ 1 ≤ memW s cw'.toNat ∧ memW s cw'.toNat ≤ 3) ∧
        (evaluateHOLFiniteState s (.while fillBranchCond fillBranchBody)).2 =
          setVarHOLFinite (ofString "found") (.val (.word fw'))
            (setVarHOLFinite (ofString "i") (.val (.word iw'))
              (setVarHOLFinite (ofString "child") (.val (.word cw'))
                { s with clock := (evaluateHOLFiniteState s (.while fillBranchCond fillBranchBody)).2.clock }))
  | 0, F, s, Nd, ndw, iw, cw, fw, hc, hN, hnd_in, hk3, hi_le, hrem, hfw_inv, hl_nd, hl_i, hl_c, hl_f, hor => by
    have hi16 : iw = 16 := BitVec.eq_of_toNat_eq (by
      have : (16 : BitVec 64).toNat = 16 := rfl
      omega)
    subst hi16
    rw [evaluateHOLFiniteState_while_fixClockRewrite]
    have hcond : @evalHOLFinite 64 F _ s (fun a => Classical.propDecidable (s.memaddrs a))
        fillBranchCond = some (.val (.word 0)) := by
      rw [evalHOLFinite_eq_toExact]
      simp [fillBranchCond, evalHOLExact, evalListHOLExact, hl_i, hl_f,
        Compiler.Encoders.Asm.wordCmpHOL, Compiler.Encoders.Asm.holAsmSignedLess,
        wordOpHOL, wordOp, valueIsWord, valueWord]
    rw [hcond]; dsimp only
    rw [if_neg (by decide : ¬ (0 : BitVec 64) ≠ 0)]
    refine ⟨16, cw, fw, rfl, by decide, hfw_inv, ?_⟩
    cases s; simp only [setVarHOLFinite]; congr 1
    apply HolFiniteMapExact.ext; funext x
    by_cases hxf : x = ofString "found"
    · subst hxf; simpa [HolFiniteMapExact.lookup_update, FUPDATE] using hl_f
    · by_cases hxi : x = ofString "i"
      · subst hxi
        simpa [HolFiniteMapExact.lookup_update, FUPDATE, show ofString "found" ≠ ofString "i" by decide] using hl_i
      · by_cases hxc : x = ofString "child"
        · subst hxc
          simpa [HolFiniteMapExact.lookup_update, FUPDATE,
            show ofString "found" ≠ ofString "child" by decide,
            show ofString "i" ≠ ofString "child" by decide] using hl_c
        · simp [HolFiniteMapExact.lookup_update, FUPDATE, Ne.symm hxf, Ne.symm hxi, Ne.symm hxc]
  | rem + 1, F, s, Nd, ndw, iw, cw, fw, hc, hN, hnd_in, hk3, hi_le, hrem, hfw_inv, hl_nd, hl_i, hl_c, hl_f, hor => by
    have hi_lt16 : iw.toNat < 16 := by omega
    have hlt_true := finish_signedLess_16 iw hi_lt16
    by_cases hfz : fw = 0
    · subst hfz
      have hcond : @evalHOLFinite 64 F _ s (fun a => Classical.propDecidable (s.memaddrs a))
          fillBranchCond = some (.val (.word 1)) := by
        rw [evalHOLFinite_eq_toExact]
        simp [fillBranchCond, evalHOLExact, evalListHOLExact, hl_i, hl_f,
          Compiler.Encoders.Asm.wordCmpHOL, hlt_true, wordOpHOL, wordOp, valueIsWord, valueWord]
      rw [evaluateHOLFiniteState_while_fixClockRewrite] at hor ⊢
      rw [hcond] at hor ⊢; dsimp only at hor ⊢
      rw [if_pos (by decide : (1 : BitVec 64) ≠ 0)] at hor ⊢
      have hnt := none_or_resumes_not_timeOut hor
      by_cases hcz : s.clock = 0
      · rw [if_pos hcz] at hnt; exact absurd rfl hnt
      · rw [if_neg hcz] at hor hnt ⊢
        set s0 := decClockHOLFinite s
        obtain ⟨_, _, hin_nd, hw_nd, _, hch3, _⟩ := hN.1 ndw.toNat hnd_in
        have hsz3 : nodeSize (memW s ndw.toNat) = 176 := by simp [nodeSize, hk3]
        have h264_lim : heapLimit ≤ 2 ^ 64 := by decide
        have hhi_nd : ndw.toNat + nodeSize (memW s ndw.toNat) ≤ 2 ^ 64 := by
          have := hin_nd.2; dsimp [nodeIvl] at this; omega
        have hev_addr : @evalHOLExact 64 F _ s0.toExact (fun a => Classical.propDecidable (s0.memaddrs a))
            (.op .add
              [.var .local (ofString "nd"), .const 32,
               .panop .mul [.var .local (ofString "i"), .const 8]]) =
            some (.val (.word (ndw + BitVec.ofNat 64 (32 + 8 * iw.toNat)))) := by
          have hadd_off : 32#64 + iw * 8#64 = BitVec.ofNat 64 (32 + 8 * iw.toNat) := by
            apply BitVec.eq_of_toNat_eq
            have h32 : (32#64).toNat = 32 := rfl
            have h8 : (8#64).toNat = 8 := rfl
            rw [BitVec.toNat_add, h32, BitVec.toNat_mul, h8, BitVec.toNat_ofNat]
            have hlt1 : iw.toNat * 8 < 2 ^ 64 := by omega
            have hlt2 : 32 + iw.toNat * 8 < 2 ^ 64 := by omega
            have hlt3 : 32 + 8 * iw.toNat < 2 ^ 64 := by omega
            rw [Nat.mod_eq_of_lt hlt1, Nat.mod_eq_of_lt hlt2, Nat.mod_eq_of_lt hlt3]
            omega
          have hl_nd0 : s0.locals.lookup (ofString "nd") = some (.val (.word ndw)) := hl_nd
          have hl_i0 : s0.locals.lookup (ofString "i") = some (.val (.word iw)) := hl_i
          simp [evalHOLExact, evalListHOLExact, hl_nd0, hl_i0, panOpHOL,
            wordOpHOL, wordOp, valueIsWord, valueWord, BitVec.add_assoc, hadd_off]
        obtain ⟨chw, hld_ch, hchw_nat⟩ := eval_load_memW_of_wordsOK (s := s0) (base := ndw)
          (off := 32 + 8 * iw.toNat) (len := nodeSize (memW s ndw.toNat)) hw_nd
          (by omega) (by omega) hhi_nd
          (e := .op .add
            [.var .local (ofString "nd"), .const 32,
             .panop .mul [.var .local (ofString "i"), .const 8]]) hev_addr
        have hch_root : RootIn Nd chw.toNat := by
          have hr := hch3 hk3 iw.toNat hi_lt16
          have hm0 : memW s0 (ndw.toNat + (32 + 8 * iw.toNat)) = memW s (ndw.toNat + 32 + 8 * iw.toNat) := by
            have : ndw.toNat + (32 + 8 * iw.toNat) = ndw.toNat + 32 + 8 * iw.toNat := by omega
            rw [this]; rfl
          rwa [hchw_nat, hm0]
        have hev_a1 : evaluateHOLFiniteState s0
            (.assign .local (ofString "child")
              (.load .one
                (.op .add
                  [.var .local (ofString "nd"), .const 32,
                   .panop .mul [.var .local (ofString "i"), .const 8]]))) =
            (none, setVarHOLFinite (ofString "child") (.val (.word chw)) s0) :=
          assign_local_word_eq s0 (ofString "child") _ chw cw hl_c hld_ch
        set s1 := setVarHOLFinite (ofString "child") (.val (.word chw)) s0
        have hl_i1 : s1.locals.lookup (ofString "i") = some (.val (.word iw)) := by
          simp [s1, s0, decClockHOLFinite, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hl_i,
            show ofString "child" ≠ ofString "i" by decide]
        have hev_a2 : evaluateHOLFiniteState s1
            (.assign .local (ofString "i") (.op .add [.var .local (ofString "i"), .const 1])) =
            (none, setVarHOLFinite (ofString "i") (.val (.word (iw + 1))) s1) :=
          assign_local_word_eq s1 (ofString "i") _ (iw + 1) iw hl_i1
            (by simp [evalHOLExact, evalListHOLExact, hl_i1, wordOpHOL, wordOp, valueIsWord, valueWord])
        set s2 := setVarHOLFinite (ofString "i") (.val (.word (iw + 1))) s1
        have hl_c2 : s2.locals.lookup (ofString "child") = some (.val (.word chw)) := by
          simp [s2, s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
            show ofString "i" ≠ ofString "child" by decide]
        have hl_f2 : s2.locals.lookup (ofString "found") = some (.val (.word 0)) := by
          simp [s2, s1, s0, decClockHOLFinite, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hl_f,
            show ofString "i" ≠ ofString "found" by decide,
            show ofString "child" ≠ ofString "found" by decide]
        have hbody_pre : evaluateHOLFiniteState s0 fillBranchBody =
            evaluateHOLFiniteState s2
              (.call (some (some (.local, ofString "found"), none)) (ofString "_node_needs_rlp")
                [.var .local (ofString "child")]) := by
          unfold fillBranchBody
          rw [evaluateHOLFiniteState_seq_line780, hev_a1]; dsimp only
          rw [evaluateHOLFiniteState_seq_line780, hev_a2]
        rw [hbody_pre] at hor ⊢
        have hor_call : (evaluateHOLFiniteState s2
            (.call (some (some (.local, ofString "found"), none)) (ofString "_node_needs_rlp")
              [.var .local (ofString "child")])).1 = none ∨
            Resumes (evaluateHOLFiniteState s2
              (.call (some (some (.local, ofString "found"), none)) (ofString "_node_needs_rlp")
                [.var .local (ofString "child")])).1 := by
          have hor' := hor
          rcases hcev : evaluateHOLFiniteState s2
              (.call (some (some (.local, ofString "found"), none)) (ofString "_node_needs_rlp")
                [.var .local (ofString "child")]) with ⟨rc, s3⟩
          rw [hcev] at hor'
          cases rc with
          | none => exact Or.inl rfl
          | some rc' =>
            have hnbc := evaluate_noBCProg
              (.call (some (some (.local, ofString "found"), none)) (ofString "_node_needs_rlp")
                [.var .local (ofString "child")]) rfl s2 (by rw [hcev])
            cases rc' with
            | «break» => exact absurd rfl hnbc.1
            | «continue» => exact absurd rfl hnbc.2
            | _ => exact hor'
        obtain ⟨fw1, hcall_none, hfw1_nz, _, hs3_eq⟩ :=
          eval_call_local__node_needs_rlp_or_exn_sc s2 Nd "found" (.var .local (ofString "child")) chw
            hc hN ⟨0, hl_f2⟩ hch_root (by simp [evalHOLExact, hl_c2]) hor_call
        rw [hcall_none] at hor ⊢
        dsimp only at hor ⊢
        set s3 := (evaluateHOLFiniteState s2
            (.call (some (some (.local, ofString "found"), none)) (ofString "_node_needs_rlp")
              [.var .local (ofString "child")])).2
        have hs3_c : s3.code = originalRuntimeCode := by rw [hs3_eq]; exact hc
        have hs3_N : NodeHeap s3 Nd := by rw [hs3_eq]; exact hN
        have hmem_s3_s : ∀ addr, memW s3 addr = memW s addr := fun addr => by rw [hs3_eq]; rfl
        have hi1_nat : (iw + 1).toNat = iw.toNat + 1 := by
          rw [BitVec.toNat_add]
          have : (1 : BitVec 64).toNat = 1 := rfl
          rw [this, Nat.mod_eq_of_lt (by omega)]
        have hl_nd3 : s3.locals.lookup (ofString "nd") = some (.val (.word ndw)) := by
          rw [hs3_eq]; simp [s2, s1, s0, decClockHOLFinite, setVarHOLFinite,
            HolFiniteMapExact.lookup_update, FUPDATE, hl_nd,
            show ofString "found" ≠ ofString "nd" by decide,
            show ofString "i" ≠ ofString "nd" by decide,
            show ofString "child" ≠ ofString "nd" by decide]
        have hl_i3 : s3.locals.lookup (ofString "i") = some (.val (.word (iw + 1))) := by
          rw [hs3_eq]; simp [s2, s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
            show ofString "found" ≠ ofString "i" by decide]
        have hl_c3 : s3.locals.lookup (ofString "child") = some (.val (.word chw)) := by
          rw [hs3_eq]; simp [HolFiniteMapExact.lookup_update, FUPDATE, hl_c2,
            show ofString "found" ≠ ofString "child" by decide]
        have hl_f3 : s3.locals.lookup (ofString "found") = some (.val (.word fw1)) := by
          rw [hs3_eq]; simp [HolFiniteMapExact.lookup_update, FUPDATE]
        obtain ⟨iw', cw', fw', hrec_none, hiw'_le, hfw'_nz, hrec_st⟩ :=
          eval_fillBranch_loop rem s3 Nd ndw (iw + 1) chw fw1 hs3_c hs3_N hnd_in
            (by rw [hmem_s3_s]; exact hk3) (by omega) (by omega)
            (fun hnz => by
              obtain ⟨h1, h2, h3⟩ := hfw1_nz hnz
              rw [hmem_s3_s]; exact ⟨h1, h2, h3⟩)
            hl_nd3 hl_i3 hl_c3 hl_f3 hor
        refine ⟨iw', cw', fw', hrec_none, hiw'_le,
          fun hnz => by
            obtain ⟨h1, h2, h3⟩ := hfw'_nz hnz
            rw [← hmem_s3_s]; exact ⟨h1, h2, h3⟩, ?_⟩
        rw [hrec_st]
        rw [hs3_eq]
        cases s; simp only [s2, s1, s0, decClockHOLFinite, setVarHOLFinite]; congr 1
        apply HolFiniteMapExact.ext; funext x
        by_cases hxf : x = ofString "found"
        · subst hxf; simp [HolFiniteMapExact.lookup_update, FUPDATE]
        · by_cases hxi : x = ofString "i"
          · subst hxi
            simp [HolFiniteMapExact.lookup_update, FUPDATE, show ofString "found" ≠ ofString "i" by decide]
          · by_cases hxc : x = ofString "child"
            · subst hxc
              simp [HolFiniteMapExact.lookup_update, FUPDATE,
                show ofString "found" ≠ ofString "child" by decide,
                show ofString "i" ≠ ofString "child" by decide]
            · simp [HolFiniteMapExact.lookup_update, FUPDATE, Ne.symm hxf, Ne.symm hxi, Ne.symm hxc]
    · have hcond : @evalHOLFinite 64 F _ s (fun a => Classical.propDecidable (s.memaddrs a))
          fillBranchCond = some (.val (.word 0)) := by
        have hfz' : ¬ (fw = 0#64) := hfz
        rw [evalHOLFinite_eq_toExact]
        simp [fillBranchCond, evalHOLExact, evalListHOLExact, hl_i, hl_f,
          Compiler.Encoders.Asm.wordCmpHOL, hlt_true, hfz', wordOpHOL, wordOp, valueIsWord, valueWord]
      rw [evaluateHOLFiniteState_while_fixClockRewrite]
      rw [hcond]; dsimp only
      rw [if_neg (by decide : ¬ (0 : BitVec 64) ≠ 0)]
      refine ⟨iw, cw, fw, rfl, hi_le, hfw_inv, ?_⟩
      cases s; simp only [setVarHOLFinite]; congr 1
      apply HolFiniteMapExact.ext; funext x
      by_cases hxf : x = ofString "found"
      · subst hxf; simpa [HolFiniteMapExact.lookup_update, FUPDATE] using hl_f
      · by_cases hxi : x = ofString "i"
        · subst hxi
          simpa [HolFiniteMapExact.lookup_update, FUPDATE, show ofString "found" ≠ ofString "i" by decide] using hl_i
        · by_cases hxc : x = ofString "child"
          · subst hxc
            simpa [HolFiniteMapExact.lookup_update, FUPDATE,
              show ofString "found" ≠ ofString "child" by decide,
              show ofString "i" ≠ ofString "child" by decide] using hl_c
          · simp [HolFiniteMapExact.lookup_update, FUPDATE, Ne.symm hxf, Ne.symm hxi, Ne.symm hxc]

def FillLinks {F : Type} (node0 : Nat) (s : PanSemStateFiniteExact 64 F) : List Nat → Prop
  | [] => True
  | [f] => memW s f = 0 ∧ memW s (f + 8) = node0
  | f :: g :: rest => memW s f = g ∧ FillLinks node0 s (g :: rest)

def FillFrameInv {F : Type} (sp0 : Nat) (Nd : List Nat) (s : PanSemStateFiniteExact 64 F) (g : Nat) : Prop :=
  g % 8 = 0 ∧
  Inside (g, 48) (globN s "scratch_ptr") sp0 ∧
  WordsOK s (g, 48) ∧
  memW s (g + 8) ∈ Nd ∧
  1 ≤ memW s (memW s (g + 8)) ∧
  memW s (g + 16) ≤ 16 ∧
  RlpFrameExact s g (memW s (g + 8)) ∧
  ((memW s (memW s (g + 8)) = 1 ∨ memW s (memW s (g + 8)) = 2) →
    ∀ iv ∈ nodeCacheIvls Nd ++ keccakBufIvls s, 0 < iv.2 →
      Disj (memW s (g + 24), memW s (g + 32)) iv)

def FillStack {F : Type} (sp0 node0 : Nat) (Nd : List Nat) (s : PanSemStateFiniteExact 64 F)
    (topw : BitVec 64) (fs : List Nat) : Prop :=
  fs.Pairwise (fun f1 f2 => Disj (f1, 48) (f2, 48)) ∧
  FillLinks node0 s fs ∧
  (∀ g ∈ fs, FillFrameInv sp0 Nd s g) ∧
  match fs with
  | [] => topw = 0 ∧ sourceBase ≤ memW s (node0 + 8) ∧ 1 ≤ memW s (node0 + 16)
  | f :: _ => topw.toNat = f

private theorem fillLinks_congr {F : Type} {node0 : Nat} {s post : PanSemStateFiniteExact 64 F}
    {fs : List Nat}
    (h0 : ∀ g ∈ fs, memW post g = memW s g)
    (h8 : ∀ g ∈ fs, memW post (g + 8) = memW s (g + 8))
    (hl : FillLinks node0 s fs) :
    FillLinks node0 post fs := by
  induction fs with
  | nil => trivial
  | cons f rest ih =>
    cases rest with
    | nil =>
      dsimp [FillLinks] at hl ⊢
      rw [h0 f List.mem_cons_self, h8 f List.mem_cons_self]
      exact hl
    | cons g tail =>
      dsimp [FillLinks] at hl ⊢
      refine ⟨?_, ih (fun x hx => h0 x (List.mem_cons_of_mem f hx))
        (fun x hx => h8 x (List.mem_cons_of_mem f hx)) hl.2⟩
      rw [h0 f List.mem_cons_self]; exact hl.1

private theorem fillFrameInv_congr_of_heapByteEff {F : Type}
    {sp0 : Nat} {s post : PanSemStateFiniteExact 64 F} {Nd : List Nat} {g : Nat}
    {extra : List Ivl} {gw : List String}
    (hAs : ArenaReady s) (hN : NodeHeap s Nd)
    (heff : HeapByteEff s post (nodeCacheIvls Nd ++ keccakBufIvls s ++ extra) gw)
    (hkc_eq : keccakBufIvls post = keccakBufIvls s)
    (hsp_le : globN s "scratch_ptr" ≤ sp0)
    (hsp0_hi : sp0 ≤ scratchEnd)
    (hsp_post_le : globN post "scratch_ptr" ≤ g)
    (hvs : NodeValuesSafe sp0 s Nd)
    (hextra_vp : memW s (memW s (g + 8)) = 1 → memW s (memW s (g + 8) + 56) = 1 →
      ordinaryDomain (panByteAlignHOL (BitVec.ofNat 64 (memW s (memW s (g + 8) + 48)))) →
      ∀ e ∈ extra, 0 < e.2 → ¬ InIvl (memW s (memW s (g + 8) + 48)) e)
    (hextra_cbuf : (memW s (memW s (g + 8)) = 1 ∨ memW s (memW s (g + 8)) = 2) →
      ∀ e ∈ extra, 0 < e.2 → Disj (memW s (g + 24), memW s (g + 32)) e)
    (hkc_lt_hl : ∀ iv ∈ keccakBufIvls s, 0 < iv.2 → iv.1 + iv.2 ≤ scratchStart ∨ sp0 ≤ iv.1)
    (hextra_disj_g : ∀ e ∈ extra, 0 < e.2 → Disj (g, 48) e)
    (hnc : ∀ n ∈ Nd, ∀ off, off % 8 = 0 → off + 8 ≤ nodeSize (memW s n) →
      (off = 0 ∨ 32 ≤ off) → memW post (n + off) = memW s (n + off))
    (hinv : FillFrameInv sp0 Nd s g) :
    FillFrameInv sp0 Nd post g ∧ memW post g = memW s g ∧ memW post (g + 8) = memW s (g + 8) := by
  obtain ⟨hg8, hin_g, hw_g, hnd_in, hk1, hm16_le, hrf, hcb_disj_s⟩ := hinv
  have hhl_val : heapLimit = 0xb0000000 := rfl
  have hsc_val : scratchStart = 0xb0000000 := rfl
  have hse_lt : scratchEnd < 2 ^ 64 := by decide
  have hsp_lo : scratchStart ≤ globN s "scratch_ptr" := by
    have h1 := hAs.2.2.2.2.1
    have h2 := hAs.2.2.2.1
    omega
  have hg_lt264 : g + 48 ≤ 2 ^ 64 := by
    dsimp [Inside] at hin_g; omega
  have hal_g : Allocated s (g, 48) :=
    Or.inr ⟨by dsimp [Inside] at hin_g; omega, by dsimp [Inside] at hin_g; omega⟩
  have hdisj_g : ∀ iv ∈ nodeCacheIvls Nd ++ keccakBufIvls s ++ extra, 0 < iv.2 → Disj (g, 48) iv := by
    intro iv hiv hpos
    rcases List.mem_append.1 hiv with h1 | hex
    · rcases List.mem_append.1 h1 with hnc_iv | hkc_iv
      · obtain ⟨m, hm, rfl⟩ := List.mem_map.1 hnc_iv
        obtain ⟨_, _, hin_m, _⟩ := hN.1 m hm
        have hsz_m := nodeSize_ge32 (memW s m)
        dsimp [nodeIvl, Inside] at hin_m hin_g
        exact Or.inr (Or.inr (Or.inr (by omega)))
      · rcases hkc_lt_hl iv hkc_iv hpos with hhi | hlo
        · dsimp [Inside] at hin_g; exact Or.inr (Or.inr (Or.inr (by omega)))
        · dsimp [Inside] at hin_g; exact Or.inr (Or.inr (Or.inl (by omega)))
    · exact hextra_disj_g iv hex hpos
  have hmem_off : ∀ off, off % 8 = 0 → off + 8 ≤ 48 → memW post (g + off) = memW s (g + off) := by
    intro off hoff8 hoff_lt
    apply memW_eq_of_heapByteEff_disj hAs heff (by omega)
      (Or.inr ⟨by dsimp [Inside] at hin_g; omega, by dsimp [Inside] at hin_g; omega⟩)
      (by omega)
    intro iv hiv hpos
    have hdj := hdisj_g iv hiv hpos
    rcases hdj with h0 | h0 | hd1 | hd2
    · omega
    · exact Or.inr (Or.inl h0)
    · exact Or.inr (Or.inr (Or.inl (by omega)))
    · exact Or.inr (Or.inr (Or.inr (by omega)))
  have hm0_eq : memW post g = memW s g := by simpa using hmem_off 0 rfl (by omega)
  have hm8_eq : memW post (g + 8) = memW s (g + 8) := hmem_off 8 rfl (by omega)
  have hm16_eq : memW post (g + 16) = memW s (g + 16) := hmem_off 16 rfl (by omega)
  have hm24_eq : memW post (g + 24) = memW s (g + 24) := hmem_off 24 rfl (by omega)
  have hm32_eq : memW post (g + 32) = memW s (g + 32) := hmem_off 32 rfl (by omega)
  set nd := memW s (g + 8)
  have hnd_kind : memW post nd = memW s nd := by
    have hsz := nodeSize_ge32 (memW s nd)
    simpa using hnc nd hnd_in 0 rfl (by omega) (Or.inl rfl)
  have hnd_48 : memW s nd = 1 → memW post (nd + 48) = memW s (nd + 48) ∧ memW post (nd + 56) = memW s (nd + 56) := by
    intro hk_is1
    have hsz1 : nodeSize (memW s nd) = 64 := by simp [nodeSize, hk_is1]
    exact ⟨hnc nd hnd_in 48 (by omega) (by omega) (Or.inr (by omega)),
           hnc nd hnd_in 56 (by omega) (by omega) (Or.inr (by omega))⟩
  have hdisj_cbuf : (memW s nd = 1 ∨ memW s nd = 2) →
      ∀ iv ∈ nodeCacheIvls Nd ++ keccakBufIvls s ++ extra, 0 < iv.2 →
        Disj (memW s (g + 24), memW s (g + 32)) iv := by
    intro hk12 iv hiv hpos
    rcases List.mem_append.1 hiv with h1 | hex
    · exact hcb_disj_s hk12 iv h1 hpos
    · exact hextra_cbuf hk12 iv hex hpos
  have hrf_post : RlpFrameExact post g nd :=
    rlpFrameExact_congr_of_heapByteEff hAs heff hsp_le hal_g hg8 hg_lt264 hdisj_g
      hnd_in hvs hextra_vp hnd_kind hnd_48 hdisj_cbuf hrf
  have hw_g_post : WordsOK post (g, 48) :=
    P3MptSet.wordsOK_transfer hAs.1 heff.arena.1 hw_g
  refine ⟨⟨hg8, ⟨hsp_post_le, hin_g.2⟩, hw_g_post, ?_, ?_, ?_, ?_, ?_⟩, hm0_eq, hm8_eq⟩
  · rw [hm8_eq]; exact hnd_in
  · rw [hm8_eq, hnd_kind]; exact hk1
  · rw [hm16_eq]; exact hm16_le
  · rw [hm8_eq]; exact hrf_post
  · rw [hm8_eq, hnd_kind, hm24_eq, hm32_eq, hkc_eq]; exact hcb_disj_s

private def ProgPreservesLocal (x : MlS) : ProgHOL 64 → Prop
  | .skip => True
  | .assign .local y _ => y ≠ x
  | .dec y _ _ p => y ≠ x ∧ ProgPreservesLocal x p
  | .seq p q | .ite _ p q => ProgPreservesLocal x p ∧ ProgPreservesLocal x q
  | .call (some (some (.local, y), none)) _ _ => y ≠ x
  | .decCall y _ _ _ p => y ≠ x ∧ ProgPreservesLocal x p
  | _ => False

private theorem lookup_eq_of_progPreservesLocal {F : Type} {x : MlS}
    {p : ProgHOL 64} (hp : ProgPreservesLocal x p)
    (s : PanSemStateFiniteExact 64 F)
    (hn : (evaluateHOLFiniteState s p).1 = none) :
    (evaluateHOLFiniteState s p).2.locals.lookup x = s.locals.lookup x :=
  match p, hp with
  | .skip, _ => by rw [evaluateHOLFiniteState_skip]
  | .assign .local y e, hyx => by
    have hyx' : y ≠ x := hyx
    revert hn; rw [evaluateHOLFiniteState_assign]
    cases @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) e with
    | none => intro hn; cases hn
    | some v =>
      dsimp only
      split_ifs
      · intro _; dsimp [setKvarHOLFinite, setVarHOLFinite]
        simp [HolFiniteMapExact.lookup_update, FUPDATE, hyx']
      · intro hn; cases hn
  | .dec y sh e q, ⟨hyx, hq⟩ => by
    revert hn; rw [evaluateHOLFiniteState_dec_total]; dsimp only
    cases @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) e with
    | none => intro hn; cases hn
    | some v =>
      dsimp only
      split_ifs
      · dsimp only
        intro hn
        have ihq := lookup_eq_of_progPreservesLocal hq (setVarHOLFinite y v s) hn
        have hsy : (setVarHOLFinite y v s).locals.lookup x = s.locals.lookup x := by
          simp [setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hyx]
        rw [InitECandidate.Solver.PanRunBounded.resVarEq_lookup, if_neg hyx.symm, ihq, hsy]
      · intro hn; cases hn
  | .seq p1 p2, ⟨hp1, hp2⟩ => by
    have hseq1 : (evaluateHOLFiniteState s (.seq p1 p2)).1 =
        (match (evaluateHOLFiniteState s p1).1 with
         | none => (evaluateHOLFiniteState (evaluateHOLFiniteState s p1).2 p2).1
         | some v => some v) := by
      rw [evaluateHOLFiniteState_seq_line780]; rcases evaluateHOLFiniteState s p1 with ⟨_ | _, _⟩ <;> rfl
    have hseq2 : (evaluateHOLFiniteState s (.seq p1 p2)).2 =
        (match (evaluateHOLFiniteState s p1).1 with
         | none => (evaluateHOLFiniteState (evaluateHOLFiniteState s p1).2 p2).2
         | some _ => (evaluateHOLFiniteState s p1).2) := by
      rw [evaluateHOLFiniteState_seq_line780]; rcases evaluateHOLFiniteState s p1 with ⟨_ | _, _⟩ <;> rfl
    revert hn; rw [hseq1, hseq2]
    rcases hr1 : evaluateHOLFiniteState s p1 with ⟨_ | r1, s1⟩
    · dsimp only
      intro hn
      have h1 := lookup_eq_of_progPreservesLocal hp1 s (congrArg Prod.fst hr1)
      rw [hr1] at h1
      exact (lookup_eq_of_progPreservesLocal hp2 s1 hn).trans h1
    · dsimp only; intro hn; cases hn
  | .ite e p1 p2, ⟨hp1, hp2⟩ => by
    revert hn; rw [evaluateHOLFiniteState_ite]
    cases @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) e with
    | none => intro hn; cases hn
    | some v =>
      rcases v with ⟨⟨w⟩⟩ | _ | _
      · dsimp only
        by_cases hw : w = 0
        · rw [if_pos hw]; intro hn; exact lookup_eq_of_progPreservesLocal hp2 s hn
        · rw [if_neg hw]; intro hn; exact lookup_eq_of_progPreservesLocal hp1 s hn
      · intro hn; cases hn
      · intro hn; cases hn
  | .decCall y sh fn args q, ⟨hyx, hq⟩ => by
    obtain ⟨_, _, _, _, _, _, _, ⟨_, _, _, _, hceq⟩ | ⟨rv, post, _, _, _, hr1, hr2⟩⟩ :=
      decCall_flow_or_exn_scratch (Or.inl hn)
    · rw [hceq] at hn; cases hn
    · rw [hr1] at hn
      rw [hr2]; dsimp only
      have ihq := lookup_eq_of_progPreservesLocal hq (setVarHOLFinite y rv { post with locals := s.locals }) hn
      have hsy : (setVarHOLFinite y rv { post with locals := s.locals }).locals.lookup x = s.locals.lookup x := by
        simp [setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hyx]
      rw [InitECandidate.Solver.PanRunBounded.resVarEq_lookup, if_neg hyx.symm, ihq, hsy]
  | .call (some (some (.local, y), none)) fn args, hyx => by
    have hyx' : y ≠ x := hyx
    obtain ⟨_, _, _, _, _, _, _, ⟨_, _, _, _, hceq⟩ | ⟨_, _, _, _, hceq⟩⟩ :=
      call_assign_local_flow_or_exn (Or.inl hn)
    · rw [hceq] at hn; cases hn
    · rw [hceq]; dsimp [setVarHOLFinite]
      simp [HolFiniteMapExact.lookup_update, FUPDATE, hyx']

private theorem no_returned_of_progPreservesLocal {F : Type} {x : MlS}
    {p : ProgHOL 64} (hp : ProgPreservesLocal x p)
    (s : PanSemStateFiniteExact 64 F) (v : ValueHOL 64) :
    (evaluateHOLFiniteState s p).1 ≠ some (.returned v) :=
  match p, hp with
  | .skip, _ => by rw [evaluateHOLFiniteState_skip]; simp
  | .assign .local y e, _ => by
    rw [evaluateHOLFiniteState_assign]
    cases @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) e with
    | none => simp
    | some _ => dsimp only; split_ifs <;> simp
  | .dec y sh e q, ⟨_, hq⟩ => by
    rw [evaluateHOLFiniteState_dec_total]; dsimp only
    cases @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) e with
    | none => simp
    | some ev => dsimp only; split_ifs; exact no_returned_of_progPreservesLocal hq (setVarHOLFinite y ev s) v; simp
  | .seq p1 p2, ⟨hp1, hp2⟩ => by
    have hseq1 : (evaluateHOLFiniteState s (.seq p1 p2)).1 =
        (match (evaluateHOLFiniteState s p1).1 with
         | none => (evaluateHOLFiniteState (evaluateHOLFiniteState s p1).2 p2).1
         | some r => some r) := by
      rw [evaluateHOLFiniteState_seq_line780]; rcases evaluateHOLFiniteState s p1 with ⟨_ | _, _⟩ <;> rfl
    rw [hseq1]
    rcases hr1 : evaluateHOLFiniteState s p1 with ⟨_ | r1, s1⟩
    · exact no_returned_of_progPreservesLocal hp2 s1 v
    · dsimp only; intro h; injection h with hr; subst hr
      exact no_returned_of_progPreservesLocal hp1 s v (congrArg Prod.fst hr1)
  | .ite e p1 p2, ⟨hp1, hp2⟩ => by
    rw [evaluateHOLFiniteState_ite]
    cases @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) e with
    | none => simp
    | some ev =>
      rcases ev with ⟨⟨w⟩⟩ | _ | _
      · dsimp only; split_ifs
        · exact no_returned_of_progPreservesLocal hp2 s v
        · exact no_returned_of_progPreservesLocal hp1 s v
      · simp
      · simp
  | .decCall y sh fn args q, ⟨_, hq⟩ => by
    intro hret
    obtain ⟨_, _, _, _, _, _, _, ⟨_, _, _, _, hceq⟩ | ⟨rv, post, _, _, _, hr1, _⟩⟩ :=
      decCall_flow_or_exn_scratch (Or.inr (Or.inl ⟨v, hret⟩))
    · rw [hceq] at hret; cases hret
    · rw [hr1] at hret; exact no_returned_of_progPreservesLocal hq (setVarHOLFinite y rv { post with locals := s.locals }) v hret
  | .call (some (some (.local, y), none)) fn args, _ => by
    intro hret
    obtain ⟨_, _, _, _, _, _, _, ⟨_, _, _, _, hceq⟩ | ⟨_, _, _, _, hceq⟩⟩ :=
      call_assign_local_flow_or_exn (Or.inr (Or.inl ⟨v, hret⟩)) <;>
      (rw [hceq] at hret; cases hret)

