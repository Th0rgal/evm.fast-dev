              intro o ho; simp only [bufferRegion, hkp, hks]; exact hkc_disj o ho)
            hvs_sb
        exact ⟨rpw, rlw, mid, hsb_c, rfl, heff_mid, hsp_sb, hN_mid, hext_sb, hkc_sb, hvs_mid, hret, rfl⟩
      | _ => simp at hret

