            · subst hxf
              rw [InitECandidate.Solver.PanRunBounded.resVarEq_lookup, if_pos rfl]
              simp [d3, d2, d1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
                show ofString "child" ≠ ofString "found" by decide,
                show ofString "k" ≠ ofString "found" by decide,
                show ofString "nd" ≠ ofString "found" by decide]
            · rw [InitECandidate.Solver.PanRunBounded.resVarEq_lookup, if_neg hxf]
              rw [hl_pp_other x hxt, hl_sf_other x hxc hxf]
              simp [d4, d3, d2, d1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
                Ne.symm hxf, Ne.symm hxc, Ne.symm hxk, Ne.symm hxnd]

private theorem eval_fillStack_loop {F : Type}
    (sp0 node0 : Nat) (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
    (topw : BitVec 64) (fs : List Nat)
    (hc : s.code = originalRuntimeCode) (hAR : ArenaReady s) (hN : NodeHeap s Nd)
    (hsp_le : globN s "scratch_ptr" ≤ sp0) (hsp0_hi : sp0 ≤ scratchEnd)
    (hvs : NodeValuesSafe sp0 s Nd)
    (hkc_disj : ∀ o ∈ nodeExtents s Nd,
      Disj (bufferRegion s ("keccak_pad", 136)) o ∧
      Disj (bufferRegion s ("keccak_st", 200)) o)
    (hkc_lt_hp : ∀ iv ∈ keccakBufIvls s, 0 < iv.2 → iv.1 + iv.2 ≤ globN s "heap_ptr" ∨ sp0 ≤ iv.1)
    (hfs : FillStack sp0 node0 Nd s topw fs)
    (hl_top : s.locals.lookup (ofString "top") = some (.val (.word topw)))
    (hor : (evaluateHOLFiniteState s (.while fillStackCond fillStackBody)).1 = none ∨
      Resumes (evaluateHOLFiniteState s (.while fillStackCond fillStackBody)).1) :
    let out := evaluateHOLFiniteState s (.while fillStackCond fillStackBody)
    (∃ eid ev,
      eid ≠ ofString "TrapErr" ∧
      out.1 = some (.exception eid ev) ∧
      HeapByteEff s out.2
        (nodeCacheIvls Nd ++ keccakBufIvls s ++ [freeGapTo sp0 s])
        ["heap_ptr", "scratch_ptr"] ∧
      globN out.2 "scratch_ptr" ≤ globN s "scratch_ptr" ∧
      NodeHeap out.2 Nd ∧
      nodeExtents out.2 Nd = nodeExtents s Nd ∧
      keccakBufIvls out.2 = keccakBufIvls s ∧
      NodeValuesSafe sp0 out.2 Nd) ∨
    (out.1 = none ∧
      out.2.code = originalRuntimeCode ∧
      HeapByteEff s out.2
        (nodeCacheIvls Nd ++ keccakBufIvls s ++ [freeGapTo sp0 s])
        ["heap_ptr", "scratch_ptr"] ∧
      globN out.2 "scratch_ptr" ≤ globN s "scratch_ptr" ∧
      NodeHeap out.2 Nd ∧
      nodeExtents out.2 Nd = nodeExtents s Nd ∧
      keccakBufIvls out.2 = keccakBufIvls s ∧
      NodeValuesSafe sp0 out.2 Nd ∧
      sourceBase ≤ memW out.2 (node0 + 8) ∧
      1 ≤ memW out.2 (node0 + 16) ∧
      out.2.locals.lookup (ofString "top") = some (.val (.word 0)) ∧
      (∀ x : MlS, x ≠ ofString "top" → out.2.locals.lookup x = s.locals.lookup x)) := by
  intro out; dsimp only [out]
  suffices hmain : ∀ (ck : Nat) (u : PanSemStateFiniteExact 64 F) (tw : BitVec 64) (stk : List Nat),
      u.clock = ck →
      u.code = originalRuntimeCode → ArenaReady u → NodeHeap u Nd →
      globN u "scratch_ptr" ≤ sp0 →
      NodeValuesSafe sp0 u Nd →
      (∀ o ∈ nodeExtents u Nd,
        Disj (bufferRegion u ("keccak_pad", 136)) o ∧
        Disj (bufferRegion u ("keccak_st", 200)) o) →
      (∀ iv ∈ keccakBufIvls u, 0 < iv.2 → iv.1 + iv.2 ≤ globN u "heap_ptr" ∨ sp0 ≤ iv.1) →
      FillStack sp0 node0 Nd u tw stk →
      u.locals.lookup (ofString "top") = some (.val (.word tw)) →
      ((evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).1 = none ∨
        Resumes (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).1) →
      (∃ eid ev,
        eid ≠ ofString "TrapErr" ∧
        (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).1 = some (.exception eid ev) ∧
        HeapByteEff u (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2
          (nodeCacheIvls Nd ++ keccakBufIvls u ++ [freeGapTo sp0 u])
          ["heap_ptr", "scratch_ptr"] ∧
        globN (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 "scratch_ptr" ≤ globN u "scratch_ptr" ∧
        NodeHeap (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 Nd ∧
        nodeExtents (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 Nd = nodeExtents u Nd ∧
        keccakBufIvls (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 = keccakBufIvls u ∧
        NodeValuesSafe sp0 (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 Nd) ∨
      ((evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).1 = none ∧
        (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2.code = originalRuntimeCode ∧
        HeapByteEff u (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2
          (nodeCacheIvls Nd ++ keccakBufIvls u ++ [freeGapTo sp0 u])
          ["heap_ptr", "scratch_ptr"] ∧
        globN (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 "scratch_ptr" ≤ globN u "scratch_ptr" ∧
        NodeHeap (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 Nd ∧
        nodeExtents (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 Nd = nodeExtents u Nd ∧
        keccakBufIvls (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 = keccakBufIvls u ∧
        NodeValuesSafe sp0 (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 Nd ∧
        sourceBase ≤ memW (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 (node0 + 8) ∧
        1 ≤ memW (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2 (node0 + 16) ∧
        (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2.locals.lookup (ofString "top") =
          some (.val (.word 0)) ∧
        (∀ x : MlS, x ≠ ofString "top" →
          (evaluateHOLFiniteState u (.while fillStackCond fillStackBody)).2.locals.lookup x =
            u.locals.lookup x)) by
    exact hmain s.clock s topw fs rfl hc hAR hN hsp_le hvs hkc_disj hkc_lt_hp hfs hl_top hor
  intro ck
  induction ck using Nat.strong_induction_on with
  | _ ck ih =>
    intro u tw stk hck huc huAR huN husp huvs hukc_disj hukc_hp hufs hul_top huor
    cases stk with
    | nil =>
      obtain ⟨_, _, _, htw0, hnd8_lo, hnd16_lo⟩ := hufs
      subst htw0
      rw [evaluateHOLFiniteState_while_fixClockRewrite]
      have hcond0 : @evalHOLFinite 64 F _ u (fun a => Classical.propDecidable (u.memaddrs a))
          fillStackCond = some (.val (.word 0)) := by
        rw [evalHOLFinite_eq_toExact]
        simp [fillStackCond, evalHOLExact, hul_top, Compiler.Encoders.Asm.wordCmpHOL]
      rw [hcond0]; dsimp only
      rw [if_neg (by decide : ¬ (0 : BitVec 64) ≠ 0)]
      exact Or.inr ⟨rfl, huc, HeapByteEff.refl huAR _ _, le_rfl, huN, rfl, rfl, huvs,
        hnd8_lo, hnd16_lo, hul_top, fun _ _ => rfl⟩
    | cons f0 rest =>
      have htw_nat : tw.toNat = f0 := hufs.2.2.2
      have hinv_f0 := hufs.2.2.1 f0 List.mem_cons_self
      have htw_nz : tw ≠ 0 := by
        intro hz; subst hz
        have hf0_z : f0 = 0 := htw_nat.symm
        have hss : scratchStart = 0xb0000000 := rfl
        have h1 := huAR.2.2.2.1
        have h2 := huAR.2.2.2.2.1
        have h3 := hinv_f0.2.1.1
        omega
      have hcond1 : @evalHOLFinite 64 F _ u (fun a => Classical.propDecidable (u.memaddrs a))
          fillStackCond = some (.val (.word 1)) := by
        rw [evalHOLFinite_eq_toExact]
        have hcmp : @evalHOLExact 64 F _ u.toExact (fun a => Classical.propDecidable (u.memaddrs a))
            fillStackCond = some (.val (.word (if tw ≠ 0 then 1 else 0))) := by
          simp [fillStackCond, evalHOLExact, hul_top, Compiler.Encoders.Asm.wordCmpHOL]
        rw [hcmp, if_pos htw_nz]
      rw [evaluateHOLFiniteState_while_fixClockRewrite] at huor ⊢
      rw [hcond1] at huor ⊢; dsimp only at huor ⊢
      rw [if_pos (by decide : (1 : BitVec 64) ≠ 0)] at huor ⊢
      have hnt := none_or_resumes_not_timeOut huor
      by_cases hcz : u.clock = 0
      · rw [if_pos hcz] at hnt; exact absurd rfl hnt
      · rw [if_neg hcz] at huor hnt ⊢
        set u0 := decClockHOLFinite u
        have hcle := evaluateHOLFiniteState_clock_le u0 fillStackBody
        have hor_body : (evaluateHOLFiniteState u0 fillStackBody).1 = none ∨
            Resumes (evaluateHOLFiniteState u0 fillStackBody).1 := by
          rcases hbev : evaluateHOLFiniteState u0 fillStackBody with ⟨rb, mid⟩
          rw [hbev] at huor; dsimp only at huor ⊢
          cases rb with
          | none => exact Or.inl rfl
          | some rb' =>
            have hnbc := evaluate_noBCProg fillStackBody rfl u0 (by rw [hbev])
            cases rb' with
            | «break» => exact absurd rfl hnbc.1
            | «continue» => exact absurd rfl hnbc.2
            | _ => exact huor
        have hrefl_u0 : HeapByteEff u u0
            (nodeCacheIvls Nd ++ keccakBufIvls u ++ [freeGapTo sp0 u])
            ["heap_ptr", "scratch_ptr"] :=
          (HeapByteEff.refl huAR _ _).locals_clock u0.locals u0.clock
        have hu0_AR : ArenaReady u0 := hrefl_u0.arena
        have hu0_N : NodeHeap u0 Nd :=
          (nodeHeap_of_heapByteEff_disj huAR huN ((HeapByteEff.refl huAR [] []).locals_clock u0.locals u0.clock)
            (fun _ h => by simp at h)).1
        have hu0_vs : NodeValuesSafe sp0 u0 Nd :=
          nodeValuesSafe_of_heapByteEff (extra := []) huAR huN
            ((HeapByteEff.refl huAR (nodeCacheIvls Nd ++ keccakBufIvls u ++ []) []).locals_clock u0.locals u0.clock)
            rfl (fun _ h => by simp at h) hukc_disj huvs
        have hkc_lt_hl_u : ∀ iv ∈ keccakBufIvls u, 0 < iv.2 → iv.1 + iv.2 ≤ scratchStart ∨ sp0 ≤ iv.1 := by
          intro iv hiv hp; exact (hukc_hp iv hiv hp).imp (fun h => h.trans huAR.2.2.1) id
        have hufs_u0 : FillStack sp0 node0 Nd u0 tw (tw.toNat :: rest) := by
          obtain ⟨hpw_u, hl_u, hi_u, _⟩ := hufs
          rw [htw_nat]
          refine ⟨hpw_u, fillLinks_congr (s := u) (post := u0) (fun _ _ => rfl) (fun _ _ => rfl) hl_u, ?_, htw_nat⟩
