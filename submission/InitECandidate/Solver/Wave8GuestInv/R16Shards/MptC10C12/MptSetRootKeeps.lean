theorem nodeHeapValuePtrOK_of_empty_heapByteEff {F : Type}
    {s post : PanSemStateFiniteExact 64 F} {Nd : List Nat} {gw : List String}
    (hAs : ArenaReady s) (hN : NodeHeap s Nd)
    (heff : HeapByteEff s post [] gw)
    (hsp_eq : globN post "scratch_ptr" = globN s "scratch_ptr")
    (hkc_eq : keccakBufIvls post = keccakBufIvls s)
    (hvs : NodeHeapValuePtrOK s Nd) :
    NodeHeap post Nd ∧ nodeExtents post Nd = nodeExtents s Nd ∧ NodeHeapValuePtrOK post Nd := by
  obtain ⟨hN_post, hext_post⟩ := nodeHeap_of_heapByteEff_disj hAs hN heff
    (fun _ h => by simp at h)
  have h264 : heapLimit ≤ 2 ^ 64 := by decide
  have hw_all : ∀ n ∈ Nd, ∀ off : Nat, off % 8 = 0 →
      off + 8 ≤ nodeSize (memW s n) →
      memW post (n + off) = memW s (n + off) := by
    intro n hn off hoff8 hoff_lt
    obtain ⟨_, hal_n, hin_n, hw_n, _⟩ := hN.1 n hn
    have hn8 : n % 8 = 0 := hw_n.1
    have hal_off : Allocated s (n + off, 8) := by
      rcases hal_n with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact Or.inl ⟨by dsimp [nodeIvl] at h1; omega, by dsimp [nodeIvl] at h2; omega⟩
      · exact Or.inr ⟨by dsimp [nodeIvl] at h1; omega, by dsimp [nodeIvl] at h2; omega⟩
    have ha_lt : n + off < 2 ^ 64 := by have := hin_n.2; dsimp [nodeIvl] at this; omega
    exact memW_eq_of_heapByteEff_disj hAs heff (by omega) hal_off ha_lt
      (fun _ h => by simp at h)
  have hfg_eq : freeGapTo (globN post "scratch_ptr") post = freeGapTo (globN s "scratch_ptr") s := by
    simp [freeGapTo, heff.fp_eq, hsp_eq]
  have hhf_sub : ∀ x, InIvl x (heapFree post) → InIvl x (heapFree s) := by
    intro x ⟨h1, h2⟩
    have := heff.hp_le
    unfold heapFree at h1 h2 ⊢
    dsimp only at h1 h2 ⊢
    exact ⟨by omega, by omega⟩
  refine ⟨hN_post, hext_post, fun n hn => ?_⟩
  obtain ⟨h1_s, h3_s⟩ := hvs n hn
  have h0_eq : memW post n = memW s n := by
    have hsz := (R16Shards.nodeSize_bounds (memW s n)).1
    simpa using hw_all n hn 0 (by simp) (by omega)
  refine ⟨fun hk1 hvl1 hdom => ?_, fun hk3 hvl1 hdom => ?_⟩
  · rw [h0_eq] at hk1
    have h48_eq : memW post (n + 48) = memW s (n + 48) :=
      hw_all n hn 48 (by decide) (by rw [hk1]; decide)
    have h56_eq : memW post (n + 56) = memW s (n + 56) :=
      hw_all n hn 56 (by decide) (by rw [hk1]; decide)
    rw [h48_eq] at hdom ⊢
    rw [h56_eq] at hvl1
    obtain ⟨hc, hkc, hfg, hhf⟩ := h1_s hk1 hvl1 hdom
    exact ⟨hc, hkc_eq ▸ hkc, hfg_eq ▸ hfg, fun h => hhf (hhf_sub _ h)⟩
  · rw [h0_eq] at hk3
    have h160_eq : memW post (n + 160) = memW s (n + 160) :=
      hw_all n hn 160 (by decide) (by rw [hk3]; decide)
    have h168_eq : memW post (n + 168) = memW s (n + 168) :=
      hw_all n hn 168 (by decide) (by rw [hk3]; decide)
    rw [h160_eq] at hdom ⊢
    rw [h168_eq] at hvl1
    obtain ⟨hc, hkc, hfg, hhf⟩ := h3_s hk3 hvl1 hdom
    exact ⟨hc, hkc_eq ▸ hkc, hfg_eq ▸ hfg, fun h => hhf (hhf_sub _ h)⟩

theorem mpt_new_preserves_nodeHeapValuePtrOK {F : Type}
