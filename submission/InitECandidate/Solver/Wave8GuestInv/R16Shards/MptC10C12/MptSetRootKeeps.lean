    obtain ⟨_, hep_vlen⟩ := R16Shards.lookup_param_exact R16Shards.lookup_node_new_leaf hel_code
      [(ofString "nib", .one), (ofString "nlen", .one), (ofString "vptr", .one)] "vlen" .one []
