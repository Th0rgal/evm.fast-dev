    (hor : (evaluateHOLFiniteState s fillStackBody).1 = none ∨
      Resumes (evaluateHOLFiniteState s fillStackBody).1) :
    let out := evaluateHOLFiniteState s fillStackBody
    (∃ eid ev,
      eid ≠ ofString "TrapErr" ∧
      out.1 = some (.exception eid ev) ∧
      HeapByteEff s out.2
        (nodeCacheIvls Nd ++ keccakBufIvls s ++ [(globN s "scratch_ptr", sp0 - globN s "scratch_ptr")])
        ["heap_ptr", "scratch_ptr"] ∧
      globN out.2 "scratch_ptr" ≤ globN s "scratch_ptr" ∧
      NodeHeap out.2 Nd ∧
      nodeExtents out.2 Nd = nodeExtents s Nd ∧
      keccakBufIvls out.2 = keccakBufIvls s ∧
      NodeValuesSafe sp0 out.2 Nd) ∨
    (∃ (topw' : BitVec 64) (fs' : List Nat),
      out.1 = none ∧
      out.2.code = originalRuntimeCode ∧
      HeapByteEff s out.2
        (nodeCacheIvls Nd ++ keccakBufIvls s ++ [(globN s "scratch_ptr", sp0 - globN s "scratch_ptr")])
