private theorem eval_call__node_rlp_begin_cbuf_ge_hp {F : Type}
    (sp0 : Nat) (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
    (frExp nodeExp : ExpHOL 64) (frw nodew : BitVec 64)
    (hc : s.code = originalRuntimeCode) (hAR : ArenaReady s) (hN : NodeHeap s Nd)
    (hvs : NodeValuesSafe sp0 s Nd) (hsp_le : globN s "scratch_ptr" ≤ sp0)
    (hfr_ev : @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) frExp =
      some (.val (.word frw)))
    (hnode_ev : @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) nodeExp =
      some (.val (.word nodew)))
    (hfr_in : Inside (frw.toNat, 48) (globN s "scratch_ptr") scratchEnd)
    (hfr_W : WordsOK s (frw.toNat, 48))
    (hfr_vp : memW s nodew.toNat = 1 → memW s (nodew.toNat + 56) = 1 →
      ordinaryDomain (panByteAlignHOL (BitVec.ofNat 64 (memW s (nodew.toNat + 48)))) →
      ¬ InIvl (memW s (nodew.toNat + 48)) (frw.toNat + 24, 24))
    (hnode_in : nodew.toNat ∈ Nd)
    (hk12 : memW s nodew.toNat = 1 ∨ memW s nodew.toNat = 2)
    (hfr8_eq : memW s (frw.toNat + 8) = nodew.toNat)
    (hor : (evaluateHOLFiniteState s (.call (some (none, none)) (ofString "_node_rlp_begin") [frExp, nodeExp])).1 = none ∨
      Resumes (evaluateHOLFiniteState s (.call (some (none, none)) (ofString "_node_rlp_begin") [frExp, nodeExp])).1) :
    globN s "heap_ptr" ≤
      memW (evaluateHOLFiniteState s (.call (some (none, none)) (ofString "_node_rlp_begin") [frExp, nodeExp])).2
        (frw.toNat + 24) := by
  obtain ⟨values, body, callee, retShape, _, hargs, hl, hbr⟩ := call_void_flow_or_exn_sc hor
  have hvals : values = [.val (.word frw), .val (.word nodew)] := by
    rw [evalListHOLFinite_eq_toExact] at hargs
    simpa [evalListHOLExact, hfr_ev, hnode_ev] using hargs.symm
  subst hvals
  have hlk := pan_two_word_lookup s.code.lookup (ofString "_node_rlp_begin")
    (ofString "fr") (ofString "node")
    (sourceFnBody Guest.Software.guestFn__node_rlp_begin) frw nodew
    (by decide) (by rw [hc]; exact lookup__node_rlp_begin_sc)
  rw [hlk] at hl
  obtain ⟨rfl, rfl, rfl⟩ := Option.some.inj hl.symm
  set cmap := (HolFiniteMapExact.empty.update (ofString "fr", ValueHOL.val (.word frw))).update
    (ofString "node", ValueHOL.val (.word nodew))
  set ent := callEntryStateHOLFinite s cmap
  have hent_fr : ent.locals.lookup (ofString "fr") = some (.val (.word frw)) := by
    simp [ent, cmap, callEntryStateHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
      show ofString "node" ≠ ofString "fr" by decide]
  have hent_node : ent.locals.lookup (ofString "node") = some (.val (.word nodew)) := by
    simp [ent, cmap, callEntryStateHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
  have hent_AR : ArenaReady ent := localsFree_arenaReady s _ _ hAR
  have hent_c : ent.code = originalRuntimeCode := hc
  have hres_ent : Resumes (evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn__node_rlp_begin)).1 := by
    rcases hbr with ⟨eid, ev, hbe, hne, _⟩ | ⟨rv, post, hret, _, _⟩
    · exact Or.inr ⟨eid, ev, congrArg Prod.fst hbe, hne⟩
    · exact Or.inl ⟨rv, congrArg Prod.fst hret⟩
  have hk1 : 1 ≤ memW ent nodew.toNat := by change 1 ≤ memW s nodew.toNat; rcases hk12 with h | h <;> omega
  obtain ⟨hret_ent, _, _, _, _, _, _, _, _, _⟩ :=
    eval__node_rlp_begin_resumes sp0 ent Nd frw nodew hent_c hent_AR hN hvs hsp_le
      hent_fr hent_node hfr_in hfr_W hfr_vp hnode_in hk1 hfr8_eq hres_ent
  have hcb_ge := eval__node_rlp_begin_cbuf_ge_hp sp0 ent Nd frw nodew hent_c hent_AR hN hvs hsp_le
    hent_fr hent_node hfr_in hfr_W hfr_vp hnode_in hk12 hfr8_eq hres_ent
  rcases hbr with ⟨eid, ev, hbe, _, _⟩ | ⟨rv, sc, hrun, _, hcall_eq⟩
  · rw [congrArg Prod.fst hbe] at hret_ent; cases hret_ent
  · rw [hrun] at hcb_ge
    rw [hcall_eq]
    exact hcb_ge

private def fillStackCond : ExpHOL 64 :=
  .cmp .notEqual (.var .local (ofString "top")) (.const 0)

private def fillStackFindProg : ProgHOL 64 :=
  .ite (.cmp .equal (.var .local (ofString "k")) (.const 2))
    (.ite (.cmp .equal (.load .one (.op .add [.var .local (ofString "top"), .const 16])) (.const 0))
      (.seq
        (.store (.op .add [.var .local (ofString "top"), .const 16]) (.const 1))
        (.seq
          (.assign .local (ofString "child") (.load .one (.op .add [.var .local (ofString "nd"), .const 48])))
          (.call (some (some (.local, ofString "found"), none)) (ofString "_node_needs_rlp")
            [.var .local (ofString "child")])))
      .skip)
    (.ite (.cmp .equal (.var .local (ofString "k")) (.const 3))
      (.dec (ofString "i") .one (.load .one (.op .add [.var .local (ofString "top"), .const 16]))
        (.seq
          (.while fillBranchCond fillBranchBody)
          (.store (.op .add [.var .local (ofString "top"), .const 16]) (.var .local (ofString "i")))))
      .skip)

private def fillStackPushPopProg : ProgHOL 64 :=
  .ite (.cmp .notEqual (.var .local (ofString "found")) (.const 0))
    (.decCall (ofString "cf") .one (ofString "scratch_alloc") [.const 48]
      (.seq
        (.store (.op .add [.var .local (ofString "cf"), .const 0]) (.var .local (ofString "top")))
        (.seq
          (.store (.op .add [.var .local (ofString "cf"), .const 8]) (.var .local (ofString "child")))
          (.seq
            (.store (.op .add [.var .local (ofString "cf"), .const 16]) (.const 0))
            (.seq
              (.call (some (none, none)) (ofString "_node_rlp_begin")
                [.var .local (ofString "cf"), .var .local (ofString "child")])
              (.assign .local (ofString "top") (.var .local (ofString "cf"))))))))
    (.seq
      (.call (some (none, none)) (ofString "_node_rlp_finish")
        [.var .local (ofString "top"), .var .local (ofString "nd")])
      (.assign .local (ofString "top")
        (.load .one (.op .add [.var .local (ofString "top"), .const 0]))))

private def fillStackBody : ProgHOL 64 :=
  .dec (ofString "nd") .one (.load .one (.op .add [.var .local (ofString "top"), .const 8]))
    (.dec (ofString "k") .one (.load .one (.op .add [.var .local (ofString "nd"), .const 0]))
      (.dec (ofString "child") .one (.const 0)
        (.dec (ofString "found") .one (.const 0)
          (.seq fillStackFindProg fillStackPushPopProg))))

private theorem fillFrameInv_self_of_store_16 {F : Type}
    {sp0 : Nat} {s post : PanSemStateFiniteExact 64 F} {Nd : List Nat} {f : Nat}
    (hAs : ArenaReady s) (hN : NodeHeap s Nd)
    (heff : HeapByteEff s post [(f + 16, 8)] [])
    (hsp_le : globN s "scratch_ptr" ≤ sp0)
    (hsp0_hi : sp0 ≤ scratchEnd)
    (hvs : NodeValuesSafe sp0 s Nd)
    (hm8_eq : memW post (f + 8) = memW s (f + 8))
    (hm16_le' : memW post (f + 16) ≤ 16)
    (hinv : FillFrameInv sp0 Nd s f) :
    FillFrameInv sp0 Nd post f := by
  obtain ⟨hf8, hin_f, hw_f, hnd_in, hk1, _, hrf, hcb_disj_s⟩ := hinv
  have hhl_val : heapLimit = 0xb0000000 := rfl
  have hsc_val : scratchStart = 0xb0000000 := rfl
  have hse_lt : scratchEnd < 2 ^ 64 := by decide
  have hfp_lo := hAs.2.2.2.1
  have hsp_lo := hAs.2.2.2.2.1
  have hf_lo : scratchStart ≤ f := by dsimp [Inside] at hin_f; omega
  have hf_hi : f + 48 ≤ scratchEnd := by dsimp [Inside] at hin_f; omega
  have hkc_eq : keccakBufIvls post = keccakBufIvls s := by
    have hkp : globN post "keccak_pad" = globN s "keccak_pad" := by
      unfold globN; rw [← heff.globals (ofString "keccak_pad") (by decide)]
    have hks : globN post "keccak_st" = globN s "keccak_st" := by
      unfold globN; rw [← heff.globals (ofString "keccak_st") (by decide)]
    simp [keccakBufIvls, bufferRegion, hkp, hks]
  have hsp_post : globN post "scratch_ptr" = globN s "scratch_ptr" := by
    unfold globN; rw [← heff.globals (ofString "scratch_ptr") (by decide)]
  set nd := memW s (f + 8)
  obtain ⟨_, hal_nd, hin_nd, hw_nd, _⟩ := hN.1 nd hnd_in
  have hsz_nd := nodeSize_ge32 (memW s nd)
  have hnd_lt : nd + nodeSize (memW s nd) ≤ heapLimit := hin_nd.2
  have hnd8 : nd % 8 = 0 := hw_nd.1
  have hnd_off : ∀ off, off % 8 = 0 → off + 8 ≤ nodeSize (memW s nd) → memW post (nd + off) = memW s (nd + off) := by
    intro off hoff8 hoff_lt
    have hal_off : Allocated s (nd + off, 8) := by
      rcases hal_nd with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact Or.inl ⟨by dsimp [nodeIvl] at h1; omega, by dsimp [nodeIvl] at h2; omega⟩
      · exact Or.inr ⟨by dsimp [nodeIvl] at h1; omega, by dsimp [nodeIvl] at h2; omega⟩
    apply memW_eq_of_heapByteEff_disj hAs heff (by omega) hal_off (by omega)
    intro iv hiv _
    simp at hiv; subst hiv
    exact Or.inr (Or.inr (Or.inl (by dsimp; omega)))
  have hnd_kind : memW post nd = memW s nd := by simpa using hnd_off 0 rfl (by omega)
  have hal_f_off : ∀ off, off + 8 ≤ 48 → Allocated s (f + off, 8) :=
    fun off hoff => Or.inr ⟨by dsimp [Inside] at hin_f ⊢; omega, by dsimp [Inside] at hin_f ⊢; omega⟩
  have hm24_eq : memW post (f + 24) = memW s (f + 24) :=
    memW_eq_of_heapByteEff_disj hAs heff (by omega) (hal_f_off 24 (by decide)) (by omega)
      (fun iv hiv _ => by simp at hiv; subst hiv; exact Or.inr (Or.inr (Or.inr (by dsimp; omega))))
  have hm32_eq : memW post (f + 32) = memW s (f + 32) :=
    memW_eq_of_heapByteEff_disj hAs heff (by omega) (hal_f_off 32 (by decide)) (by omega)
      (fun iv hiv _ => by simp at hiv; subst hiv; exact Or.inr (Or.inr (Or.inr (by dsimp; omega))))
  have hm40_eq : memW post (f + 40) = memW s (f + 40) :=
    memW_eq_of_heapByteEff_disj hAs heff (by omega) (hal_f_off 40 (by decide)) (by omega)
      (fun iv hiv _ => by simp at hiv; subst hiv; exact Or.inr (Or.inr (Or.inr (by dsimp; omega))))
  have hrf_post : RlpFrameExact post f nd := by
    refine ⟨?_, ?_⟩
    · intro hk3; rw [hm40_eq]; exact hrf.1 (hnd_kind ▸ hk3)
    · intro hk12
      have hk12_s : memW s nd = 1 ∨ memW s nd = 2 := hnd_kind ▸ hk12
      obtain ⟨hcl1, hcl2, hcb_lo, hcb_hi, hk2_eq, hk1_eq⟩ := hrf.2 hk12_s
      have hhp_s : globN s "heap_ptr" ≤ heapLimit := hAs.2.2.1
      have hcb_enc : rlpEncBytesLen post (memW s (f + 24)) (memW s (f + 32)) =
          rlpEncBytesLen s (memW s (f + 24)) (memW s (f + 32)) := by
        apply rlpEncBytesLen_congr_of_heapByteEff hAs heff _ _ (by omega)
        intro _ _
        have hal_cb1 : Allocated s (memW s (f + 24), 1) :=
          Or.inl ⟨hcb_lo, by dsimp [Inside]; omega⟩
        exact ⟨fun iv hiv _ hin => by
            simp at hiv; subst hiv
            dsimp [InIvl] at hin; omega,
          fun hin => by
            have hd := P3MptSet.disj_allocated_freeGap hAs.2 hal_cb1
            dsimp [Disj, InIvl, freeGap] at hd hin
            rcases hd with h0 | h0 | hd1 | hd2 <;> omega,
          fun hin => by
            have hd := P3MptSet.disj_allocated_heapFree hAs.2 hal_cb1
            dsimp [Disj, InIvl, heapFree] at hd hin
            rcases hd with h0 | h0 | hd1 | hd2 <;> omega⟩
      rw [hm24_eq, hm32_eq, hm40_eq]
      refine ⟨hcl1, hcl2, hcb_lo, le_trans hcb_hi heff.hp_le, ?_, ?_⟩
      · intro hk2; rw [hcb_enc]; exact hk2_eq (hnd_kind ▸ hk2)
      · intro hk1_p
        have hk1_s : memW s nd = 1 := hnd_kind ▸ hk1_p
        have hsz1 : nodeSize (memW s nd) = 64 := by simp [nodeSize, hk1_s]
        have h48 : memW post (nd + 48) = memW s (nd + 48) := hnd_off 48 (by decide) (by omega)
        have h56 : memW post (nd + 56) = memW s (nd + 56) := hnd_off 56 (by decide) (by omega)
        rw [h48, h56, hcb_enc]
        have hv_enc : rlpEncBytesLen post (memW s (nd + 48)) (memW s (nd + 56)) =
            rlpEncBytesLen s (memW s (nd + 48)) (memW s (nd + 56)) := by
          have hvp_lt : memW s (nd + 48) < 2 ^ 64 := by
            unfold memW; cases s.memory (BitVec.ofNat 64 (nd + 48)) with | word cell => exact cell.isLt
          by_cases hv1 : memW s (nd + 56) = 1
          · apply rlpEncBytesLen_congr_of_heapByteEff hAs heff _ _ hvp_lt
            intro _ hdom
            obtain ⟨_, _, hfg_no, hhf_no⟩ := (hvs nd hnd_in).1 hk1_s hv1 hdom
            exact ⟨fun iv hiv _ hin => by
                simp at hiv; subst hiv
                apply hfg_no
                dsimp [InIvl, freeGapTo, Inside] at hin hin_f ⊢; omega,
              fun hin => by
                apply hfg_no
                dsimp [InIvl, freeGap, freeGapTo] at hin ⊢; omega,
              hhf_no⟩
          · unfold rlpEncBytesLen; simp only [hv1, ↓reduceIte]
        rw [hv_enc]; exact hk1_eq hk1_s
  have hw_f_post : WordsOK post (f, 48) :=
    P3MptSet.wordsOK_transfer hAs.1 heff.arena.1 hw_f
  refine ⟨hf8, ⟨by rw [hsp_post]; exact hin_f.1, hin_f.2⟩, hw_f_post, ?_, ?_, hm16_le', ?_, ?_⟩
  · rw [hm8_eq]; exact hnd_in
  · rw [hm8_eq, hnd_kind]; exact hk1
  · rw [hm8_eq]; exact hrf_post
  · rw [hm8_eq, hnd_kind, hm24_eq, hm32_eq, hkc_eq]; exact hcb_disj_s

private theorem fillStack_after_store_16 {F : Type}
    {sp0 node0 : Nat} {s post : PanSemStateFiniteExact 64 F} {Nd : List Nat}
    {f : Nat} {rest : List Nat}
    (hAs : ArenaReady s) (hN : NodeHeap s Nd)
    (heff : HeapByteEff s post [(f + 16, 8)] [])
    (hsp_le : globN s "scratch_ptr" ≤ sp0)
    (hsp0_hi : sp0 ≤ scratchEnd)
    (hvs : NodeValuesSafe sp0 s Nd)
    (hkc_disj : ∀ o ∈ nodeExtents s Nd,
      Disj (bufferRegion s ("keccak_pad", 136)) o ∧
      Disj (bufferRegion s ("keccak_st", 200)) o)
    (hkc_lt_hl : ∀ iv ∈ keccakBufIvls s, 0 < iv.2 → iv.1 + iv.2 ≤ scratchStart ∨ sp0 ≤ iv.1)
    (hm16_le' : memW post (f + 16) ≤ 16)
    (hpw : (f :: rest).Pairwise (fun f1 f2 => Disj (f1, 48) (f2, 48)))
    (hlinks : FillLinks node0 s (f :: rest))
    (hinvs : ∀ g ∈ f :: rest, FillFrameInv sp0 Nd s g) :
    NodeHeap post Nd ∧
    nodeExtents post Nd = nodeExtents s Nd ∧
    keccakBufIvls post = keccakBufIvls s ∧
    NodeValuesSafe sp0 post Nd ∧
    FillLinks node0 post (f :: rest) ∧
    (∀ g ∈ f :: rest, FillFrameInv sp0 Nd post g) := by
  have hhl_val : heapLimit = 0xb0000000 := rfl
  have hsc_val : scratchStart = 0xb0000000 := rfl
  have hse_lt : scratchEnd < 2 ^ 64 := by decide
  have hin_f := (hinvs f List.mem_cons_self).2.1
  have hf8 := (hinvs f List.mem_cons_self).1
  have hf_lo : scratchStart ≤ f := by
    have := hAs.2.2.2.1; have := hAs.2.2.2.2.1; dsimp [Inside] at hin_f; omega
  have hf_hi : f + 48 ≤ scratchEnd := by dsimp [Inside] at hin_f; omega
  have hextra_disj_ext : ∀ o ∈ nodeExtents s Nd, Disj (f + 16, 8) o := by
    intro o ho
    obtain ⟨m, hm, ho_m⟩ := List.mem_flatMap.1 ho
    obtain ⟨_, _, hin_m, _, _, _, hkey_m, _⟩ := hN.1 m hm
    simp only [List.mem_cons, List.not_mem_nil, or_false] at ho_m
    rcases ho_m with rfl | rfl
    · dsimp [nodeIvl, Inside] at hin_m; exact Or.inr (Or.inr (Or.inr (by dsimp [nodeIvl]; omega)))
    · dsimp [nodePath]
      split_ifs with hcond
      · rcases hkey_m hcond.1 with hz | ⟨_, _, hin_k, _⟩
        · exact absurd hz hcond.2
        · have := hin_k.2; dsimp at this; exact Or.inr (Or.inr (Or.inr (by dsimp; omega)))
      · exact Or.inr (Or.inl rfl)
  obtain ⟨hN_post, hext_post⟩ := nodeHeap_of_heapByteEff_disj hAs hN heff
    (fun iv hiv _ o ho => by simp at hiv; subst hiv; exact hextra_disj_ext o ho)
  have hkc_eq : keccakBufIvls post = keccakBufIvls s := by
    have hkp : globN post "keccak_pad" = globN s "keccak_pad" := by
      unfold globN; rw [← heff.globals (ofString "keccak_pad") (by decide)]
    have hks : globN post "keccak_st" = globN s "keccak_st" := by
      unfold globN; rw [← heff.globals (ofString "keccak_st") (by decide)]
    simp [keccakBufIvls, bufferRegion, hkp, hks]
