/-- Entry-level 1-byte value-pointer invariant for `Nd`: `NodeValuesSafe` specialized to
`sp0 = globN s "scratch_ptr"` (where `freeGapTo sp0 s = freeGap s`). -/
def NodeHeapValuePtrOK {F : Type} (s : PanSemStateFiniteExact 64 F) (Nd : List Nat) : Prop :=
  NodeValuesSafe (globN s "scratch_ptr") s Nd

/-- Sum of `nodeRefBytes s (memW s (nd + 32 + 8 * k))` for `0 ≤ k < m`. -/
def branchRefSum {F : Type} (s : PanSemStateFiniteExact 64 F) (nd : Nat) : Nat → Nat
  | 0 => 0
  | m + 1 => branchRefSum s nd m + nodeRefBytes s (memW s (nd + 32 + 8 * m))

theorem branchRefSum_bound {F : Type} (s : PanSemStateFiniteExact 64 F) (nd m : Nat) :
    branchRefSum s nd m ≤ 33 * m := by
  induction m with
  | zero => simp [branchRefSum]
  | succ m ih =>
    simp only [branchRefSum]
    have hb := nodeRefBytes_le33 s (memW s (nd + 32 + 8 * m))
    omega

theorem branchRefSum_congr {F : Type} {s post : PanSemStateFiniteExact 64 F}
    {Nd : List Nat} {nd : Nat}
    (hch_eq : ∀ k, k < 16 → memW post (nd + 32 + 8 * k) = memW s (nd + 32 + 8 * k))
    (hch_in : ∀ k, k < 16 → RootIn Nd (memW s (nd + 32 + 8 * k)))
    (href_eq : ∀ c, RootIn Nd c → nodeRefBytes post c = nodeRefBytes s c) :
    ∀ m, m ≤ 16 → branchRefSum post nd m = branchRefSum s nd m
  | 0, _ => rfl
  | m + 1, hm => by
    simp only [branchRefSum]
    rw [branchRefSum_congr hch_eq hch_in href_eq m (by omega),
      hch_eq m (by omega), href_eq _ (hch_in m (by omega))]

private theorem finish_signedLess_16 (wi : BitVec 64) (hlt : wi.toNat < 16) :
    Compiler.Encoders.Asm.holAsmSignedLess wi (BitVec.ofNat 64 16) = true := by
  unfold Compiler.Encoders.Asm.holAsmSignedLess
  have h1 : wi.toNat < 2 ^ 63 := by omega
  have h16 : (BitVec.ofNat 64 16).toNat = 16 := rfl
  have h16_lt : 16 < 2 ^ 63 := by decide
  simp only [show 64 - 1 = 63 from rfl, h16, if_pos h1, if_pos h16_lt, decide_eq_true_eq]
  exact hlt

private theorem assign_no_bc {F : Type} (u : PanSemStateFiniteExact 64 F)
    (vk : VarKind) (vn : MlS) (e : ExpHOL 64) {r0 : PanSemResultExact 64}
    (hr0 : (evaluateHOLFiniteState u (.assign vk vn e)).1 = some r0) :
    r0 ≠ .break ∧ r0 ≠ .continue := by
  rw [evaluateHOLFiniteState_assign] at hr0
  split at hr0
  · injection hr0 with h; subst h; exact ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
  · split at hr0
    · simp at hr0
    · injection hr0 with h; subst h; exact ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩

private theorem seq_no_bc {F : Type} (u : PanSemStateFiniteExact 64 F)
    (p1 p2 : ProgHOL 64)
    (h1 : ∀ r0, (evaluateHOLFiniteState u p1).1 = some r0 → r0 ≠ .break ∧ r0 ≠ .continue)
    (h2 : ∀ (u' : PanSemStateFiniteExact 64 F), ∀ r0, (evaluateHOLFiniteState u' p2).1 = some r0 → r0 ≠ .break ∧ r0 ≠ .continue)
    {r0 : PanSemResultExact 64}
    (hr0 : (evaluateHOLFiniteState u (.seq p1 p2)).1 = some r0) :
    r0 ≠ .break ∧ r0 ≠ .continue := by
  rw [evaluateHOLFiniteState_seq_line780] at hr0
  rcases he1 : evaluateHOLFiniteState u p1 with ⟨r1, u1⟩
  simp only [he1] at hr0
  cases r1 with
  | none => exact h2 u1 r0 hr0
  | some r1' =>
    injection hr0 with h; subst h
    exact h1 r1' (congrArg Prod.fst he1)

private theorem decCall_no_bc {F : Type} (u : PanSemStateFiniteExact 64 F)
    (vn : MlS) (sh : ShapeHOL) (fn : MlS) (args : List (ExpHOL 64)) (cont : ProgHOL 64)
    (hcont : ∀ (u' : PanSemStateFiniteExact 64 F), ∀ r0, (evaluateHOLFiniteState u' cont).1 = some r0 → r0 ≠ .break ∧ r0 ≠ .continue)
    {r0 : PanSemResultExact 64}
    (hr0 : (evaluateHOLFiniteState u (.decCall vn sh fn args cont)).1 = some r0) :
    r0 ≠ .break ∧ r0 ≠ .continue := by
  have hnot_err : PanSemResultExact.error ≠ (.break : PanSemResultExact 64) ∧
      PanSemResultExact.error ≠ (.continue : PanSemResultExact 64) := ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
  have hnot_to : PanSemResultExact.timeOut ≠ (.break : PanSemResultExact 64) ∧
      PanSemResultExact.timeOut ≠ (.continue : PanSemResultExact 64) := ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
  rw [evaluateHOLFiniteState_decCall_fixClockRewrite] at hr0
  rcases hargs : evalListHOLFinite u (h := fun a => Classical.propDecidable (u.memaddrs a)) args with _ | vs
  · rw [hargs] at hr0; injection hr0 with h; subst h; exact hnot_err
  · simp only [hargs] at hr0
    rcases hlk : lookupCodeHOLFinite u.code.lookup fn vs with _ | ⟨b', c', r'⟩
    · rw [hlk] at hr0; injection hr0 with h; subst h; exact hnot_err
    · simp only [hlk] at hr0
      by_cases hz : u.clock = 0
      · simp only [hz, ↓reduceIte] at hr0; injection hr0 with h; subst h; exact hnot_to
      · simp only [hz, ↓reduceIte] at hr0
        rcases hcal : evaluateHOLFiniteState (callEntryStateHOLFinite u c') b' with ⟨rc, st⟩
        simp only [hcal] at hr0
        cases rc with
        | none => injection hr0 with h; subst h; exact hnot_err
        | some rc' =>
          cases rc' with
          | «break» | «continue» | error => injection hr0 with h; subst h; exact hnot_err
          | timeOut => injection hr0 with h; subst h; exact hnot_to
          | finalFfi _ | exception _ _ => injection hr0 with h; subst h; exact ⟨by rintro ⟨⟩, by rintro ⟨⟩⟩
          | returned rv =>
            by_cases hsh : (shapeEqHOL (shapeOfHOLExact rv) sh && shapeEqHOL (shapeOfHOLExact rv) r') = true
            · simp only [hsh, ↓reduceIte] at hr0
              exact hcont (setVarHOLFinite vn rv { st with locals := u.locals }) r0 hr0
            · simp only [hsh, Bool.false_eq_true, ↓reduceIte] at hr0
              injection hr0 with h; subst h; exact hnot_err

private def finishPass1LoopBody : ProgHOL 64 :=
  .decCall (ofString "rl2") .one (ofString "node_ref_len")
    [.load .one (.op .add [.var .local (ofString "node"), .const (BitVec.ofNat 64 32),
      .panop .mul [.var .local (ofString "i"), .const (BitVec.ofNat 64 8)]])]
    (.seq
      (.assign .local (ofString "payload") (.op .add [.var .local (ofString "payload"), .var .local (ofString "rl2")]))
      (.assign .local (ofString "i") (.op .add [.var .local (ofString "i"), .const (BitVec.ofNat 64 1)])))

private def finishPass1Cond : ExpHOL 64 :=
  .cmp .less (.var .local (ofString "i")) (.const (BitVec.ofNat 64 16))

theorem eval_finishPass1_loop :
    ∀ (rem : Nat) {F : Type} (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
      (nodew iw payw : BitVec 64)
      (hc : s.code = originalRuntimeCode) (hN : NodeHeap s Nd)
      (hnode_in : nodew.toNat ∈ Nd) (hk3 : memW s nodew.toNat = 3)
      (hi_le : iw.toNat ≤ 16) (hrem : rem = 16 - iw.toNat)
      (hpay_eq : payw.toNat = branchRefSum s nodew.toNat iw.toNat)
      (hl_node : s.locals.lookup (ofString "node") = some (.val (.word nodew)))
      (hl_i : s.locals.lookup (ofString "i") = some (.val (.word iw)))
      (hl_pay : s.locals.lookup (ofString "payload") = some (.val (.word payw)))
      (hor : (evaluateHOLFiniteState s (.while finishPass1Cond finishPass1LoopBody)).1 = none ∨
        Resumes (evaluateHOLFiniteState s (.while finishPass1Cond finishPass1LoopBody)).1),
      (∃ eid ev,
        eid ≠ ofString "TrapErr" ∧
        (evaluateHOLFiniteState s (.while finishPass1Cond finishPass1LoopBody)).1 =
          some (.exception eid ev) ∧
        (evaluateHOLFiniteState s (.while finishPass1Cond finishPass1LoopBody)).2 =
          { s with locals := (evaluateHOLFiniteState s (.while finishPass1Cond finishPass1LoopBody)).2.locals,
                   clock := (evaluateHOLFiniteState s (.while finishPass1Cond finishPass1LoopBody)).2.clock }) ∨
      (∃ pay16 : BitVec 64,
        (evaluateHOLFiniteState s (.while finishPass1Cond finishPass1LoopBody)).1 = none ∧
        pay16.toNat = branchRefSum s nodew.toNat 16 ∧
        (evaluateHOLFiniteState s (.while finishPass1Cond finishPass1LoopBody)).2 =
          setVarHOLFinite (ofString "i") (.val (.word 16))
            (setVarHOLFinite (ofString "payload") (.val (.word pay16))
              { s with clock := (evaluateHOLFiniteState s (.while finishPass1Cond finishPass1LoopBody)).2.clock }))
  | 0, F, s, Nd, nodew, iw, payw, hc, hN, hnode_in, hk3, hi_le, hrem, hpay_eq, hl_node, hl_i, hl_pay, hor => by
    have hi16_nat : iw.toNat = 16 := by omega
    have hi16 : iw = 16 := BitVec.eq_of_toNat_eq hi16_nat
    subst hi16
    rw [evaluateHOLFiniteState_while_fixClockRewrite] at hor ⊢
    have hcond : @evalHOLFinite 64 F _ s (fun a => Classical.propDecidable (s.memaddrs a))
        finishPass1Cond = some (.val (.word 0)) := by
      rw [evalHOLFinite_eq_toExact]
      simp [finishPass1Cond, evalHOLExact, hl_i, Compiler.Encoders.Asm.wordCmpHOL,
        Compiler.Encoders.Asm.holAsmSignedLess]
    rw [hcond] at hor ⊢; dsimp only at hor ⊢
    rw [if_neg (by decide : ¬ (0 : BitVec 64) ≠ 0)]
    right
    refine ⟨payw, rfl, by simpa using hpay_eq, ?_⟩
    cases s; simp only [setVarHOLFinite]; congr 1
    apply HolFiniteMapExact.ext; funext x
    by_cases hx_i : x = ofString "i"
    · subst hx_i
      simpa [HolFiniteMapExact.lookup_update, FUPDATE] using hl_i
    · by_cases hx_p : x = ofString "payload"
      · subst hx_p
        simpa [HolFiniteMapExact.lookup_update, FUPDATE, Ne.symm hx_i] using hl_pay
      · simp [HolFiniteMapExact.lookup_update, FUPDATE, Ne.symm hx_i, Ne.symm hx_p]
  | rem + 1, F, s, Nd, nodew, iw, payw, hc, hN, hnode_in, hk3, hi_le, hrem, hpay_eq, hl_node, hl_i, hl_pay, hor => by
    have hi_lt : iw.toNat < 16 := by omega
    have h1_ne0 : (1 : BitVec 64) ≠ 0 := by decide
    rw [evaluateHOLFiniteState_while_fixClockRewrite] at hor ⊢
    have hcond : @evalHOLFinite 64 F _ s (fun a => Classical.propDecidable (s.memaddrs a))
        finishPass1Cond = some (.val (.word 1)) := by
      rw [evalHOLFinite_eq_toExact]
      simp [finishPass1Cond, evalHOLExact, hl_i, Compiler.Encoders.Asm.wordCmpHOL,
        finish_signedLess_16 iw hi_lt]
    rw [hcond] at hor ⊢; dsimp only at hor ⊢
    rw [if_pos h1_ne0] at hor ⊢
    by_cases hcz : s.clock = 0
    · rw [if_pos hcz] at hor
      rcases hor with hn | hr
      · simp at hn
      · rcases hr with ⟨_, hr⟩ | ⟨_, _, hr, _⟩
        · simp at hr
        · simp at hr
    · rw [if_neg hcz] at hor ⊢
      set s0 := decClockHOLFinite s
      have hs0_c : s0.code = originalRuntimeCode := hc
      have hs0_N : NodeHeap s0 Nd := hN
      have h264 : heapLimit ≤ 2 ^ 64 := by decide
      obtain ⟨_, _, hin_nd, hw_nd, _, hbr_nd, _⟩ := hN.1 nodew.toNat hnode_in
      have hsz3 : nodeSize (memW s nodew.toNat) = 176 := by simp [nodeSize, hk3]
      have hhi_nd : nodew.toNat + nodeSize (memW s nodew.toNat) ≤ 2 ^ 64 := by
        have := hin_nd.2; dsimp [nodeIvl] at this; omega
      have hmul_eq : (iw * 8).toNat = 8 * iw.toNat := by
        have h8 : (8 : BitVec 64).toNat = 8 := rfl
        rw [BitVec.toNat_mul, h8, Nat.mod_eq_of_lt (by omega), Nat.mul_comm]
      have hoff_bv : (32 : BitVec 64) + iw * 8 = BitVec.ofNat 64 (32 + 8 * iw.toNat) := by
        apply BitVec.eq_of_toNat_eq
        have h32 : (32 : BitVec 64).toNat = 32 := rfl
        rw [BitVec.toNat_add, h32, hmul_eq, BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
      have haddr_ev : @evalHOLExact 64 F _ s0.toExact (fun a => Classical.propDecidable (s0.memaddrs a))
          (.op .add [.var .local (ofString "node"), .const (BitVec.ofNat 64 32),
            .panop .mul [.var .local (ofString "i"), .const (BitVec.ofNat 64 8)]]) =
          some (.val (.word (nodew + BitVec.ofNat 64 (32 + 8 * iw.toNat)))) := by
        have hl_n0 : s0.locals.lookup (ofString "node") = some (.val (.word nodew)) := hl_node
        have hl_i0 : s0.locals.lookup (ofString "i") = some (.val (.word iw)) := hl_i
        rw [← hoff_bv]
        simp [evalHOLExact, evalListHOLExact, hl_n0, hl_i0, panOpHOL,
          wordOpHOL, wordOp, valueIsWord, valueWord, BitVec.add_assoc]
      obtain ⟨chw, hld_ch, hchw_nat⟩ := eval_load_memW_of_wordsOK (s := s0) (base := nodew)
        (off := 32 + 8 * iw.toNat) hw_nd (by omega) (by rw [hsz3]; omega) hhi_nd
        (e := .op .add [.var .local (ofString "node"), .const (BitVec.ofNat 64 32),
          .panop .mul [.var .local (ofString "i"), .const (BitVec.ofNat 64 8)]]) haddr_ev
      rw [← Nat.add_assoc] at hchw_nat
      have hch_in : RootIn Nd chw.toNat := by
        rw [hchw_nat]; exact hbr_nd hk3 iw.toNat hi_lt
      have hno_bc : ∀ r0, (evaluateHOLFiniteState s0 finishPass1LoopBody).1 = some r0 →
          r0 ≠ .break ∧ r0 ≠ .continue := by
        intro r0 hr0
        exact decCall_no_bc s0 _ _ _ _ _
          (fun u' r1 hr1 => seq_no_bc u' _ _
            (fun r2 hr2 => assign_no_bc u' _ _ _ hr2)
            (fun u'' r2 hr2 => assign_no_bc u'' _ _ _ hr2) hr1) hr0
      have hbody_or : (evaluateHOLFiniteState s0 finishPass1LoopBody).1 = none ∨
          Resumes (evaluateHOLFiniteState s0 finishPass1LoopBody).1 := by
        rcases hb : evaluateHOLFiniteState s0 finishPass1LoopBody with ⟨rb, sb⟩
        have hb1 : (evaluateHOLFiniteState s0 finishPass1LoopBody).1 = rb := congrArg Prod.fst hb
        rw [hb1] at hor
        cases rb with
        | none => exact Or.inl rfl
        | some rb' =>
          cases rb' with
          | «break» => exact False.elim ((hno_bc _ hb1).1 rfl)
          | «continue» => exact False.elim ((hno_bc _ hb1).2 rfl)
          | exception eid ev =>
            rcases hor with hn | ⟨_, hr⟩ | ⟨eid', ev', hr, hne⟩
            · simp at hn
            · simp at hr
            · injection hr with h; injection h with h1 h2; subst h1 h2
              exact Or.inr (Or.inr ⟨eid, ev, rfl, hne⟩)
          | returned rv => exact Or.inr (Or.inl ⟨rv, rfl⟩)
          | timeOut | finalFfi _ | error =>
            rcases hor with hn | ⟨_, hr⟩ | ⟨_, _, hr, _⟩
            · simp at hn
            · simp at hr
            · simp at hr
      rcases eval_decCall_node_ref_len_exact s0 Nd "rl2" _ chw
          (.seq
            (.assign .local (ofString "payload") (.op .add [.var .local (ofString "payload"), .var .local (ofString "rl2")]))
            (.assign .local (ofString "i") (.op .add [.var .local (ofString "i"), .const (BitVec.ofNat 64 1)])))
          hs0_c hs0_N hch_in hld_ch hbody_or with
        ⟨eid, ev, hne, hex_b, hst_b⟩ | ⟨rl2, mid, hrl2_eq, hmid_eq, hcont_or, hb_eq⟩
      · left
        have hex_b' : (evaluateHOLFiniteState s0 finishPass1LoopBody).1 = some (.exception eid ev) := hex_b
        have hst_b' : (evaluateHOLFiniteState s0 finishPass1LoopBody).2 =
            { s0 with locals := HolFiniteMapExact.empty,
                      clock := (evaluateHOLFiniteState s0 finishPass1LoopBody).2.clock } := hst_b
        rw [hex_b']
        refine ⟨eid, ev, hne, rfl, ?_⟩
        change (evaluateHOLFiniteState s0 finishPass1LoopBody).2 = _
        rw [hst_b']; cases s; rfl
      · -- Assign `payload := payload + rl2` and `i := i + 1` in `mid`:
        have hs0_pay : s0.locals.lookup (ofString "payload") = some (.val (.word payw)) := hl_pay
        have hs0_i : s0.locals.lookup (ofString "i") = some (.val (.word iw)) := hl_i
        have hmid_pay : mid.locals.lookup (ofString "payload") = some (.val (.word payw)) := by
          rw [hmid_eq]; simp [HolFiniteMapExact.lookup_update, FUPDATE, hs0_pay,
            show ofString "rl2" ≠ ofString "payload" by decide]
        have hmid_rl2 : mid.locals.lookup (ofString "rl2") = some (.val (.word rl2)) := by
          rw [hmid_eq]; simp [HolFiniteMapExact.lookup_update, FUPDATE]
        have hmid_i : mid.locals.lookup (ofString "i") = some (.val (.word iw)) := by
          rw [hmid_eq]; simp [HolFiniteMapExact.lookup_update, FUPDATE, hs0_i,
            show ofString "rl2" ≠ ofString "i" by decide]
        set mid2 := setVarHOLFinite (ofString "i") (.val (.word (iw + 1)))
          (setVarHOLFinite (ofString "payload") (.val (.word (payw + rl2))) mid)
        have hcont_ev : evaluateHOLFiniteState mid
            (.seq
              (.assign .local (ofString "payload") (.op .add [.var .local (ofString "payload"), .var .local (ofString "rl2")]))
              (.assign .local (ofString "i") (.op .add [.var .local (ofString "i"), .const (BitVec.ofNat 64 1)]))) =
            (none, mid2) := by
          rw [evaluateHOLFiniteState_seq_line780, evaluateHOLFiniteState_assign]
          have hadd0 : ∀ (x : RiscV.Word 64), x + 0 = x := BitVec.add_zero
          simp only [evalHOLExact, evalListHOLExact, hmid_pay, hmid_rl2, wordOpHOL, wordOp,
            valueIsWord, valueWord, List.all, List.map, Option.map, Bool.and_self, ↓reduceIte,
            List.foldr, hadd0, isValidValueHOLFinite, isValidValueHOLExact,
            lookupKvarHOLFinite, lookupKvarHOLExact, shapeOfHOLExact, shapeEqHOL,
            setKvarHOLFinite, setVarHOLFinite]
          rw [evaluateHOLFiniteState_assign]
          have hi_lk : (mid.locals.update (ofString "payload", ValueHOL.val (.word (payw + rl2)))).lookup (ofString "i") =
              some (.val (.word iw)) := by
            simp [HolFiniteMapExact.lookup_update, FUPDATE, hmid_i,
              show ofString "payload" ≠ ofString "i" by decide]
          have h1_64 : (1#64 : BitVec 64) = 1 := rfl
          simp only [evalHOLExact, evalListHOLExact, hi_lk, wordOpHOL, wordOp,
            valueIsWord, valueWord, List.all, List.map, Option.map, Bool.and_self, ↓reduceIte,
            List.foldr, hadd0, isValidValueHOLFinite, isValidValueHOLExact,
            lookupKvarHOLFinite, lookupKvarHOLExact, shapeOfHOLExact, shapeEqHOL,
            setKvarHOLFinite, setVarHOLFinite, mid2, h1_64]
        set s1 := setVarHOLFinite (ofString "i") (.val (.word (iw + 1)))
          (setVarHOLFinite (ofString "payload") (.val (.word (payw + rl2)))
            { s0 with clock := mid.clock })
        have hb_full : evaluateHOLFiniteState s0 finishPass1LoopBody = (none, s1) := by
          dsimp only [finishPass1LoopBody]
          rw [hb_eq, hcont_ev]
          dsimp only [mid2, s1, setVarHOLFinite]
          rw [hmid_eq]
          simp only
          congr 1; congr 1
          apply HolFiniteMapExact.ext; funext x
          rw [InitECandidate.Solver.PanRunBounded.resVarEq_lookup]
          by_cases hx_r : x = ofString "rl2"
          · subst hx_r
            simp [HolFiniteMapExact.lookup_update, FUPDATE,
              show ofString "i" ≠ ofString "rl2" by decide,
              show ofString "payload" ≠ ofString "rl2" by decide]
          · simp [hx_r, HolFiniteMapExact.lookup_update, FUPDATE, Ne.symm hx_r]
        rw [hb_full] at hor ⊢
        have hi1_nat : (iw + 1).toNat = iw.toNat + 1 := by
          have h1 : (1 : BitVec 64).toNat = 1 := rfl
          rw [BitVec.toNat_add, h1, Nat.mod_eq_of_lt (by omega)]
        have hrl2_le : rl2.toNat ≤ 33 := by
          rw [hrl2_eq]; exact nodeRefBytes_le33 s0 chw.toNat
        have hpay_le : payw.toNat ≤ 33 * iw.toNat := by
          rw [hpay_eq]; exact branchRefSum_bound s nodew.toNat iw.toNat
        have hs1_sum : branchRefSum s1 nodew.toNat (iw.toNat + 1) =
            branchRefSum s nodew.toNat iw.toNat + nodeRefBytes s (memW s (nodew.toNat + 32 + 8 * iw.toNat)) := by
          have hcongr := branchRefSum_congr (s := s) (post := s1) (Nd := Nd) (nd := nodew.toNat)
            (fun j _ => rfl)
            (fun j hj => hbr_nd hk3 j hj)
            (fun ch _ => rfl)
            (iw.toNat + 1) (by omega)
          rw [hcongr]; simp [branchRefSum]
        have hchw_s : chw.toNat = memW s (nodew.toNat + 32 + 8 * iw.toNat) := hchw_nat
        have hrl2_s : rl2.toNat = nodeRefBytes s chw.toNat := hrl2_eq
        have hpay1_nat : (payw + rl2).toNat = branchRefSum s1 nodew.toNat (iw + 1).toNat := by
          rw [BitVec.toNat_add, Nat.mod_eq_of_lt (by omega), hi1_nat, hs1_sum,
            hpay_eq, hrl2_s, hchw_s]
        have hs1_node : s1.locals.lookup (ofString "node") = some (.val (.word nodew)) := by
          have hs0_n : s0.locals.lookup (ofString "node") = some (.val (.word nodew)) := hl_node
          simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hs0_n,
            show ofString "i" ≠ ofString "node" by decide,
            show ofString "payload" ≠ ofString "node" by decide]
        have hs1_i : s1.locals.lookup (ofString "i") = some (.val (.word (iw + 1))) := by
          simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
        have hs1_pay : s1.locals.lookup (ofString "payload") = some (.val (.word (payw + rl2))) := by
          simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
            show ofString "i" ≠ ofString "payload" by decide]
        rcases eval_finishPass1_loop rem s1 Nd nodew (iw + 1) (payw + rl2)
            hc hN hnode_in hk3 (by omega) (by omega) hpay1_nat hs1_node hs1_i hs1_pay hor with
          ⟨eid, ev, hne, hex, hst⟩ | ⟨pay16, hnone, hpay16_eq, hst⟩
        · left
          refine ⟨eid, ev, hne, hex, ?_⟩
          rw [hst]; cases s; rfl
        · right
          have hpay16_s : pay16.toNat = branchRefSum s nodew.toNat 16 := by
            rw [hpay16_eq]
            exact branchRefSum_congr (s := s) (post := s1) (Nd := Nd) (nd := nodew.toNat)
              (fun j _ => rfl) (fun j hj => hbr_nd hk3 j hj) (fun ch _ => rfl) 16 (le_refl 16)
          refine ⟨pay16, hnone, hpay16_s, ?_⟩
          rw [hst]; cases s; simp only [s1, s0, setVarHOLFinite, decClockHOLFinite]
          congr 1
          apply HolFiniteMapExact.ext; funext x
          by_cases hx_i : x = ofString "i"
          · subst hx_i; simp [HolFiniteMapExact.lookup_update, FUPDATE]
          · by_cases hx_p : x = ofString "payload"
            · subst hx_p; simp [HolFiniteMapExact.lookup_update, FUPDATE, Ne.symm hx_i]
            · simp [HolFiniteMapExact.lookup_update, FUPDATE, Ne.symm hx_i, Ne.symm hx_p]

private theorem keccakBufIvls_eq_of_eff {F : Type} {s post : PanSemStateFiniteExact 64 F}
    {Rl : List Ivl} {gw : List String}
    (heff : HeapByteEff s post Rl gw)
    (hkp : ofString "keccak_pad" ∉ gw.map ofString)
    (hks : ofString "keccak_st" ∉ gw.map ofString) :
    keccakBufIvls post = keccakBufIvls s := by
  have h1 : globN post "keccak_pad" = globN s "keccak_pad" := by
    unfold globN; rw [← heff.globals (ofString "keccak_pad") hkp]
  have h2 : globN post "keccak_st" = globN s "keccak_st" := by
    unfold globN; rw [← heff.globals (ofString "keccak_st") hks]
  simp [keccakBufIvls, bufferRegion, h1, h2]

private def finishPass2LoopBody : ProgHOL 64 :=
  .decCall (ofString "w4") .one (ofString "node_write_ref")
    [.load .one (.op .add [.var .local (ofString "node"), .const (BitVec.ofNat 64 32),
      .panop .mul [.var .local (ofString "j"), .const (BitVec.ofNat 64 8)]]),
     .op .add [.var .local (ofString "buf"), .var .local (ofString "off")]]
    (.seq
      (.assign .local (ofString "off") (.op .add [.var .local (ofString "off"), .var .local (ofString "w4")]))
      (.assign .local (ofString "j") (.op .add [.var .local (ofString "j"), .const (BitVec.ofNat 64 1)])))

private def finishPass2Cond : ExpHOL 64 :=
  .cmp .less (.var .local (ofString "j")) (.const (BitVec.ofNat 64 16))

theorem eval_finishPass2_loop :
    ∀ (rem : Nat) {F : Type} (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
      (buf0 : Nat) (nodew bufw offw jw : BitVec 64) (hl0 totalLen : Nat) (gw : List String)
      (hc : s.code = originalRuntimeCode) (hAR : ArenaReady s) (hN : NodeHeap s Nd)
      (hkc_disj : ∀ o ∈ nodeExtents s Nd,
        Disj (bufferRegion s ("keccak_pad", 136)) o ∧
        Disj (bufferRegion s ("keccak_st", 200)) o)
      (hbuf_disj : ∀ o ∈ nodeExtents s Nd, Disj (buf0, totalLen) o)
      (hnode_in : nodew.toNat ∈ Nd) (hk3 : memW s nodew.toNat = 3)
      (hbuf_eq : bufw.toNat = buf0)
      (hbuf_fit : buf0 + totalLen ≤ heapLimit)
      (htot_ge : hl0 + branchRefSum s nodew.toNat 16 ≤ totalLen)
      (hj_le : jw.toNat ≤ 16) (hrem : rem = 16 - jw.toNat)
      (hoff_eq : offw.toNat = hl0 + branchRefSum s nodew.toNat jw.toNat)
      (hgw : "heap_ptr" ∈ gw)
