private theorem pan_one_word_lookup_any_sc
    (code : MlS → Option (List (MlS × ShapeHOL) × ProgHOL 64 × ShapeHOL))
    (name parameter : MlS) (body : ProgHOL 64) (rs : ShapeHOL) (amount : BitVec 64)
    (lookup : code name = some ([(parameter, .one)], body, rs)) :
    PanSemStateFiniteExact.lookupCodeHOLFinite code name [.val (.word amount)] =
      some (body, HolFiniteMapExact.empty.update (parameter, .val (.word amount)), rs) := by
  have raw : lookupCodeHOLExact code name [.val (.word amount)] =
      some (body, (fun key => if key = parameter then some (.val (.word amount)) else none), rs) := by
    simp [lookupCodeHOLExact, lookup, shapeOfHOLExact, shapeEqHOL]
  unfold PanSemStateFiniteExact.lookupCodeHOLFinite
  split
  · rename_i missing; rw [raw] at missing; cases missing
  · rename_i foundBody foundLocals foundShape found
    have equal := Option.some.inj (found.symm.trans raw)
    obtain ⟨rfl, rest⟩ := Prod.mk.inj equal
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj rest
    apply congrArg (fun locals => some (foundBody, locals, foundShape))
    apply HolFiniteMapExact.ext
    funext key
    by_cases same : key = parameter
    · subst same; simp [HolFiniteMapExact.lookup_update, FUPDATE, HolFiniteMapExact.empty, FEMPTY]
    · have different : parameter ≠ key := Ne.symm same
      simp [same, different, HolFiniteMapExact.lookup_update, FUPDATE, HolFiniteMapExact.empty, FEMPTY]

theorem eval_decCall_node_rlp_returned_step {F : Type}
    (s : PanSemStateFiniteExact 64 F) (Nd : List Nat) (lname : String)
    (nodeExp : ExpHOL 64) (nodew : BitVec 64) (cont : ProgHOL 64) (v : ValueHOL 64)
    (hc : s.code = originalRuntimeCode) (hAR : ArenaReady s) (hN : NodeHeap s Nd)
    (hvs : NodeHeapValuePtrOK s Nd)
    (hkc_disj : ∀ o ∈ nodeExtents s Nd,
      Disj (bufferRegion s ("keccak_pad", 136)) o ∧
      Disj (bufferRegion s ("keccak_st", 200)) o)
    (hkc_alloc : ∀ iv ∈ keccakBufIvls s, 0 < iv.2 →
      iv.1 + iv.2 ≤ globN s "heap_ptr" ∨ globN s "scratch_ptr" ≤ iv.1)
    (hnode_ev : @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) nodeExp =
      some (.val (.word nodew)))
    (hnode_in : nodew.toNat ∈ Nd)
    (hret : (evaluateHOLFiniteState s
      (.decCall (ofString lname) (.comb [.one, .one]) (ofString "node_rlp") [nodeExp] cont)).1 =
      some (.returned v)) :
    ∃ (rpw rlw : BitVec 64) (mid : PanSemStateFiniteExact 64 F),
      mid.code = originalRuntimeCode ∧
      mid.locals = s.locals.update (ofString lname, .rStruct [.val (.word rpw), .val (.word rlw)]) ∧
      HeapByteEff s mid (nodeCacheIvls Nd ++ keccakBufIvls s) ["heap_ptr", "scratch_ptr"] ∧
      globN mid "scratch_ptr" = globN s "scratch_ptr" ∧
      NodeHeap mid Nd ∧
      nodeExtents mid Nd = nodeExtents s Nd ∧
      keccakBufIvls mid = keccakBufIvls s ∧
      NodeHeapValuePtrOK mid Nd ∧
      (evaluateHOLFiniteState mid cont).1 = some (.returned v) ∧
      (evaluateHOLFiniteState s
        (.decCall (ofString lname) (.comb [.one, .one]) (ofString "node_rlp") [nodeExp] cont)).2 =
        { (evaluateHOLFiniteState mid cont).2 with
          locals := HolFiniteMapExact.resVarEq (evaluateHOLFiniteState mid cont).2.locals
            (ofString lname, s.locals.lookup (ofString lname)) } := by
  rw [evaluateHOLFiniteState_decCall_fixClockRewrite] at hret ⊢
  have hargs : evalListHOLFinite s (h := fun a => Classical.propDecidable (s.memaddrs a)) [nodeExp] =
      some [.val (.word nodew)] := by
    simp [evalListHOLFinite, evalListHOLExact, hnode_ev]
  have hl := pan_one_word_lookup_any_sc s.code.lookup (ofString "node_rlp") (ofString "node")
    (sourceFnBody Guest.Software.guestFn_node_rlp) (.comb [.one, .one]) nodew
    (by rw [hc]; exact lookup_node_rlp_sc)
