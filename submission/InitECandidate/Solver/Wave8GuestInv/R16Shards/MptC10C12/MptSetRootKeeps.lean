    have hs0_dom : ∀ k : Nat, k < 64 → k % 8 = 0 → s0.memaddrs (hp + BitVec.ofNat 64 k) := by
      intro k hk hk8
      rw [hs0_ma]; exact hdom_slot k hk hk8
    have step_store_const : ∀ (st : PanSemStateFiniteExact 64 F) (k c : Nat),
