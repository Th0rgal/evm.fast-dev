    (hlk_child : s.locals.lookup (ofString "child") = some (.val (.word wchild)))
    (hKey : KeyIn s Nd wnib.toNat wnlen.toNat)
    (hch : RootIn Nd wchild.toNat)
    (hProv : wnlen.toNat = 0 ∨
