    refine Or.inl ⟨eid, ev, hne, congrArg Prod.fst hfull, ?_⟩
    rw [hfull]; dsimp only [emptyLocalsHOLFinite]
    rw [hro]; cases s; rfl
  · have hvals : values = [.val (.word pw), .val (.word nw)] := by
