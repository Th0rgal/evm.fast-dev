    · rw [evaluateHOLFiniteState_assign]
      split
      · simp
      · split <;> simp
    · rw [evaluateHOLFiniteState_assign]
      split
      · simp
      · split <;> simp
  let p0 : ProgHOL 64 := .storeByte (.op .add [.var .local (ofString "dst"), .var .local (ofString "o")])
