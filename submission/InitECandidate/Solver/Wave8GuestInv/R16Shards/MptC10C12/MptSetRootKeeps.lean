  obtain ⟨cw, fw, hfind_none, hsf_c, heff_d4_sf, hsf_sp, hN_sf, hext_sf, hkc_sf, hvs_sf,
      hlinks_sf, hinvs_sf, hnd_eq_sf, hcw_kind_sf, hl_sf_top, hl_sf_nd, hl_sf_c, hl_sf_f, hl_sf_other⟩ :=
    eval_fillStackFindProg sp0 node0 d4 Nd topw ndw kw rest hc hrefl_d4.arena
      (nodeHeap_of_heapByteEff_disj hAR hN ((HeapByteEff.refl hAR [] []).locals_clock d4.locals d4.clock)
        (fun _ h => by simp at h)).1
      hsp_le hsp0_hi
      (nodeValuesSafe_of_heapByteEff (extra := []) hAR hN
        ((HeapByteEff.refl hAR (nodeCacheIvls Nd ++ keccakBufIvls s ++ []) []).locals_clock d4.locals d4.clock)
        rfl (fun _ h => by simp at h) hkc_disj hvs)
      hkc_disj hkc_lt_hl hpw
      (fillLinks_congr (s := s) (post := d4) (fun _ _ => rfl) (fun _ _ => rfl) hlinks)
      (fun g hg => (fillFrameInv_congr_of_heapByteEff (extra := []) hAR hN
        ((HeapByteEff.refl hAR _ []).locals_clock d4.locals d4.clock)
        rfl hsp_le hsp0_hi (hinvs g hg).2.1.1 hvs
        (fun _ _ _ _ he => by simp at he) (fun _ _ he => by simp at he)
        hkc_lt_hl (fun _ he => by simp at he) (fun _ _ _ _ _ _ => rfl) (hinvs g hg)).1)
      hnd_nat
      (by rw [hkw_nat, Nat.add_zero]; rfl) hl_d4_top hl_d4_nd hl_d4_k hl_d4_c hl_d4_f hor_find
  set sf := (evaluateHOLFiniteState d4 fillStackFindProg).2
  have hseq_sf : evaluateHOLFiniteState d4 (.seq fillStackFindProg fillStackPushPopProg) =
      evaluateHOLFiniteState sf fillStackPushPopProg := by
    rw [evaluateHOLFiniteState_seq_line780]
    have hp : evaluateHOLFiniteState d4 fillStackFindProg = (none, sf) := Prod.ext hfind_none rfl
    rw [hp]
  rw [hseq_sf] at hor_seq ⊢
  have heff_s_sf : HeapByteEff s sf
      (nodeCacheIvls Nd ++ keccakBufIvls s ++ [(globN s "scratch_ptr", sp0 - globN s "scratch_ptr")])
      ["heap_ptr", "scratch_ptr"] :=
    hrefl_d4.trans
      (heff_d4_sf.mono
        (fun i hi _ => by
          rcases List.mem_append.1 hi with h12 | h3
          · exact Or.inl ⟨i, List.mem_append_left _ h12, le_rfl, le_rfl⟩
          · simp at h3; subst h3
            exact Or.inl ⟨(globN s "scratch_ptr", sp0 - globN s "scratch_ptr"),
              List.mem_append_right _ (List.mem_singleton.2 rfl),
              by dsimp [Inside] at hin_top ⊢; omega,
              by dsimp [Inside] at hin_top ⊢; omega⟩)
        (fun _ h => h))
  have hsf_AR : ArenaReady sf := heff_d4_sf.arena
  have hkc_disj_sf : ∀ o ∈ nodeExtents sf Nd,
      Disj (bufferRegion sf ("keccak_pad", 136)) o ∧
      Disj (bufferRegion sf ("keccak_st", 200)) o := by
    have hkp : globN sf "keccak_pad" = globN s "keccak_pad" := by
      unfold globN; rw [← heff_s_sf.globals (ofString "keccak_pad") (by decide)]
    have hks : globN sf "keccak_st" = globN s "keccak_st" := by
      unfold globN; rw [← heff_s_sf.globals (ofString "keccak_st") (by decide)]
    rw [hext_sf]
    intro o ho; simp only [bufferRegion, hkp, hks]; exact hkc_disj o ho
  have hkc_lt_hp_sf : ∀ iv ∈ keccakBufIvls sf, 0 < iv.2 → iv.1 + iv.2 ≤ globN sf "heap_ptr" ∨ sp0 ≤ iv.1 := by
    rw [hkc_sf]
    intro iv hiv hpos
    exact (hkc_lt_hp iv hiv hpos).imp (fun h => h.trans heff_s_sf.hp_le) id
  rcases eval_fillStackPushPopProg sp0 node0 sf Nd topw ndw cw fw rest
      hsf_c hsf_AR hN_sf (by rw [hsf_sp]; exact hsp_le) hsp0_hi hvs_sf
      hkc_disj_sf hkc_lt_hp_sf hpw hlinks_sf hinvs_sf hnd_eq_sf hcw_kind_sf
      hl_sf_top hl_sf_nd hl_sf_c hl_sf_f hor_seq with
    ⟨eid, ev, hne, hexn, heff_exn, hsp_exn, hN_exn, hext_exn, hkc_exn, hvs_exn⟩ |
    ⟨topw', fs', hpp_none, hpp_c, heff_pp, hpp_push, hpp_pop, hN_pp, hext_pp, hkc_pp, hvs_pp,
      hfs_pp, hl_pp_top, hl_pp_other⟩
  · set se := (evaluateHOLFiniteState sf fillStackPushPopProg).2
    have hpe : evaluateHOLFiniteState sf fillStackPushPopProg = (some (.exception eid ev), se) :=
      Prod.ext hexn rfl
    rw [hpe]; dsimp only
    set locs_e :=
      HolFiniteMapExact.resVarEq
        (HolFiniteMapExact.resVarEq
          (HolFiniteMapExact.resVarEq
            (HolFiniteMapExact.resVarEq se.locals (ofString "found", d3.locals.lookup (ofString "found")))
            (ofString "child", d2.locals.lookup (ofString "child")))
          (ofString "k", d1.locals.lookup (ofString "k")))
        (ofString "nd", s.locals.lookup (ofString "nd"))
    set s_out : PanSemStateFiniteExact 64 F := { se with locals := locs_e }
    have heff_sf_se : HeapByteEff sf se
        (nodeCacheIvls Nd ++ keccakBufIvls s ++ [(globN s "scratch_ptr", sp0 - globN s "scratch_ptr")])
        ["heap_ptr", "scratch_ptr"] :=
      heff_exn.mono
        (fun i hi _ => by
          rw [hkc_sf] at hi
          exact Or.inl ⟨i, List.mem_append_left _ hi, le_rfl, le_rfl⟩)
        (fun _ h => h)
    have hsp_out : globN s_out "scratch_ptr" ≤ globN s "scratch_ptr" := by
      have : globN s_out "scratch_ptr" = globN s "scratch_ptr" := hsp_exn.trans hsf_sp
      omega
    exact Or.inl ⟨eid, ev, hne, rfl,
      (heff_s_sf.trans heff_sf_se).locals_clock s_out.locals s_out.clock,
      hsp_out, hN_exn, hext_exn.trans hext_sf, hkc_exn.trans hkc_sf, hvs_exn⟩
  · set spp := (evaluateHOLFiniteState sf fillStackPushPopProg).2
    have hppp : evaluateHOLFiniteState sf fillStackPushPopProg = (none, spp) :=
      Prod.ext hpp_none rfl
    rw [hppp]; dsimp only
    set locs_pp :=
      HolFiniteMapExact.resVarEq
        (HolFiniteMapExact.resVarEq
          (HolFiniteMapExact.resVarEq
            (HolFiniteMapExact.resVarEq spp.locals (ofString "found", d3.locals.lookup (ofString "found")))
            (ofString "child", d2.locals.lookup (ofString "child")))
          (ofString "k", d1.locals.lookup (ofString "k")))
        (ofString "nd", s.locals.lookup (ofString "nd"))
    set s_out : PanSemStateFiniteExact 64 F := { spp with locals := locs_pp }
    have hsp_le_s : globN spp "scratch_ptr" ≤ globN s "scratch_ptr" := by
      have hd4_sp : globN d4 "scratch_ptr" = globN s "scratch_ptr" := rfl
      by_cases hfw : fw ≠ 0
      · obtain ⟨h1, h2⟩ := hpp_push hfw
        rw [h2]; rw [hsf_sp, hd4_sp] at h1; omega
      · rw [hpp_pop (Classical.not_not.1 hfw), hsf_sp, hd4_sp]
    have heff_sf_spp : HeapByteEff sf spp
        (nodeCacheIvls Nd ++ keccakBufIvls s ++ [(globN s "scratch_ptr", sp0 - globN s "scratch_ptr")])
        ["heap_ptr", "scratch_ptr"] :=
      heff_pp.mono
        (fun i hi _ => by
          rcases List.mem_append.1 hi with h12 | h3
          · rw [hkc_sf] at h12
            exact Or.inl ⟨i, List.mem_append_left _ h12, le_rfl, le_rfl⟩
          · by_cases hfw : fw ≠ 0
            · rw [if_pos hfw] at h3; simp at h3; subst h3
              obtain ⟨h1, h2⟩ := hpp_push hfw
              have htop_fmp : globN sf "frame_mem_ptr" ≤ topw'.toNat := by
                have hfp_sp := heff_pp.arena.2.2.2.2.1
                rw [← heff_pp.fp_eq, ← h2]
                exact hfp_sp
              exact Or.inr (Or.inl ⟨htop_fmp, by omega⟩)
            · rw [if_neg hfw] at h3; simp at h3)
        (fun _ h => h)
    have hfs_out : FillStack sp0 node0 Nd s_out topw' fs' := by
      obtain ⟨hpw', hl', hi', hm'⟩ := hfs_pp
      refine ⟨hpw',
        fillLinks_congr (s := spp) (post := s_out) (fun _ _ => rfl) (fun _ _ => rfl) hl',
        ?_,
        by cases fs' with
          | nil => exact hm'
          | cons _ _ => exact hm'⟩
      intro g hg
      exact (fillFrameInv_congr_of_heapByteEff (extra := []) heff_pp.arena hN_pp
        ((HeapByteEff.refl heff_pp.arena _ []).locals_clock s_out.locals s_out.clock)
        rfl (by omega) hsp0_hi
        (by change globN spp "scratch_ptr" ≤ g; exact (hi' g hg).2.1.1) hvs_pp
        (fun _ _ _ _ he => by simp at he) (fun _ _ he => by simp at he)
        (by rw [hkc_pp, hkc_sf]; exact hkc_lt_hl) (fun _ he => by simp at he)
        (fun _ _ _ _ _ _ => rfl) (hi' g hg)).1
    refine Or.inr ⟨topw', fs', rfl, hpp_c,
      (heff_s_sf.trans heff_sf_spp).locals_clock s_out.locals s_out.clock,
