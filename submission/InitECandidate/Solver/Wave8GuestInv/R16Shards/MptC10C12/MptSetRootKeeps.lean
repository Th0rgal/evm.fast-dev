    intro hto; rw [hto] at hres; exact not_resumes_timeout_sc hres
  obtain ⟨hp, n16, q, mid, hn16_ev, hhp_nat, hhp8, hq_nat, _, hq_hi, _, hmid_hp, hmid_g, _, hmid_loc,
