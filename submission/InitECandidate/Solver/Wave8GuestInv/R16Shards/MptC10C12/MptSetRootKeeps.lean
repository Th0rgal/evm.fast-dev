                · rw [hms3] at hst3; injection hst3 with _ hst3_eq; subst hst3_eq
                  dsimp only
                  have hst2_ma : st2.memaddrs = ordinaryDomain := hst2_facts.2.1.trans hst1_ma
                  have hframe3 : ∀ (ws : List (HolWordLab 64)) (x : BitVec 64) (mem mem' : BitVec 64 → HolWordLab 64),
                      frw.toNat + 40 ≤ x.toNat → x.toNat < heapEnd →
                      @panMemStoresHOL 64 _ x ws st2.memaddrs (fun a => Classical.propDecidable (st2.memaddrs a)) mem = some mem' →
                      mem' (BitVec.ofNat 64 (frw.toNat + 24)) = mem (BitVec.ofNat 64 (frw.toNat + 24)) := by
                    intro ws
                    induction ws with
                    | nil =>
                      intro x mem mem' _ _ hst
                      simp only [panMemStoresHOL, Option.some.injEq] at hst
                      rw [← hst]
                    | cons w ws ih =>
                      intro x mem mem' hx_lo hx_hi hst
                      unfold panMemStoresHOL panMemStoreHOL at hst
                      split_ifs at hst with hdomx
                      have hbw : (panBytesInWord 64 : BitVec 64) = 8#64 := by decide
                      have hx_dom : ordinaryDomain x := hst2_ma ▸ hdomx
                      rw [ordinaryDomain_iff] at hx_dom
                      have hnext_nat : (x + panBytesInWord 64).toNat = x.toNat + 8 := by
                        rw [hbw, BitVec.toNat_add]
                        have hhe_val := R16Shards.WkBlockTxEnc.heapEnd_val
                        change (x.toNat + 8) % 2^64 = x.toNat + 8; omega
                      by_cases hnext_hi : x.toNat + 8 < heapEnd
                      · rw [ih (x + panBytesInWord 64) _ mem' (by omega) (by omega) hst]
                        apply if_neg
                        intro heq
                        have h24_nat : (BitVec.ofNat 64 (frw.toNat + 24)).toNat = frw.toNat + 24 := by
                          rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
                        have := congrArg BitVec.toNat heq; omega
                      · cases ws with
                        | nil =>
                          simp only [panMemStoresHOL, Option.some.injEq] at hst
                          rw [← hst]
                          apply if_neg
                          intro heq
                          have h24_nat : (BitVec.ofNat 64 (frw.toNat + 24)).toNat = frw.toNat + 24 := by
                            rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega)]
                          have := congrArg BitVec.toNat heq; omega
                        | cons w2 ws2 =>
                          unfold panMemStoresHOL panMemStoreHOL at hst
                          split_ifs at hst with hdom2
                          exfalso
                          have hx2_dom : ordinaryDomain (x + panBytesInWord 64) := hst2_ma ▸ hdom2
                          rw [ordinaryDomain_iff] at hx2_dom
                          omega
                  have h40_nat : (frw + 40#64).toNat = frw.toNat + 40 := by
                    rw [BitVec.toNat_add]; change (frw.toNat + 40) % 2^64 = frw.toNat + 40; omega
                  have hfr_he : frw.toNat + 48 ≤ heapEnd := hfr_in.2.trans hse
                  rw [hframe3 (flattenHOL vpl) (frw + 40#64) st2.memory m3 (by omega) (by omega) hms3]
                  exact hst2_facts.2.2
            rw [evaluateHOLFiniteState_return] at hret_b ⊢
            have hc0_st3 : @evalHOLExact 64 F _ st3.toExact (fun a => Classical.propDecidable (st3.memaddrs a)) (.const 0) =
                some (.val (.word 0)) := rfl
            rw [hc0_st3] at hret_b ⊢; dsimp only at hret_b ⊢
            have hsz_ok : sizeOfShapeWithContextHOL st3.structs (shapeOfHOLExact (.val (.word 0) : ValueHOL 64)) ≤ 32 := by
              simp [shapeOfHOLExact, sizeOfShapeWithContextHOL]
            rw [if_pos hsz_ok]; dsimp only [emptyLocalsHOLFinite]
            rw [hst3_mem]
            dsimp only
            have hhp_eq : globN sa0 "heap_ptr" = globN s "heap_ptr" := rfl
            omega

private theorem lookup__node_rlp_begin_sc :
