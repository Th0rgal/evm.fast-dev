        change (shapeEqHOL
              (shapeOfHOLExact (.rStruct [.val (.word rpw), .val (.word rlw)]))
              (.comb [.one, .one]) &&
            shapeEqHOL
              (shapeOfHOLExact (.rStruct [.val (.word rpw), .val (.word rlw)]))
              (.comb [.one, .one])) = true at hsh_comb
        simp only [hsh_comb, ↓reduceIte] at hret ⊢
