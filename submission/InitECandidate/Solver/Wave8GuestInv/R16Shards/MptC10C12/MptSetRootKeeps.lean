private theorem heapByteEff_drop_alloc_buf {F : Type}
    {s post : PanSemStateFiniteExact 64 F} {buf0 totalLen : Nat} {R : List Ivl} {gw : List String}
    (heff : HeapByteEff s post ([(buf0, totalLen)] ++ R) gw)
    (hlo : globN s "heap_ptr" ≤ buf0) (hhi : buf0 + totalLen ≤ heapLimit) :
    HeapByteEff s post R gw := by
  refine heff.mono ?_ (fun _ h => h)
  intro i hi hipos
  rcases List.mem_append.1 hi with h1 | h2
  · simp only [List.mem_singleton] at h1; subst h1
    exact Or.inr (Or.inr ⟨hlo, hhi⟩)
  · exact Or.inl ⟨i, h2, le_rfl, le_rfl⟩

private theorem eval_decCall_rlp_encode_bytes_or_exn {F : Type}
    (s : PanSemStateFiniteExact 64 F) (lname : String) (dstExp srcExp nExp : ExpHOL 64)
    (dst0 src0 n0 : BitVec 64) (cont : ProgHOL 64) (Rl : List Ivl) (gw : List String)
    (hcode : s.code = originalRuntimeCode) (hAR : ArenaReady s)
    (hdst : @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) dstExp =
      some (.val (.word dst0)))
    (hsrc : @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) srcExp =
      some (.val (.word src0)))
    (hn : @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) nExp =
      some (.val (.word n0)))
    (hn60 : n0.toNat < 2 ^ 60)
    (hin_ivl : ∃ ivl ∈ Rl, ivl.1 ≤ dst0.toNat ∧
      dst0.toNat + rlpEncBytesLen s src0.toNat n0.toNat ≤ ivl.1 + ivl.2)
    (hor : (evaluateHOLFiniteState s
      (.decCall (ofString lname) .one (ofString "rlp_encode_bytes") [dstExp, srcExp, nExp] cont)).1 = none ∨
      Resumes (evaluateHOLFiniteState s
        (.decCall (ofString lname) .one (ofString "rlp_encode_bytes") [dstExp, srcExp, nExp] cont)).1) :
    ∃ (len : BitVec 64) (mid : PanSemStateFiniteExact 64 F),
      len.toNat = rlpEncBytesLen s src0.toNat n0.toNat ∧
      dst0.toNat < heapEnd ∧
      mid.code = s.code ∧
      mid.globals = s.globals ∧
      mid.locals = s.locals.update (ofString lname, .val (.word len)) ∧
      HeapByteEff s mid Rl gw ∧
      ((evaluateHOLFiniteState mid cont).1 = none ∨ Resumes (evaluateHOLFiniteState mid cont).1) ∧
      (evaluateHOLFiniteState s
        (.decCall (ofString lname) .one (ofString "rlp_encode_bytes") [dstExp, srcExp, nExp] cont)) =
        ((evaluateHOLFiniteState mid cont).1,
         { (evaluateHOLFiniteState mid cont).2 with
           locals := HolFiniteMapExact.resVarEq (evaluateHOLFiniteState mid cont).2.locals
             (ofString lname, s.locals.lookup (ofString lname)) }) := by
  have hnot_err : (evaluateHOLFiniteState s
      (.decCall (ofString lname) .one (ofString "rlp_encode_bytes") [dstExp, srcExp, nExp] cont)).1 ≠ some .error := by
    intro herr; rcases hor with hn' | hres
    · rw [herr] at hn'; cases hn'
    · rw [herr] at hres; exact not_resumes_error hres
  have hnt : (evaluateHOLFiniteState s
      (.decCall (ofString lname) .one (ofString "rlp_encode_bytes") [dstExp, srcExp, nExp] cont)).1 ≠ some .timeOut := by
    intro hto; rcases hor with hn' | ⟨_, hr⟩ | ⟨_, _, hr, _⟩
    · rw [hto] at hn'; cases hn'
    · rw [hto] at hr; cases hr
    · rw [hto] at hr; cases hr
  rw [evaluateHOLFiniteState_decCall_fixClockRewrite] at hnot_err hnt hor ⊢
  have ha : evalListHOLFinite s (h := fun a => Classical.propDecidable (s.memaddrs a))
      [dstExp, srcExp, nExp] = some [.val (.word dst0), .val (.word src0), .val (.word n0)] := by
    simp [evalListHOLFinite, evalListHOLExact, hdst, hsrc, hn]
  have hlk := pan_three_word_lookup s.code.lookup (ofString "rlp_encode_bytes")
    (ofString "dst") (ofString "src") (ofString "n")
    (sourceFnBody Guest.Software.guestFn_rlp_encode_bytes) dst0 src0 n0
    (by decide) (by decide) (by decide)
    (by rw [hcode]; exact lookup_rlp_encode_bytes)
  simp only [ha, hlk] at hnot_err hnt hor ⊢
  by_cases hcz : s.clock = 0
  · simp [hcz] at hnt
  · simp only [hcz, ↓reduceIte] at hnot_err hnt hor ⊢
    set cmap := ((HolFiniteMapExact.empty.update (ofString "dst", ValueHOL.val (.word dst0))).update
      (ofString "src", ValueHOL.val (.word src0))).update (ofString "n", ValueHOL.val (.word n0))
    set ent := callEntryStateHOLFinite s cmap
    have hent_dst : ent.locals.lookup (ofString "dst") = some (.val (.word dst0)) := by
      simp [ent, cmap, callEntryStateHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
        show ofString "n" ≠ ofString "dst" by decide, show ofString "src" ≠ ofString "dst" by decide]
    have hent_src : ent.locals.lookup (ofString "src") = some (.val (.word src0)) := by
      simp [ent, cmap, callEntryStateHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
        show ofString "n" ≠ ofString "src" by decide]
    have hent_n : ent.locals.lookup (ofString "n") = some (.val (.word n0)) := by
      simp [ent, cmap, callEntryStateHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
    rcases heb : evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn_rlp_encode_bytes) with ⟨reb, seb⟩
    have hnt_eb : reb ≠ some .timeOut := by
      rintro rfl; rw [heb] at hnt; exact hnt rfl
    obtain ⟨hret, hnonret⟩ := eval_rlp_encode_bytes_body_precise ent dst0 src0 n0 Rl
      hcode hAR.1.memaddrs hent_dst hent_src hent_n hn60 hin_ivl (by rw [heb]; exact hnt_eb)
    rw [heb] at hret hnonret
    dsimp only at hret hnonret
    simp only [heb] at hnot_err hnt hor ⊢
    cases reb with
    | none => exact False.elim (hnot_err rfl)
    | some r =>
      cases r with
      | timeOut => exact absurd rfl hnt_eb
      | exception eid ev =>
        rcases hor with hn' | hres
        · simp at hn'
        · exact False.elim (hnonret (.exception eid ev) rfl (fun _ h => by cases h) hres)
      | returned rv =>
        obtain ⟨len, rfl, hlen_eq, hdst_lt, heff_eb⟩ := hret rv rfl
        have hsh : (shapeEqHOL (shapeOfHOLExact (.val (.word len) : ValueHOL 64)) .one &&
            shapeEqHOL (shapeOfHOLExact (.val (.word len) : ValueHOL 64)) .one) = true := by
          simp [shapeOfHOLExact, shapeEqHOL]
        dsimp only at hor ⊢
        rw [if_pos hsh] at hor ⊢
        let mid := setVarHOLFinite (ofString lname) (.val (.word len))
          { seb with locals := s.locals }
        have heff0 : M11.ByteRegionEffect s ent Rl :=
          (M11.ByteRegionEffect.refl s Rl).with_locals_clock ent.locals ent.clock
        have heff_mid : M11.ByteRegionEffect s mid Rl :=
          (heff0.trans heff_eb).with_locals_clock mid.locals mid.clock
        exact ⟨len, mid, hlen_eq, hdst_lt, heff_mid.code, heff_mid.globals, rfl,
          HeapByteEff.of_m11_bre hAR heff_mid, hor, rfl⟩
      | «break» | «continue» | error =>
        exact False.elim (hnot_err rfl)
      | finalFfi _ =>
        rcases hor with hn' | ⟨_, h⟩ | ⟨_, _, h, _⟩
        · simp at hn'
        · simp at h
        · simp at h

theorem eval_finishStores_stage {F : Type}
    (s0 s : PanSemStateFiniteExact 64 F) (sp0 : Nat) (Nd : List Nat)
    (nodew bufw offw : BitVec 64) (gw : List String)
    (hAR0 : ArenaReady s0) (hN0 : NodeHeap s0 Nd)
    (hvs0 : NodeValuesSafe sp0 s0 Nd)
    (hkc_disj0 : ∀ o ∈ nodeExtents s0 Nd,
      Disj (bufferRegion s0 ("keccak_pad", 136)) o ∧
      Disj (bufferRegion s0 ("keccak_st", 200)) o)
    (heff0 : HeapByteEff s0 s (nodeCacheIvls Nd ++ keccakBufIvls s0) gw)
    (hAR : ArenaReady s) (hN : NodeHeap s Nd)
    (hext_eq : nodeExtents s Nd = nodeExtents s0 Nd)
    (hkc_eq : keccakBufIvls s = keccakBufIvls s0)
    (hnode_in : nodew.toNat ∈ Nd)
    (hoff_lt40 : offw.toNat < 2 ^ 40)
    (hl_node : s.locals.lookup (ofString "node") = some (.val (.word nodew)))
    (hl_buf : s.locals.lookup (ofString "buf") = some (.val (.word bufw)))
    (hl_off : s.locals.lookup (ofString "off") = some (.val (.word offw))) :
    let out := evaluateHOLFiniteState s finishStores
    out.1 = some (.returned (.val (.word 0))) ∧
    HeapByteEff s0 out.2 (nodeCacheIvls Nd ++ keccakBufIvls s0) gw ∧
    NodeHeap out.2 Nd ∧
    nodeExtents out.2 Nd = nodeExtents s0 Nd ∧
    keccakBufIvls out.2 = keccakBufIvls s0 ∧
    NodeValuesSafe sp0 out.2 Nd ∧
    memW out.2 (nodew.toNat + 8) = bufw.toNat ∧
    memW out.2 (nodew.toNat + 16) = offw.toNat ∧
    (∀ b : Nat, b < 2 ^ 64 → b ≠ nodew.toNat + 8 → b ≠ nodew.toNat + 16 →
      out.2.memory (BitVec.ofNat 64 b) = s.memory (BitVec.ofNat 64 b)) := by
  intro out; dsimp only [out, finishStores]
  have hhe : heapLimit ≤ heapEnd := by rw [heapEnd_val]; decide
  have h264 : heapEnd < 2 ^ 64 := by rw [heapEnd_val]; decide
  obtain ⟨_, _, hin_nd, hw_nd, _⟩ := hN.1 nodew.toNat hnode_in
  have hsz_ge : 32 ≤ nodeSize (memW s nodew.toNat) := nodeSize_ge32 (memW s nodew.toNat)
  have hnd_hi : nodew.toNat + nodeSize (memW s nodew.toNat) ≤ heapEnd := by
    dsimp [Inside, nodeIvl] at hin_nd; omega
  have hin_c8 : ∃ i ∈ nodeCacheIvls Nd ++ keccakBufIvls s0,
      i.1 ≤ nodew.toNat + 8 ∧ nodew.toNat + 8 + 8 ≤ i.1 + i.2 :=
    ⟨(nodew.toNat + 8, 24), List.mem_append_left _ (List.mem_map.2 ⟨nodew.toNat, hnode_in, rfl⟩),
      by omega, by omega⟩
  have hin_c16 : ∃ i ∈ nodeCacheIvls Nd ++ keccakBufIvls s0,
      i.1 ≤ nodew.toNat + 16 ∧ nodew.toNat + 16 + 8 ≤ i.1 + i.2 :=
    ⟨(nodew.toNat + 8, 24), List.mem_append_left _ (List.mem_map.2 ⟨nodew.toNat, hnode_in, rfl⟩),
      by omega, by omega⟩
  have hdst8 : @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a))
      (.op .add [.var .local (ofString "node"), .const 8]) =
      some (.val (.word (nodew + BitVec.ofNat 64 8))) := by
    simp [evalHOLExact, evalListHOLExact, hl_node, wordOpHOL, wordOp, valueIsWord, valueWord]
  have hval8 : @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a))
      (.var .local (ofString "buf")) = some (.val (.word bufw)) := by
    simp [evalHOLExact, hl_buf]
  obtain ⟨hst1_1, hst1_loc, hst1_glob, hm8_st1, hmem_st1, heff_st1⟩ :=
    eval_store_memW_at (s := s) (base := nodew) (w := bufw) (off := 8)
      (len := nodeSize (memW s nodew.toNat)) (Rl := nodeCacheIvls Nd ++ keccakBufIvls s0) (gw := gw)
      hAR hw_nd rfl (by omega) hnd_hi hin_c8 hdst8 hval8
  set st1 := (evaluateHOLFiniteState s
    (.store (.op .add [.var .local (ofString "node"), .const 8]) (.var .local (ofString "buf")))).2
  have hst1_eq : evaluateHOLFiniteState s
      (.store (.op .add [.var .local (ofString "node"), .const 8]) (.var .local (ofString "buf"))) =
      (none, st1) := Prod.ext hst1_1 rfl
  rw [evaluateHOLFiniteState_seq_line780, hst1_eq]; dsimp only
  have hAR1 : ArenaReady st1 := heff_st1.arena
  have hW1 : WordsOK st1 (nodew.toNat, nodeSize (memW s nodew.toNat)) :=
    P3MptSet.wordsOK_transfer hAR.1 hAR1.1 hw_nd
  have hdst16 : @evalHOLExact 64 F _ st1.toExact (fun a => Classical.propDecidable (st1.memaddrs a))
      (.op .add [.var .local (ofString "node"), .const 16]) =
      some (.val (.word (nodew + BitVec.ofNat 64 16))) := by
    simp [evalHOLExact, evalListHOLExact, hst1_loc, hl_node, wordOpHOL, wordOp, valueIsWord, valueWord]
  have hval16 : @evalHOLExact 64 F _ st1.toExact (fun a => Classical.propDecidable (st1.memaddrs a))
      (.var .local (ofString "off")) = some (.val (.word offw)) := by
    simp [evalHOLExact, hst1_loc, hl_off]
  obtain ⟨hst2_1, hst2_loc, hst2_glob, hm16_st2, hmem_st2, heff_st2⟩ :=
    eval_store_memW_at (s := st1) (base := nodew) (w := offw) (off := 16)
      (len := nodeSize (memW s nodew.toNat)) (Rl := nodeCacheIvls Nd ++ keccakBufIvls s0) (gw := gw)
      hAR1 hW1 rfl (by omega) hnd_hi hin_c16 hdst16 hval16
  set st2 := (evaluateHOLFiniteState st1
    (.store (.op .add [.var .local (ofString "node"), .const 16]) (.var .local (ofString "off")))).2
  have hst2_eq : evaluateHOLFiniteState st1
      (.store (.op .add [.var .local (ofString "node"), .const 16]) (.var .local (ofString "off"))) =
      (none, st2) := Prod.ext hst2_1 rfl
  rw [evaluateHOLFiniteState_seq_line780, hst2_eq]; dsimp only
  have hret_eq : evaluateHOLFiniteState st2 (.return (.const 0)) =
      (some (.returned (.val (.word 0))), emptyLocalsHOLFinite st2) := by
    rw [evaluateHOLFiniteState_return]
    simp [evalHOLExact, shapeOfHOLExact, sizeOfShapeWithContextHOL]
  rw [hret_eq]; dsimp only
  set post := emptyLocalsHOLFinite st2
  have hmem_post : post.memory = st2.memory := rfl
  have hglob_post : post.globals = s.globals := by
    change st2.globals = s.globals; rw [hst2_glob, hst1_glob]
  have heff_s_post : HeapByteEff s post (nodeCacheIvls Nd ++ keccakBufIvls s0) gw :=
    (heff_st1.trans heff_st2).locals_clock post.locals post.clock
  have heff_total : HeapByteEff s0 post (nodeCacheIvls Nd ++ keccakBufIvls s0) gw :=
    heff0.trans heff_s_post
  have hkc_post : keccakBufIvls post = keccakBufIvls s0 := by
    have hkc_s : keccakBufIvls post = keccakBufIvls s := by
      unfold keccakBufIvls bufferRegion globN; rw [hglob_post]
    rw [hkc_s, hkc_eq]
  have hm8_post : memW post (nodew.toNat + 8) = bufw.toNat := by
    have hm8_st2 : memW st2 (nodew.toNat + 8) = memW st1 (nodew.toNat + 8) := by
      apply memW_eq_of_cell_eq
      exact hmem_st2 (nodew.toNat + 8) (by omega) (by omega)
    change memW st2 (nodew.toNat + 8) = bufw.toNat
    rw [hm8_st2, hm8_st1]
  have hm16_post : memW post (nodew.toNat + 16) = offw.toNat := hm16_st2
  have hmem_frame : ∀ b : Nat, b < 2 ^ 64 → b ≠ nodew.toNat + 8 → b ≠ nodew.toNat + 16 →
      post.memory (BitVec.ofNat 64 b) = s.memory (BitVec.ofNat 64 b) := by
    intro b hb h8 h16
    change st2.memory (BitVec.ofNat 64 b) = s.memory (BitVec.ofNat 64 b)
    rw [hmem_st2 b hb h16, hmem_st1 b hb h8]
  have hrlp_len : ∀ n ∈ Nd, memW post (n + 16) < 2 ^ 40 := by
    intro n hn
    by_cases hnn : n = nodew.toNat
    · subst hnn; rw [hm16_post]; exact hoff_lt40
    · obtain ⟨_, _, hin_n, _, _, _, _, h16_s, _⟩ := hN.1 n hn
      have hn_lt : n + 16 < 2 ^ 64 := by
        have := nodeSize_ge32 (memW s n); dsimp [Inside, nodeIvl] at hin_n; omega
      have hdj_n : Disj (nodeIvl s n) (nodeIvl s nodew.toNat) := hN.2 n hn nodew.toNat hnode_in hnn
      have hsz_n := nodeSize_ge32 (memW s n)
      have hne8 : n + 16 ≠ nodew.toNat + 8 := by
        dsimp [Disj, nodeIvl] at hdj_n; rcases hdj_n with h0 | h0 | hd1 | hd2 <;> omega
      have hne16 : n + 16 ≠ nodew.toNat + 16 := by omega
      have hm_eq : memW post (n + 16) = memW s (n + 16) :=
        memW_eq_of_cell_eq (hmem_frame (n + 16) hn_lt hne8 hne16)
      rw [hm_eq]; exact h16_s
  have hkc_disj_all := keccakBufIvls_disj_of_buffers hkc_disj0
  obtain ⟨hN_post, hext_post⟩ := nodeHeap_of_heapByteEff_cache hAR0 hN0 heff_total
    (fun e he o ho => hkc_disj_all e he o ho) hrlp_len
  have heff_vs : HeapByteEff s0 post (nodeCacheIvls Nd ++ keccakBufIvls s0 ++ []) gw := by
    simpa only [List.append_nil] using heff_total
  have hvs_post : NodeValuesSafe sp0 post Nd :=
    nodeValuesSafe_of_heapByteEff hAR0 hN0 heff_vs hkc_post
      (fun _ h => by simp at h) hkc_disj0 hvs0
  exact ⟨rfl, heff_total, hN_post, hext_post, hkc_post, hvs_post, hm8_post, hm16_post, hmem_frame⟩

theorem eval_finishWrite_stage {F : Type}
    (s0 s : PanSemStateFiniteExact 64 F) (sp0 : Nat) (Nd : List Nat)
    (nodew kw payw cbufw clenw bufw hlw : BitVec 64) (gw : List String)
    (hc : s.code = originalRuntimeCode)
    (hAR0 : ArenaReady s0) (hN0 : NodeHeap s0 Nd)
    (hvs0 : NodeValuesSafe sp0 s0 Nd)
    (hsp_le0 : globN s0 "scratch_ptr" ≤ sp0)
    (hkc_disj0 : ∀ o ∈ nodeExtents s0 Nd,
      Disj (bufferRegion s0 ("keccak_pad", 136)) o ∧
      Disj (bufferRegion s0 ("keccak_st", 200)) o)
    (hnode_in : nodew.toNat ∈ Nd)
    (hk1 : 1 ≤ memW s0 nodew.toNat)
    (hkw_nat : kw.toNat = memW s0 nodew.toNat)
    (hk12_cb : (memW s0 nodew.toNat = 1 ∨ memW s0 nodew.toNat = 2) →
      clenw.toNat ≤ heapLimit / 2 + 1 ∧
      sourceBase ≤ cbufw.toNat ∧
      cbufw.toNat + clenw.toNat ≤ globN s0 "heap_ptr")
    (hk1_pay : memW s0 nodew.toNat = 1 →
      payw.toNat = rlpEncBytesLen s0 cbufw.toNat clenw.toNat +
        rlpEncBytesLen s0 (memW s0 (nodew.toNat + 48)) (memW s0 (nodew.toNat + 56)))
    (hk2_pay : memW s0 nodew.toNat = 2 →
      payw.toNat = rlpEncBytesLen s0 cbufw.toNat clenw.toNat +
        nodeRefBytes s0 (memW s0 (nodew.toNat + 48)))
    (hk3_pay : memW s0 nodew.toNat = 3 →
      payw.toNat = branchRefSum s0 nodew.toNat 16 +
        rlpEncBytesLen s0 (memW s0 (nodew.toNat + 160)) (memW s0 (nodew.toNat + 168)))
    (hbuf_lo : globN s0 "heap_ptr" ≤ bufw.toNat)
    (hbuf_fit : bufw.toNat + (hlw.toNat + payw.toNat) ≤ heapLimit)
    (heff0 : HeapByteEff s0 s [(bufw.toNat, hlw.toNat + payw.toNat)] gw)
    (hkc_eq0 : keccakBufIvls s = keccakBufIvls s0)
    (hgw : "heap_ptr" ∈ gw)
    (hkp : ofString "keccak_pad" ∉ gw.map ofString)
    (hks : ofString "keccak_st" ∉ gw.map ofString)
    (hl_node : s.locals.lookup (ofString "node") = some (.val (.word nodew)))
    (hl_k : s.locals.lookup (ofString "k") = some (.val (.word kw)))
    (hl_cbuf : s.locals.lookup (ofString "cbuf") = some (.val (.word cbufw)))
    (hl_clen : s.locals.lookup (ofString "clen") = some (.val (.word clenw)))
    (hl_buf : s.locals.lookup (ofString "buf") = some (.val (.word bufw)))
    (hl_off : s.locals.lookup (ofString "off") = some (.val (.word hlw)))
    (hres : Resumes (evaluateHOLFiniteState s (.seq finishWriteIte finishStores)).1) :
    let out := evaluateHOLFiniteState s (.seq finishWriteIte finishStores)
    (∃ eid ev,
      eid ≠ ofString "TrapErr" ∧
      out.1 = some (.exception eid ev) ∧
      HeapByteEff s0 out.2 (nodeCacheIvls Nd ++ keccakBufIvls s0) gw ∧
      NodeHeap out.2 Nd ∧
      nodeExtents out.2 Nd = nodeExtents s0 Nd ∧
      keccakBufIvls out.2 = keccakBufIvls s0 ∧
      NodeValuesSafe sp0 out.2 Nd) ∨
    (out.1 = some (.returned (.val (.word 0))) ∧
      HeapByteEff s0 out.2 (nodeCacheIvls Nd ++ keccakBufIvls s0) gw ∧
      NodeHeap out.2 Nd ∧
      nodeExtents out.2 Nd = nodeExtents s0 Nd ∧
