        if_neg (hne_0 24 (by decide) (by decide)), if_neg (hne_0 16 (by decide) (by decide)),
        if_neg (hne_0 8 (by decide) (by decide))]
    have hmw48 : memW post (hp.toNat + 48) = wvptr.toNat := by
      unfold memW; rw [← (hhp_add 48 (by decide)).1, hpost_mem]; dsimp only [M8]
      simp [Wave8Contracts.M26.updW, if_neg hne_48_56]
    have hmw56 : memW post (hp.toNat + 56) = wvlen.toNat := by
      unfold memW; rw [← (hhp_add 56 (by decide)).1, hpost_mem]; dsimp only [M8]
      simp [Wave8Contracts.M26.updW]
    refine ⟨hp, hr, hwlf_hp, valExtNodeStep_prepended_fresh hAR hNd hext hm_lt ?_ ?_, hroot, hm_lt⟩
    · intro _; rw [hmw48, hmw56]; exact hvf
    · intro hk3; rw [hmw0] at hk3; cases hk3

theorem node_new_ext_body_valExt {F : Type}
    {K : List Ivl} {V : List (Nat × Nat)}
    (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
    (wnib wnlen wchild : BitVec 64)
    (hcode : s.code = originalRuntimeCode)
    (hAR : ArenaReady s) (hNd : NodeHeap s Nd)
    (hlk_nib : s.locals.lookup (ofString "nib") = some (.val (.word wnib)))
