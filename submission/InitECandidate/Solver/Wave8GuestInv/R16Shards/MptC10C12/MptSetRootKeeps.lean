    rw [hl_vel] at hl
    obtain ⟨rfl, hrest⟩ := Prod.mk.inj (Option.some.inj hl.symm)
    obtain ⟨hcal_eq, rfl⟩ := Prod.mk.inj hrest
    subst hcal_eq
    set cmap := (HolFiniteMapExact.empty.update (ofString "p", ValueHOL.val (.word pw))).update
