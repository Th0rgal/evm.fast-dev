private def noExnProgSc : ProgHOL 64 → Bool
  | .dec _ _ _ b => noExnProgSc b
  | .seq a b => noExnProgSc a && noExnProgSc b
  | .ite _ a b => noExnProgSc a && noExnProgSc b
  | .assign _ _ _ | .store _ _ | .storeByte _ _ => true
  | .skip | .break | .continue | .annot _ _ | .return _ => true
  | _ => false

private theorem evaluate_noExnProgSc {F : Type} (p : ProgHOL 64) (hp : noExnProgSc p = true)
    (s : PanSemStateFiniteExact 64 F) (eid : MlS) (ev : ValueHOL 64) :
    (evaluateHOLFiniteState s p).1 ≠ some (.exception eid ev) := by
  cases p with
  | skip => rw [evaluateHOLFiniteState_skip]; simp
  | «break» => rw [evaluateHOLFiniteState_break]; simp
  | «continue» => rw [evaluateHOLFiniteState_continue]; simp
  | annot _ _ => rw [evaluateHOLFiniteState_annot]; simp
  | «return» _ =>
    rw [evaluateHOLFiniteState_return]; split
    · simp
    · split <;> simp
  | assign _ _ _ =>
    rw [evaluateHOLFiniteState_assign]; split
    · simp
    · split <;> simp
  | store _ _ =>
    rw [evaluateHOLFiniteState_store]; split
    · split
      · split <;> simp
      · simp
    · simp
  | storeByte _ _ =>
    rw [evaluateHOLFiniteState_storeByte]; split
    · split
      · split <;> simp
      · simp
    · simp
  | dec x sh init b =>
    have hb : noExnProgSc b = true := by simpa [noExnProgSc] using hp
    rw [evaluateHOLFiniteState_dec_total]; dsimp only
    split
    · simp
    · split
      · exact evaluate_noExnProgSc b hb _ eid ev
      · simp
  | seq a b =>
    have hab : noExnProgSc a = true ∧ noExnProgSc b = true := by
      simpa [noExnProgSc, Bool.and_eq_true] using hp
    rw [evaluateHOLFiniteState_seq_line780]
    have ha := evaluate_noExnProgSc a hab.1 s eid ev
    rcases hr : evaluateHOLFiniteState s a with ⟨r, m⟩
    rw [hr] at ha
    cases r with
    | none => exact evaluate_noExnProgSc b hab.2 m eid ev
    | some _ => exact ha
  | ite _ a b =>
    have hab : noExnProgSc a = true ∧ noExnProgSc b = true := by
      simpa [noExnProgSc, Bool.and_eq_true] using hp
    rw [evaluateHOLFiniteState_ite]; split
    · split
      · exact evaluate_noExnProgSc b hab.2 s eid ev
      · exact evaluate_noExnProgSc a hab.1 s eid ev
    · simp
  | _ => simp [noExnProgSc] at hp

