    have hmw0 : memW post hp.toNat = 1 := by
      have hne_0 : ∀ k : Nat, 0 < k → k ≤ 56 → hp + BitVec.ofNat 64 0 ≠ hp + BitVec.ofNat 64 k := by
        intro k hk1 hk2 heq; have := congrArg BitVec.toNat heq
        rw [(hhp_add 0 (by decide)).2, (hhp_add k (by omega)).2] at this; omega
      have ha0 : BitVec.ofNat 64 hp.toNat = hp + BitVec.ofNat 64 0 := by simp
      unfold memW; rw [ha0, hpost_mem]; dsimp only [M8]
      simp [Wave8Contracts.M26.updW,
