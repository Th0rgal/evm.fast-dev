            hs1_sum_all (jw.toNat + 1) (by omega)]
          simp only [branchRefSum, hoff_eq, hw4_s, hchw_s]; omega
        have hs1_node : s1.locals.lookup (ofString "node") = some (.val (.word nodew)) := by
          simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
            show s0.locals.lookup (ofString "node") = some (.val (.word nodew)) from hl_node,
            show ofString "j" ≠ ofString "node" by decide,
            show ofString "off" ≠ ofString "node" by decide]
        have hs1_buf : s1.locals.lookup (ofString "buf") = some (.val (.word bufw)) := by
          simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
            show s0.locals.lookup (ofString "buf") = some (.val (.word bufw)) from hl_buf,
            show ofString "j" ≠ ofString "buf" by decide,
            show ofString "off" ≠ ofString "buf" by decide]
        have hs1_off : s1.locals.lookup (ofString "off") = some (.val (.word (offw + w4))) := by
          simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE,
            show ofString "j" ≠ ofString "off" by decide]
        have hs1_j : s1.locals.lookup (ofString "j") = some (.val (.word (jw + 1))) := by
          simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
        have htot_ge_s1 : hl0 + branchRefSum s1 nodew.toNat 16 ≤ totalLen := by
          rw [hs1_sum_all 16 (le_refl 16)]; exact htot_ge
        have heff24_s_s1 : HeapByteEff s s1 ([(buf0, totalLen)] ++ (Nd.map (fun n => (n + 24, 8)) ++ keccakBufIvls s)) gw :=
          heff24_s_mid.locals_clock s1.locals mid.clock
        have heffc_s_s1 : HeapByteEff s s1 ([(buf0, totalLen)] ++ (nodeCacheIvls Nd ++ keccakBufIvls s)) gw :=
          heffc_s_mid.locals_clock s1.locals mid.clock
        rcases eval_finishPass2_loop rem s1 Nd buf0 nodew bufw (offw + w4) (jw + 1) hl0 totalLen gw
            hs1_c hs1_AR hs1_N hs1_kc_disj hs1_buf_disj hnode_in hs1_k3 hbuf_eq hbuf_fit htot_ge_s1
            (by omega) (by omega) hoff1_nat hgw hkp hks hs1_node hs1_buf hs1_off hs1_j hnt hor with
          ⟨eid, ev, hne, hex, heff24_tl, heffc_tl⟩ |
          ⟨off16, hnone, hoff16_eq, hc_tl, hloc_tl, heff24_tl, heffc_tl, hN_tl, hext_tl, hkc_tl, hw012_tl, href_tl⟩
        · left
          rw [hs1_kc_eq] at heff24_tl heffc_tl
          exact ⟨eid, ev, hne, hex, heff24_s_s1.trans heff24_tl, heffc_s_s1.trans heffc_tl⟩
        · right
          rw [hs1_kc_eq] at heff24_tl heffc_tl hkc_tl
          rw [hs1_sum_all 16 (le_refl 16)] at hoff16_eq
          refine ⟨off16, hnone, hoff16_eq, hc_tl.trans (hs1_c.trans hc.symm), ?_,
            heff24_s_s1.trans heff24_tl, heffc_s_s1.trans heffc_tl, hN_tl,
            hext_tl.trans hs1_ext, hkc_tl,
            fun n hn => ⟨((hw012_tl n hn).1).trans (hw012_mid n hn).1,
              ((hw012_tl n hn).2.1).trans (hw012_mid n hn).2.1,
              ((hw012_tl n hn).2.2).trans (hw012_mid n hn).2.2⟩,
            fun m hm => (href_tl m hm).trans (href_mid m hm)⟩
          rw [hloc_tl]
          apply HolFiniteMapExact.ext; funext x
          by_cases hx_j : x = ofString "j"
          · subst hx_j; simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
          · by_cases hx_o : x = ofString "off"
            · subst hx_o; simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, Ne.symm hx_j]
            · simp [s1, s0, decClockHOLFinite, setVarHOLFinite, HolFiniteMapExact.lookup_update,
                FUPDATE, Ne.symm hx_j, Ne.symm hx_o]
      · -- Exception branch of `node_write_ref`
        have hbody_or' : (evaluateHOLFiniteState s0
            (.decCall (ofString "w4") .one (ofString "node_write_ref")
              [.load .one (.op .add [.var .local (ofString "node"), .const (BitVec.ofNat 64 32),
                .panop .mul [.var .local (ofString "j"), .const (BitVec.ofNat 64 8)]]),
               .op .add [.var .local (ofString "buf"), .var .local (ofString "off")]]
              (.seq
                (.assign .local (ofString "off") (.op .add [.var .local (ofString "off"), .var .local (ofString "w4")]))
                (.assign .local (ofString "j") (.op .add [.var .local (ofString "j"), .const (BitVec.ofNat 64 1)]))))).1 = none ∨
            Resumes (evaluateHOLFiniteState s0
              (.decCall (ofString "w4") .one (ofString "node_write_ref")
                [.load .one (.op .add [.var .local (ofString "node"), .const (BitVec.ofNat 64 32),
                  .panop .mul [.var .local (ofString "j"), .const (BitVec.ofNat 64 8)]]),
                 .op .add [.var .local (ofString "buf"), .var .local (ofString "off")]]
                (.seq
                  (.assign .local (ofString "off") (.op .add [.var .local (ofString "off"), .var .local (ofString "w4")]))
                  (.assign .local (ofString "j") (.op .add [.var .local (ofString "j"), .const (BitVec.ofNat 64 1)]))))).1 := hbody_or
        rcases hbody_or' with hn | ⟨v, hr⟩ | ⟨eid, ev, hex, hne⟩
        · exact False.elim (hne_none hn)
        · exact False.elim (hne_ret v hr)
        · obtain ⟨heff24_ex, heffc_ex⟩ := hex_eff (Or.inr ⟨eid, ev, hex, hne⟩)
          have hex' : (evaluateHOLFiniteState s0 finishPass2LoopBody).1 = some (.exception eid ev) := hex
          rw [hex']
          left
          have hs0_eff24 : HeapByteEff s s0 ([(buf0, totalLen)] ++ (Nd.map (fun n => (n + 24, 8)) ++ keccakBufIvls s)) gw :=
            HeapByteEff.of_locFrame hAR (by cases s; rfl) _ gw
          have hs0_effc : HeapByteEff s s0 ([(buf0, totalLen)] ++ (nodeCacheIvls Nd ++ keccakBufIvls s)) gw :=
            HeapByteEff.of_locFrame hAR (by cases s; rfl) _ gw
          exact ⟨eid, ev, hne, rfl, hs0_eff24.trans heff24_ex, hs0_effc.trans heffc_ex⟩

private theorem call_void_flow_or_exn_sc {F : Type}
    {s : PanSemStateFiniteExact 64 F} {fname : MlS} {args : List (ExpHOL 64)}
    (h : (evaluateHOLFiniteState s (.call (some (none, none)) fname args)).1 = none ∨
         Resumes (evaluateHOLFiniteState s (.call (some (none, none)) fname args)).1) :
    ∃ (values : List (ValueHOL 64)) (body : ProgHOL 64)
      (callee : HolFiniteMapExact MlS (ValueHOL 64)) (retShape : ShapeHOL),
      s.clock ≠ 0 ∧
      evalListHOLFinite s (h := fun a => Classical.propDecidable (s.memaddrs a)) args = some values ∧
      lookupCodeHOLFinite s.code.lookup fname values = some (body, callee, retShape) ∧
      ((∃ eid ev,
          evaluateHOLFiniteState (callEntryStateHOLFinite s callee) body =
            (some (.exception eid ev), (evaluateHOLFiniteState (callEntryStateHOLFinite s callee) body).2) ∧
          eid ≠ ofString "TrapErr" ∧
          evaluateHOLFiniteState s (.call (some (none, none)) fname args) =
            (some (.exception eid ev),
              emptyLocalsHOLFinite (evaluateHOLFiniteState (callEntryStateHOLFinite s callee) body).2)) ∨
       (∃ rv post,
          evaluateHOLFiniteState (callEntryStateHOLFinite s callee) body = (some (.returned rv), post) ∧
          shapeEqHOL (shapeOfHOLExact rv) retShape = true ∧
          evaluateHOLFiniteState s (.call (some (none, none)) fname args) =
            (none, { post with locals := s.locals }))) := by
  have hcall := evaluateHOLFiniteState_call s (some (none, none)) fname args
  have hnot_err : (evaluateHOLFiniteState s (.call (some (none, none)) fname args)).1 ≠ some .error := by
    intro herr; rcases h with hn | hres
    · rw [herr] at hn; cases hn
    · rw [herr] at hres; exact not_resumes_error hres
  have hnot_to : (evaluateHOLFiniteState s (.call (some (none, none)) fname args)).1 ≠ some .timeOut := by
    intro hto; rcases h with hn | ⟨_, hr⟩ | ⟨_, _, hr, _⟩
    · rw [hto] at hn; cases hn
    · rw [hto] at hr; cases hr
    · rw [hto] at hr; cases hr
  rcases hargs : evalListHOLFinite s (h := fun a => Classical.propDecidable (s.memaddrs a)) args with _ | values
  · exfalso; apply hnot_err; rw [hcall, hargs]
  · rw [hargs] at hcall; dsimp only at hcall
    rcases hl : lookupCodeHOLFinite s.code.lookup fname values with _ | ⟨body, callee, retShape⟩
    · exfalso; apply hnot_err; rw [hcall, hl]
    · rw [hl] at hcall; dsimp only at hcall
      by_cases hcz : s.clock = 0
      · exfalso; apply hnot_to; rw [hcall, if_pos hcz]
      · rw [if_neg hcz] at hcall
        refine ⟨values, body, callee, retShape, hcz, rfl, hl, ?_⟩
        rcases hrun : evaluateHOLFiniteState (callEntryStateHOLFinite s callee) body with ⟨r, post⟩
        have hrun' : evaluateHOLFiniteState (callEntryStateHOLFinite s callee) body = (r, post) := hrun
        rw [hrun'] at hcall
        rcases r with _ | r'
        · exfalso; apply hnot_err; rw [hcall]
        · cases r' with
          | returned rv =>
            dsimp only at hcall
            by_cases hsh : shapeEqHOL (shapeOfHOLExact rv) retShape = true
            · rw [if_pos hsh] at hcall
              exact Or.inr ⟨rv, post, rfl, hsh, hcall⟩
            · exfalso; apply hnot_err; rw [hcall, if_neg hsh]
          | exception eid ev =>
            dsimp only at hcall
            rcases h with hn | ⟨_, hr⟩ | ⟨eid', ev', hr, hne⟩
            · rw [hcall] at hn; cases hn
            · rw [hcall] at hr; cases hr
            · rw [hcall] at hr
              injection hr with h1; injection h1 with he1 he2
              subst he1 he2
              exact Or.inl ⟨eid, ev, rfl, hne, hcall⟩
          | timeOut =>
            exfalso; apply hnot_to; rw [hcall]
          | error | «break» | «continue» =>
            exfalso; apply hnot_err; rw [hcall]
          | finalFfi event =>
            rcases h with hn | ⟨_, hr⟩ | ⟨_, _, hr, _⟩
            · rw [hcall] at hn; cases hn
            · rw [hcall] at hr; cases hr
            · rw [hcall] at hr; cases hr

private theorem resumes_not_timeOut {r : Option (PanSemResultExact 64)} (h : Resumes r) :
    r ≠ some .timeOut := by
  intro hto; rcases h with ⟨_, hr⟩ | ⟨_, _, hr, _⟩ <;> rw [hto] at hr <;> cases hr

private def finishP1Ite : ProgHOL 64 :=
  .ite (.cmp .equal (.var .local (ofString "k")) (.const 2))
    (.decCall (ofString "rl") .one (ofString "node_ref_len")
      [.load .one (.op .add [.var .local (ofString "node"), .const 48])]
      (.assign .local (ofString "payload")
        (.op .add [.var .local (ofString "payload"), .var .local (ofString "rl")])))
    .skip

private def finishP2Ite : ProgHOL 64 :=
  .ite (.cmp .equal (.var .local (ofString "k")) (.const 3))
    (.dec (ofString "i") .one (.const 0)
      (.seq
        (.while finishPass1Cond finishPass1LoopBody)
        (.decCall (ofString "vl2") .one (ofString "rlp_value_encoded_len")
          [.load .one (.op .add [.var .local (ofString "node"), .const 160]),
           .load .one (.op .add [.var .local (ofString "node"), .const 168])]
          (.assign .local (ofString "payload")
            (.op .add [.var .local (ofString "payload"), .var .local (ofString "vl2")])))))
    .skip

private def finishWriteIte : ProgHOL 64 :=
  .ite (.cmp .notEqual (.var .local (ofString "k")) (.const 3))
    (.decCall (ofString "w") .one (ofString "rlp_encode_bytes")
      [.op .add [.var .local (ofString "buf"), .var .local (ofString "off")],
       .var .local (ofString "cbuf"), .var .local (ofString "clen")]
      (.seq
        (.assign .local (ofString "off")
          (.op .add [.var .local (ofString "off"), .var .local (ofString "w")]))
        (.ite (.cmp .equal (.var .local (ofString "k")) (.const 1))
          (.decCall (ofString "w2") .one (ofString "rlp_encode_bytes")
            [.op .add [.var .local (ofString "buf"), .var .local (ofString "off")],
             .load .one (.op .add [.var .local (ofString "node"), .const 48]),
             .load .one (.op .add [.var .local (ofString "node"), .const 56])]
            (.assign .local (ofString "off")
              (.op .add [.var .local (ofString "off"), .var .local (ofString "w2")])))
          (.decCall (ofString "w3") .one (ofString "node_write_ref")
            [.load .one (.op .add [.var .local (ofString "node"), .const 48]),
             .op .add [.var .local (ofString "buf"), .var .local (ofString "off")]]
            (.assign .local (ofString "off")
              (.op .add [.var .local (ofString "off"), .var .local (ofString "w3")]))))))
    (.dec (ofString "j") .one (.const 0)
      (.seq
        (.while finishPass2Cond finishPass2LoopBody)
        (.decCall (ofString "w5") .one (ofString "rlp_encode_bytes")
          [.op .add [.var .local (ofString "buf"), .var .local (ofString "off")],
           .load .one (.op .add [.var .local (ofString "node"), .const 160]),
           .load .one (.op .add [.var .local (ofString "node"), .const 168])]
          (.assign .local (ofString "off")
            (.op .add [.var .local (ofString "off"), .var .local (ofString "w5")])))))

private def finishStores : ProgHOL 64 :=
  .seq
    (.store (.op .add [.var .local (ofString "node"), .const 8]) (.var .local (ofString "buf")))
    (.seq
      (.store (.op .add [.var .local (ofString "node"), .const 16]) (.var .local (ofString "off")))
      (.return (.const 0)))

private theorem finish_body_eq :
    sourceFnBody Guest.Software.guestFn__node_rlp_finish =
      .dec (ofString "k") .one (.load .one (.op .add [.var .local (ofString "node"), .const 0]))
        (.dec (ofString "payload") .one (.load .one (.op .add [.var .local (ofString "fr"), .const 40]))
          (.dec (ofString "cbuf") .one (.load .one (.op .add [.var .local (ofString "fr"), .const 24]))
            (.dec (ofString "clen") .one (.load .one (.op .add [.var .local (ofString "fr"), .const 32]))
              (.seq finishP1Ite
                (.seq finishP2Ite
                  (.decCall (ofString "hl") .one (ofString "rlp_list_header_len") [.var .local (ofString "payload")]
                    (.decCall (ofString "buf") .one (ofString "alloc")
                      [.op .add [.var .local (ofString "hl"), .var .local (ofString "payload")]]
                      (.seq
                        (.call (some (none, none)) (ofString "rlp_encode_list_header")
                          [.var .local (ofString "buf"), .var .local (ofString "payload")])
                        (.dec (ofString "off") .one (.var .local (ofString "hl"))
                          (.seq finishWriteIte finishStores)))))))))) := rfl

theorem eval_finishPass1_stage {F : Type}
    (s : PanSemStateFiniteExact 64 F) (Nd : List Nat)
    (nodew frw kw pay0w cbufw clenw : BitVec 64)
    (hc : s.code = originalRuntimeCode) (hAR : ArenaReady s) (hN : NodeHeap s Nd)
    (hnode_in : nodew.toNat ∈ Nd)
    (hk1 : 1 ≤ memW s nodew.toNat)
    (hkw_nat : kw.toNat = memW s nodew.toNat)
    (hpay0_nat : pay0w.toNat = memW s (frw.toNat + 40))
    (hcbuf_nat : cbufw.toNat = memW s (frw.toNat + 24))
    (hclen_nat : clenw.toNat = memW s (frw.toNat + 32))
    (hrf : RlpFrameExact s frw.toNat nodew.toNat)
    (hl_node : s.locals.lookup (ofString "node") = some (.val (.word nodew)))
    (hl_k : s.locals.lookup (ofString "k") = some (.val (.word kw)))
    (hl_pay : s.locals.lookup (ofString "payload") = some (.val (.word pay0w)))
    (hl_cbuf : s.locals.lookup (ofString "cbuf") = some (.val (.word cbufw)))
    (hl_clen : s.locals.lookup (ofString "clen") = some (.val (.word clenw)))
    (hor : (evaluateHOLFiniteState s (.seq finishP1Ite finishP2Ite)).1 = none ∨
      Resumes (evaluateHOLFiniteState s (.seq finishP1Ite finishP2Ite)).1) :
    let out := evaluateHOLFiniteState s (.seq finishP1Ite finishP2Ite)
    (∃ eid ev,
      eid ≠ ofString "TrapErr" ∧
      out.1 = some (.exception eid ev) ∧
      out.2 = { s with locals := out.2.locals, clock := out.2.clock }) ∨
    (∃ payw : BitVec 64,
      out.1 = none ∧
      out.2 = { s with locals := out.2.locals, clock := out.2.clock } ∧
      out.2.locals.lookup (ofString "node") = some (.val (.word nodew)) ∧
      out.2.locals.lookup (ofString "k") = some (.val (.word kw)) ∧
      out.2.locals.lookup (ofString "payload") = some (.val (.word payw)) ∧
      out.2.locals.lookup (ofString "cbuf") = some (.val (.word cbufw)) ∧
      out.2.locals.lookup (ofString "clen") = some (.val (.word clenw)) ∧
      payw.toNat < 2 ^ 41 ∧
      (memW s nodew.toNat = 1 →
        payw.toNat = rlpEncBytesLen s cbufw.toNat clenw.toNat +
          rlpEncBytesLen s (memW s (nodew.toNat + 48)) (memW s (nodew.toNat + 56))) ∧
      (memW s nodew.toNat = 2 →
        payw.toNat = rlpEncBytesLen s cbufw.toNat clenw.toNat +
          nodeRefBytes s (memW s (nodew.toNat + 48))) ∧
      (memW s nodew.toNat = 3 →
        payw.toNat = branchRefSum s nodew.toNat 16 +
          rlpEncBytesLen s (memW s (nodew.toNat + 160)) (memW s (nodew.toNat + 168)))) := by
  intro out; dsimp only [out]
  have hhl_val : heapLimit = 0xb0000000 := rfl
  obtain ⟨hk_le3, hal_nd, hin_nd, hw_nd, hch2_nd, hbr_nd, _, _, hleaf_v, hbr_v⟩ := hN.1 nodew.toNat hnode_in
  have h10 : ¬ ((1 : BitVec 64) = 0) := by decide
  have hor_p1 : (evaluateHOLFiniteState s finishP1Ite).1 = none ∨
      Resumes (evaluateHOLFiniteState s finishP1Ite).1 := by
    rcases seq_flow_or_exn hor with ⟨eid, ev, ha, hne, _⟩ | ⟨rv, ha, _⟩ | ⟨_, ha, _, _⟩
    · exact Or.inr (Or.inr ⟨eid, ev, congrArg Prod.fst ha, hne⟩)
    · exact Or.inr (Or.inl ⟨rv, congrArg Prod.fst ha⟩)
    · exact Or.inl (congrArg Prod.fst ha)
  have hp1_step :
      (∃ eid ev,
        eid ≠ ofString "TrapErr" ∧
        (evaluateHOLFiniteState s finishP1Ite).1 = some (.exception eid ev) ∧
        (evaluateHOLFiniteState s finishP1Ite).2 =
          { s with locals := (evaluateHOLFiniteState s finishP1Ite).2.locals,
                   clock := (evaluateHOLFiniteState s finishP1Ite).2.clock }) ∨
      (∃ (s1 : PanSemStateFiniteExact 64 F) (pay1w : BitVec 64),
        evaluateHOLFiniteState s finishP1Ite = (none, s1) ∧
        s1 = { s with locals := s1.locals, clock := s1.clock } ∧
        s1.locals.lookup (ofString "node") = some (.val (.word nodew)) ∧
        s1.locals.lookup (ofString "k") = some (.val (.word kw)) ∧
        s1.locals.lookup (ofString "payload") = some (.val (.word pay1w)) ∧
        s1.locals.lookup (ofString "cbuf") = some (.val (.word cbufw)) ∧
        s1.locals.lookup (ofString "clen") = some (.val (.word clenw)) ∧
        (memW s nodew.toNat = 2 →
          pay1w.toNat = rlpEncBytesLen s cbufw.toNat clenw.toNat +
            nodeRefBytes s (memW s (nodew.toNat + 48))) ∧
        (memW s nodew.toNat ≠ 2 → pay1w = pay0w)) := by
    dsimp only [finishP1Ite] at hor_p1 ⊢
    rw [evaluateHOLFiniteState_ite] at hor_p1 ⊢
    have hcmp2 : @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a))
        (.cmp .equal (.var .local (ofString "k")) (.const 2)) =
        some (.val (.word (if kw = 2 then 1 else 0))) := by
      simp [evalHOLExact, hl_k, Compiler.Encoders.Asm.wordCmpHOL]
    rw [hcmp2] at hor_p1 ⊢; dsimp only at hor_p1 ⊢
    by_cases hk2_eq : kw = 2
    · rw [if_pos hk2_eq, if_neg h10] at hor_p1 ⊢
      have hkw2 : memW s nodew.toNat = 2 := by rw [← hkw_nat, hk2_eq]; rfl
      have hsz2 : nodeSize (memW s nodew.toNat) = 56 := by rw [hkw2]; rfl
      have hhi_nd : nodew.toNat + nodeSize (memW s nodew.toNat) ≤ 2 ^ 64 := by
        have h1 := hin_nd.2; dsimp [Inside, nodeIvl] at h1; omega
      obtain ⟨chw, hld_ch, hchw_nat⟩ := eval_load_memW_of_wordsOK (s := s) (base := nodew)
        (off := 48) (len := nodeSize (memW s nodew.toNat))
        hw_nd rfl (by omega) hhi_nd
        (e := .op .add [.var .local (ofString "node"), .const 48])
        (by simp [evalHOLExact, evalListHOLExact, hl_node, wordOpHOL, wordOp, valueIsWord, valueWord, BitVec.add_zero])
      have hch_in : RootIn Nd chw.toNat := by rw [hchw_nat]; exact hch2_nd hkw2
      rcases eval_decCall_node_ref_len_exact s Nd "rl" _ chw
          (.assign .local (ofString "payload")
            (.op .add [.var .local (ofString "payload"), .var .local (ofString "rl")]))
          hc hN hch_in hld_ch hor_p1 with
        ⟨eid, ev, hne, hex, hst⟩ | ⟨rlw, mid, hrl_eq, hmid_eq, _, hdec⟩
      · left
        refine ⟨eid, ev, hne, hex, ?_⟩
        rw [hst]
      · right
        rw [hdec]
        have hm_pay : mid.locals.lookup (ofString "payload") = some (.val (.word pay0w)) := by
          rw [hmid_eq]; simp [HolFiniteMapExact.lookup_update, FUPDATE, hl_pay,
            show ofString "rl" ≠ ofString "payload" by decide]
        have hm_rl : mid.locals.lookup (ofString "rl") = some (.val (.word rlw)) := by
          rw [hmid_eq]; simp [HolFiniteMapExact.lookup_update, FUPDATE]
