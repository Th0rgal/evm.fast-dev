theorem ValFrom.of_mem_below_heap {F : Type}
    {s post : PanSemStateFiniteExact 64 F} {Nd Nd' : List Nat}
    {V : List (Nat × Nat)} {vp vlen : Nat}
    (ha : ArenaReady s) (hn : NodeHeap s Nd)
    (hsub : ∀ m ∈ Nd, m ∈ Nd')
    (hkinds : ∀ m ∈ Nd, memW post m = memW s m)
    (hm_lt : ∀ a : BitVec 64, a.toNat + 8 ≤ globN s "heap_ptr" → post.memory a = s.memory a)
    (hvf : ValFrom s Nd V vp vlen) :
    ValFrom post Nd' V vp vlen := by
  rcases hvf with h0 | hmem | ⟨m, hm, hk1, rfl, rfl⟩ | ⟨m, hm, hk3, rfl, rfl⟩
  · exact Or.inl h0
  · exact Or.inr (Or.inl hmem)
  · have hsz : nodeSize (memW s m) = 64 := by simp [nodeSize, hk1]
    have h48 := nodeHeap_memW_eq_below_heap_aligned ha hn hm_lt hm (off := 48) (by omega)
    have h56 := nodeHeap_memW_eq_below_heap_aligned ha hn hm_lt hm (off := 56) (by omega)
    exact Or.inr (Or.inr (Or.inl ⟨m, hsub m hm, (hkinds m hm).trans hk1, h48.symm, h56.symm⟩))
  · have hsz : nodeSize (memW s m) = 176 := by simp [nodeSize, hk3]
    have h160 := nodeHeap_memW_eq_below_heap_aligned ha hn hm_lt hm (off := 160) (by omega)
    have h168 := nodeHeap_memW_eq_below_heap_aligned ha hn hm_lt hm (off := 168) (by omega)
    exact Or.inr (Or.inr (Or.inr ⟨m, hsub m hm, (hkinds m hm).trans hk3, h160.symm, h168.symm⟩))

