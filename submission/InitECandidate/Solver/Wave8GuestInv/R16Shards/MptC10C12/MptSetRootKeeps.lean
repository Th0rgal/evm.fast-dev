         Resumes (evaluateHOLFiniteState s (.decCall x .one (ofString "scratch_alloc") [.const 40] cont)).1) :
    ∃ (q : BitVec 64) (u : PanSemStateFiniteExact 64 F),
      u.code = originalRuntimeCode ∧
      u.memaddrs = s.memaddrs ∧
      u.shMemaddrs = s.shMemaddrs ∧
