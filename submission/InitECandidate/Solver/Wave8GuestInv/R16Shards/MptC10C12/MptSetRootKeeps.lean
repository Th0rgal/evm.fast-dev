private def noAnyExnProg (good : MlS → Bool) : ProgHOL 64 → Bool
  | .dec _ _ _ body => noAnyExnProg good body
  | .seq first second => noAnyExnProg good first && noAnyExnProg good second
  | .ite _ yes no => noAnyExnProg good yes && noAnyExnProg good no
  | .while _ body => noAnyExnProg good body
  | .decCall _ _ fname _ cont => good fname && noAnyExnProg good cont
  | .call none fname _ => good fname
  | .call (some (none, none)) fname _ => good fname
  | .call (some (some (.local, _), none)) fname _ => good fname
  | .assign .local _ _ => true
  | .store _ _ | .storeByte _ _ => true
  | .primitive _ _ _ => true
  | .skip | .break | .continue | .annot _ _ | .return _ => true
  | _ => false

private theorem lex_of_sc {a1 a2 b1 b2 : Nat} (h : a1 < a2 ∨ a1 = a2 ∧ b1 < b2) :
    Prod.Lex (· < ·) (· < ·) (a1, b1) (a2, b2) := by
  rcases h with h | ⟨rfl, h⟩
  · exact Prod.Lex.left _ _ h
  · exact Prod.Lex.right _ h

private theorem evaluate_noAnyExnProg {F : Type} (good : MlS → Bool)
    (hgood : ∀ function, good function = true → ∀ values body callee rs,
      PanSemStateFiniteExact.lookupCodeHOLFinite originalRuntimeCode.lookup function values =
        some (body, callee, rs) →
      noAnyExnProg good body = true)
    (program : ProgHOL 64) (supported : noAnyExnProg good program = true)
    (state : PanSemStateFiniteExact 64 F) (code : state.code = originalRuntimeCode) :
    ∀ eid ev, (evaluateHOLFiniteState state program).1 ≠ some (.exception eid ev) := by
  cases shape : program with
  | skip => rw [evaluateHOLFiniteState_skip]; intro _ _ h; cases h
  | «break» => rw [evaluateHOLFiniteState_break]; intro _ _ h; cases h
  | «continue» => rw [evaluateHOLFiniteState_continue]; intro _ _ h; cases h
  | annot _ _ => rw [evaluateHOLFiniteState_annot]; intro _ _ h; cases h
  | «return» _ =>
    rw [evaluateHOLFiniteState_return]
    split
    · intro _ _ h; cases h
    · split <;> (intro _ _ h; cases h)
  | assign kind name value =>
    cases kind with
    | global => simp [shape, noAnyExnProg] at supported
    | «local» =>
      rw [evaluateHOLFiniteState_assign]
      split
      · intro _ _ h; cases h
      · split <;> (intro _ _ h; cases h)
  | primitive name op args =>
    rw [evaluateHOLFiniteState_primitive]
    split
    · intro _ _ h; cases h
    · split
      · intro _ _ h; cases h
      · split <;> (intro _ _ h; cases h)
  | store dst val =>
    rw [evaluateHOLFiniteState_store]
    split
    · split
      · split <;> (intro _ _ h; cases h)
      · intro _ _ h; cases h
    · intro _ _ h; cases h
  | storeByte dst val =>
    rw [evaluateHOLFiniteState_storeByte]
    split
    · split
      · split <;> (intro _ _ h; cases h)
      · intro _ _ h; cases h
    · intro _ _ h; cases h
  | dec name kind initializer body =>
    have child : noAnyExnProg good body = true := by simpa only [shape, noAnyExnProg] using supported
    rw [evaluateHOLFiniteState_dec_total]
    dsimp only
    split
    · intro _ _ h; cases h
    · rename_i val _
      split
      · have ih := evaluate_noAnyExnProg good hgood body child (setVarHOLFinite name val state) code
        rcases hrun : evaluateHOLFiniteState (setVarHOLFinite name val state) body with ⟨res, st⟩
        rw [hrun] at ih; exact ih
      · intro _ _ h; cases h
  | seq first second =>
    have children : noAnyExnProg good first = true ∧ noAnyExnProg good second = true := by
      simpa only [shape, noAnyExnProg, Bool.and_eq_true] using supported
    have ih1 := evaluate_noAnyExnProg good hgood first children.1 state code
    have remaining := evaluateHOLFiniteState_clock_le state first
    have meta' := InitECandidate.Solver.GuestGlobalKeep.evaluateHOLFiniteState_metadata state first
    rw [evaluateHOLFiniteState_seq_line780]
    rcases firstRun : evaluateHOLFiniteState state first with ⟨result, middle⟩
    rw [firstRun] at ih1 remaining meta'
    dsimp only at ih1 remaining meta' ⊢
    cases result with
    | none =>
      have mclock : middle.clock ≤ state.clock := remaining
      exact evaluate_noAnyExnProg good hgood second children.2 middle (meta'.1.trans code)
    | some _ => exact ih1
  | ite condition yes no =>
    have children : noAnyExnProg good yes = true ∧ noAnyExnProg good no = true := by
      simpa only [shape, noAnyExnProg, Bool.and_eq_true] using supported
    rw [evaluateHOLFiniteState_ite]
    split
    · split
      · exact evaluate_noAnyExnProg good hgood no children.2 state code
      · exact evaluate_noAnyExnProg good hgood yes children.1 state code
    · intro _ _ h; cases h
  | «while» condition body =>
    have child : noAnyExnProg good body = true := by simpa only [shape, noAnyExnProg] using supported
    rw [evaluateHOLFiniteState_while_total]
    split
    · split
      · split
        · intro _ _ h; cases h
        · rename_i nonzero
          dsimp only
          rw [fixClockHOLFinite_evaluateState]
          have ih1 := evaluate_noAnyExnProg good hgood body child (decClockHOLFinite state) code
          have remaining := evaluateHOLFiniteState_clock_le (decClockHOLFinite state) body
          have meta' := InitECandidate.Solver.GuestGlobalKeep.evaluateHOLFiniteState_metadata (decClockHOLFinite state) body
          rcases bodyRun : evaluateHOLFiniteState (decClockHOLFinite state) body with ⟨result, middle⟩
          rw [bodyRun] at ih1 remaining meta'
          dsimp only at ih1 remaining meta' ⊢
          have smaller : middle.clock < state.clock := by
            change middle.clock ≤ state.clock - 1 at remaining
            omega
          have mCode : middle.code = originalRuntimeCode := meta'.1.trans code
          cases result with
          | none =>
            exact evaluate_noAnyExnProg good hgood (.while condition body)
              (by simpa [noAnyExnProg] using child) middle mCode
          | some r =>
            cases r with
            | «continue» =>
              exact evaluate_noAnyExnProg good hgood (.while condition body)
                (by simpa [noAnyExnProg] using child) middle mCode
            | «break» | returned _ | finalFfi _ | error | timeOut =>
              intro _ _ h; cases h
            | exception _ _ => exact ih1
      · intro _ _ h; cases h
    · intro _ _ h; cases h
  | call ret fname arguments =>
    rcases ret with _ | ⟨dest, hdl⟩
    · have hfn : good fname = true := by simpa only [shape, noAnyExnProg] using supported
      rw [evaluateHOLFiniteState_call]
      rcases evalListHOLFinite state
          (h := fun a => Classical.propDecidable (state.memaddrs a)) arguments with _ | values
      · intro _ _ h; cases h
      · dsimp only
        rcases found : lookupCodeHOLFinite state.code.lookup fname values with _ | ⟨body, callee, rs⟩
        · intro _ _ h; cases h
        · dsimp only
          have found' : lookupCodeHOLFinite originalRuntimeCode.lookup fname values =
              some (body, callee, rs) := by rwa [← code]
          have bodyOk := hgood fname hfn values body callee rs found'
          split
          · intro _ _ h; cases h
          · have ih := evaluate_noAnyExnProg good hgood body bodyOk
              (callEntryStateHOLFinite state callee) code
            have cl := evaluateHOLFiniteState_clock_le (callEntryStateHOLFinite state callee) body
            rcases hrun : evaluateHOLFiniteState (callEntryStateHOLFinite state callee) body with ⟨res, st⟩
            rw [hrun] at ih cl; dsimp only at ih cl ⊢
            change st.clock ≤ state.clock - 1 at cl
            have small : st.clock < state.clock := by omega
            cases res with
            | none => intro _ _ h; cases h
            | some r =>
              cases r with
              | returned _ => dsimp only; split <;> (intro _ _ h; cases h)
              | exception _ _ => exact ih
              | _ => intro _ _ h; cases h
    · rcases hdl with _ | _
      · rcases dest with _ | ⟨vk, vnm⟩
        · have hfn : good fname = true := by simpa only [shape, noAnyExnProg] using supported
          rw [evaluateHOLFiniteState_call]
          rcases evalListHOLFinite state
              (h := fun a => Classical.propDecidable (state.memaddrs a)) arguments with _ | values
          · intro _ _ h; cases h
          · dsimp only
            rcases found : lookupCodeHOLFinite state.code.lookup fname values with _ | ⟨body, callee, rs⟩
            · intro _ _ h; cases h
            · dsimp only
              have found' : lookupCodeHOLFinite originalRuntimeCode.lookup fname values =
                  some (body, callee, rs) := by rwa [← code]
              have bodyOk := hgood fname hfn values body callee rs found'
              split
              · intro _ _ h; cases h
              · have ih := evaluate_noAnyExnProg good hgood body bodyOk
                  (callEntryStateHOLFinite state callee) code
                have cl := evaluateHOLFiniteState_clock_le (callEntryStateHOLFinite state callee) body
                rcases hrun : evaluateHOLFiniteState (callEntryStateHOLFinite state callee) body with ⟨res, st⟩
                rw [hrun] at ih cl; dsimp only at ih cl ⊢
                change st.clock ≤ state.clock - 1 at cl
                have small : st.clock < state.clock := by omega
                cases res with
                | none => intro _ _ h; cases h
                | some r =>
                  cases r with
                  | returned _ => dsimp only; split <;> (intro _ _ h; cases h)
                  | exception _ _ => exact ih
                  | _ => intro _ _ h; cases h
        · cases vk with
          | global => simp [shape, noAnyExnProg] at supported
          | «local» =>
            have hfn : good fname = true := by simpa only [shape, noAnyExnProg] using supported
            rw [evaluateHOLFiniteState_call]
            rcases evalListHOLFinite state
                (h := fun a => Classical.propDecidable (state.memaddrs a)) arguments with _ | values
            · intro _ _ h; cases h
            · dsimp only
              rcases found : lookupCodeHOLFinite state.code.lookup fname values with _ | ⟨body, callee, rs⟩
              · intro _ _ h; cases h
              · dsimp only
                have found' : lookupCodeHOLFinite originalRuntimeCode.lookup fname values =
                    some (body, callee, rs) := by rwa [← code]
                have bodyOk := hgood fname hfn values body callee rs found'
                split
                · intro _ _ h; cases h
                · have ih := evaluate_noAnyExnProg good hgood body bodyOk
                    (callEntryStateHOLFinite state callee) code
                  have cl := evaluateHOLFiniteState_clock_le (callEntryStateHOLFinite state callee) body
                  rcases hrun : evaluateHOLFiniteState (callEntryStateHOLFinite state callee) body with ⟨res, st⟩
                  rw [hrun] at ih cl; dsimp only at ih cl ⊢
                  change st.clock ≤ state.clock - 1 at cl
                  have small : st.clock < state.clock := by omega
                  cases res with
                  | none => intro _ _ h; cases h
                  | some r =>
                    cases r with
                    | returned _ =>
                      dsimp only; split
                      · split <;> (intro _ _ h; cases h)
                      · intro _ _ h; cases h
                    | exception _ _ => exact ih
                    | _ => intro _ _ h; cases h
      · simp [shape, noAnyExnProg] at supported
  | decCall name kind function arguments continuation =>
    have children : good function = true ∧ noAnyExnProg good continuation = true := by
      simpa only [shape, noAnyExnProg, Bool.and_eq_true] using supported
    rw [evaluateHOLFiniteState_decCall_fixClockRewrite]
    rcases evalListHOLFinite state
        (h := fun a => Classical.propDecidable (state.memaddrs a)) arguments with _ | values
    · intro _ _ h; cases h
    · dsimp only
      rcases found : lookupCodeHOLFinite state.code.lookup function values with _ | ⟨body, callee, rs⟩
      · intro _ _ h; cases h
      · dsimp only
        have found' : lookupCodeHOLFinite originalRuntimeCode.lookup function values =
            some (body, callee, rs) := by rwa [← code]
        have bodyOk := hgood function children.1 values body callee rs found'
        split
        · intro _ _ h; cases h
        · rename_i nonzero
          have ih := evaluate_noAnyExnProg good hgood body bodyOk
            (callEntryStateHOLFinite state callee) code
          have meta' := InitECandidate.Solver.GuestGlobalKeep.evaluateHOLFiniteState_metadata
            (callEntryStateHOLFinite state callee) body
          have cl := evaluateHOLFiniteState_clock_le (callEntryStateHOLFinite state callee) body
          rcases hrun : evaluateHOLFiniteState (callEntryStateHOLFinite state callee) body with ⟨res, st⟩
          rw [hrun] at ih meta' cl; dsimp only at ih meta' cl ⊢
          change st.clock ≤ state.clock - 1 at cl
          have small : st.clock < state.clock := by omega
          have stCode : st.code = originalRuntimeCode := meta'.1.trans code
          cases res with
          | none => intro _ _ h; cases h
          | some r =>
            cases r with
            | returned v =>
              dsimp only
              split
              · set resumed := setVarHOLFinite name v { st with locals := state.locals }
                have smallR : resumed.clock < state.clock := small
                exact evaluate_noAnyExnProg good hgood continuation children.2 resumed stCode
              · intro _ _ h; cases h
            | exception _ _ => exact ih
            | _ => intro _ _ h; cases h
  | _ => simp [shape, noAnyExnProg] at supported
termination_by (state.clock, sizeOf program)
decreasing_by
  all_goals
    simp_wf
    apply lex_of_sc
    try subst shape
    try simp only [setVarHOLFinite, decClockHOLFinite, callEntryStateHOLFinite,
      ProgHOL.seq.sizeOf_spec, ProgHOL.ite.sizeOf_spec, ProgHOL.dec.sizeOf_spec,
      ProgHOL.while.sizeOf_spec, ProgHOL.decCall.sizeOf_spec, ProgHOL.call.sizeOf_spec, true_and]
    first
      | exact Or.inl smallR
      | exact Or.inl smaller
      | exact Or.inl small
      | omega
      | (rcases Nat.lt_or_eq_of_le mclock with h | h
         · exact Or.inl h
         · exact Or.inr ⟨h, by simp +arith⟩)
      | exact Or.inr ⟨rfl, by simp +arith⟩

private def keccakCallees_sc (f : MlS) : Bool :=
  f == ofString "memzero" ||
  f == ofString "memcpy" ||
  f == ofString "keccak_f1600" ||
  f == ofString "keccak_absorb_block" ||
  f == ofString "keccak256"

private theorem keccakCallees_sc_good :
    ∀ f, keccakCallees_sc f = true → ∀ values body callee rs,
      PanSemStateFiniteExact.lookupCodeHOLFinite originalRuntimeCode.lookup f values =
        some (body, callee, rs) →
      noAnyExnProg keccakCallees_sc body = true := by
  have hb0 : noAnyExnProg keccakCallees_sc (sourceFnBody Guest.Software.guestFn_memzero) = true := by decide
  have hb1 : noAnyExnProg keccakCallees_sc (sourceFnBody Guest.Software.guestFn_memcpy) = true := by decide
  have hb2 : noAnyExnProg keccakCallees_sc (sourceFnBody Guest.Software.guestFn_keccak_f1600) = true := by decide
  have hb3 : noAnyExnProg keccakCallees_sc (sourceFnBody Guest.Software.guestFn_keccak_absorb_block) = true := by decide
  have hb4 : noAnyExnProg keccakCallees_sc (sourceFnBody Guest.Software.guestFn_keccak256) = true := by decide
  have hl0 : originalRuntimeCode.lookup (ofString "memzero") =
      some ([(ofString "dst", .one), (ofString "n", .one)],
        sourceFnBody Guest.Software.guestFn_memzero, .one) :=
    lookup_of_guestAst_getElem 17 (by rw [guestAst_len]; decide)
      (extractFn Guest.Software.guestFn_memzero) rfl
  have hl1 := R16Shards.lookup_memcpy
  have hl2 : originalRuntimeCode.lookup (ofString "keccak_f1600") =
      some ([(ofString "stp", .one)], sourceFnBody Guest.Software.guestFn_keccak_f1600, .one) :=
    lookup_of_guestAst_getElem 101 (by rw [guestAst_len]; decide)
      (extractFn Guest.Software.guestFn_keccak_f1600) rfl
  have hl3 : originalRuntimeCode.lookup (ofString "keccak_absorb_block") =
      some ([(ofString "stp", .one), (ofString "blk", .one)],
        sourceFnBody Guest.Software.guestFn_keccak_absorb_block, .one) :=
    lookup_of_guestAst_getElem 102 (by rw [guestAst_len]; decide)
      (extractFn Guest.Software.guestFn_keccak_absorb_block) rfl
  have hl4 : originalRuntimeCode.lookup (ofString "keccak256") =
      some ([(ofString "p", .one), (ofString "n", .one), (ofString "out", .one)],
        sourceFnBody Guest.Software.guestFn_keccak256, .one) :=
    lookup_of_guestAst_getElem 103 (by rw [guestAst_len]; decide)
      (extractFn Guest.Software.guestFn_keccak256) rfl
  intro f hf values body callee rs hfound
  obtain ⟨params, rs', hinst⟩ := InitECandidate.Solver.GuestGlobalKeep.lookupCode_installed hfound
  simp only [keccakCallees_sc, Bool.or_eq_true, beq_iff_eq] at hf
  rcases hf with (((rfl | rfl) | rfl) | rfl) | rfl
  · rw [hl0] at hinst; rw [← (Prod.mk.inj (Prod.mk.inj (Option.some.inj hinst)).2).1]; exact hb0
  · rw [hl1] at hinst; rw [← (Prod.mk.inj (Prod.mk.inj (Option.some.inj hinst)).2).1]; exact hb1
  · rw [hl2] at hinst; rw [← (Prod.mk.inj (Prod.mk.inj (Option.some.inj hinst)).2).1]; exact hb2
  · rw [hl3] at hinst; rw [← (Prod.mk.inj (Prod.mk.inj (Option.some.inj hinst)).2).1]; exact hb3
  · rw [hl4] at hinst; rw [← (Prod.mk.inj (Prod.mk.inj (Option.some.inj hinst)).2).1]; exact hb4

theorem eval_node_hash_resumes {F : Type}
    (s : PanSemStateFiniteExact 64 F) (Nd : List Nat) (nodew : BitVec 64)
    (hc : s.code = originalRuntimeCode) (hAR : ArenaReady s) (hN : NodeHeap s Nd)
    (hvs : NodeHeapValuePtrOK s Nd)
    (hkc_disj : ∀ o ∈ nodeExtents s Nd,
      Disj (bufferRegion s ("keccak_pad", 136)) o ∧
      Disj (bufferRegion s ("keccak_st", 200)) o)
    (hkc_alloc : ∀ iv ∈ keccakBufIvls s, 0 < iv.2 →
      iv.1 + iv.2 ≤ globN s "heap_ptr" ∨ globN s "scratch_ptr" ≤ iv.1)
    (hnode_in : nodew.toNat ∈ Nd)
    (hl_node : s.locals.lookup (ofString "node") = some (.val (.word nodew)))
    (hres : Resumes (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_hash)).1) :
    let out := evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_hash)
    (∃ eid ev,
      eid ≠ ofString "TrapErr" ∧
      out.1 = some (.exception eid ev) ∧
      out.2.code = originalRuntimeCode ∧
      HeapByteEff s out.2 (nodeCacheIvls Nd ++ keccakBufIvls s ++ [freeGap s]) ["heap_ptr", "scratch_ptr"] ∧
      globN out.2 "scratch_ptr" ≤ globN s "scratch_ptr" ∧
      NodeHeap out.2 Nd ∧
      nodeExtents out.2 Nd = nodeExtents s Nd ∧
      keccakBufIvls out.2 = keccakBufIvls s ∧
      NodeHeapValuePtrOK out.2 Nd) ∨
    (∃ hw : BitVec 64,
      out.1 = some (.returned (.val (.word hw))) ∧
      out.2.code = originalRuntimeCode ∧
      HeapByteEff s out.2 (nodeCacheIvls Nd ++ keccakBufIvls s) ["heap_ptr", "scratch_ptr"] ∧
      globN out.2 "scratch_ptr" = globN s "scratch_ptr" ∧
      NodeHeap out.2 Nd ∧
      nodeExtents out.2 Nd = nodeExtents s Nd ∧
      NodeHeapValuePtrOK out.2 Nd) := by
  intro out; dsimp only [out]
  rcases hres with ⟨rv, hret⟩ | ⟨eid0, ev0, hexn, hne0⟩
  · obtain ⟨hw, hrv, hc_p, heff_p, hsp_p, hN_p, hext_p, hvs_p⟩ :=
      eval_node_hash_returned s Nd nodew rv hc hAR hN hvs hkc_disj hkc_alloc hnode_in hl_node hret
    subst hrv
    exact Or.inr ⟨hw, hret, hc_p, heff_p, hsp_p, hN_p, hext_p, hvs_p⟩
  · left
    have hb : sourceFnBody Guest.Software.guestFn_node_hash =
        .dec (ofString "cached") .one
          (.load .one (.op .add [.var .local (ofString "node"), .const 24]))
          (.seq
            (.ite (.cmp .notEqual (.var .local (ofString "cached")) (.const 0))
              (.return (.var .local (ofString "cached")))
              .skip)
            (.decCall (ofString "r") (.comb [.one, .one]) (ofString "node_rlp")
              [.var .local (ofString "node")]
              (.decCall (ofString "h") .one (ofString "alloc") [.const 32]
                (.seq
                  (.call (some (none, none)) (ofString "keccak256")
                    [.rfield 0 (.var .local (ofString "r")),
                     .rfield 1 (.var .local (ofString "r")),
                     .var .local (ofString "h")])
                  (.seq
                    (.store (.op .add [.var .local (ofString "node"), .const 24]) (.var .local (ofString "h")))
                    (.return (.var .local (ofString "h")))))))) := rfl
    have hhe_264 : heapEnd < 2 ^ 64 := by rw [heapEnd_val]; decide
    have hhl_he : heapLimit ≤ heapEnd := by rw [heapEnd_val]; decide
    obtain ⟨_, _, hin_n, hw_n, _⟩ := hN.1 nodew.toNat hnode_in
    have hsz_n := nodeSize_ge32 (memW s nodew.toNat)
    have hhi_n_he : nodew.toNat + nodeSize (memW s nodew.toNat) ≤ heapEnd := by
      have h1 := hin_n.2
      have h2 : globN s "heap_ptr" ≤ heapLimit := hAR.2.2.1
      dsimp [nodeIvl] at h1; omega
    have hhi_n : nodew.toNat + nodeSize (memW s nodew.toNat) ≤ 2 ^ 64 := by omega
    obtain ⟨cw, hld24, _⟩ := eval_load_memW_of_wordsOK (base := nodew) (off := 24)
      hw_n (by decide) (by omega) hhi_n
      (e := .op .add [.var .local (ofString "node"), .const 24])
      (by simp [evalHOLExact, evalListHOLExact, hl_node, wordOpHOL, wordOp, valueIsWord, valueWord, BitVec.add_zero])
    have hsh_cw : shapeEqHOL .one (shapeOfHOLExact (.val (.word cw) : ValueHOL 64)) = true := by
      simp [shapeOfHOLExact, shapeEqHOL]
    rw [hb, evaluateHOLFiniteState_dec_total] at hexn ⊢; dsimp only at hexn ⊢
    rw [hld24] at hexn ⊢; dsimp only at hexn ⊢; rw [if_pos hsh_cw] at hexn ⊢; dsimp only at hexn ⊢
    set s1 := setVarHOLFinite (ofString "cached") (.val (.word cw)) s
    have hs1_cw : s1.locals.lookup (ofString "cached") = some (.val (.word cw)) := by
      simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
    have hs1_node : s1.locals.lookup (ofString "node") = some (.val (.word nodew)) := by
      simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hl_node,
        show ofString "cached" ≠ ofString "node" by decide]
    rw [evaluateHOLFiniteState_seq_line780] at hexn ⊢
    have hcmp_cw : @evalHOLExact 64 F _ s1.toExact (fun a => Classical.propDecidable (s1.memaddrs a))
        (.cmp .notEqual (.var .local (ofString "cached")) (.const 0)) =
        some (.val (.word (if cw ≠ 0 then 1 else 0))) := by
      simp [evalHOLExact, hs1_cw, Compiler.Encoders.Asm.wordCmpHOL]
    by_cases hcw_nz : cw ≠ 0
    · exfalso
      rw [evaluateHOLFiniteState_ite, hcmp_cw, if_pos hcw_nz] at hexn; dsimp only at hexn
      have h10 : ¬ ((1 : BitVec 64) = 0) := by decide
      rw [if_neg h10, evaluateHOLFiniteState_return] at hexn
      simp [evalHOLExact, hs1_cw, shapeOfHOLExact, sizeOfShapeWithContextHOL] at hexn
    · have hcw_eq0 : cw = 0 := Classical.not_not.mp hcw_nz
      have hite1 : evaluateHOLFiniteState s1
          (.ite (.cmp .notEqual (.var .local (ofString "cached")) (.const 0))
            (.return (.var .local (ofString "cached"))) .skip) = (none, s1) := by
        rw [evaluateHOLFiniteState_ite, hcmp_cw]
        simp [hcw_eq0, evaluateHOLFiniteState_skip]
      rw [hite1] at hexn ⊢; dsimp only at hexn ⊢
      have hs1_AR : ArenaReady s1 := ((HeapByteEff.refl hAR [] []).locals_clock s1.locals s1.clock).arena
      have hs1_N : NodeHeap s1 Nd :=
        (nodeHeap_of_heapByteEff_disj hAR hN
          ((HeapByteEff.refl hAR [] []).locals_clock s1.locals s1.clock)
          (fun _ h => by simp at h)).1
      have hs1_vs : NodeHeapValuePtrOK s1 Nd :=
        nodeValuesSafe_of_heapByteEff (extra := []) hAR hN
          ((HeapByteEff.refl hAR (nodeCacheIvls Nd ++ keccakBufIvls s ++ []) []).locals_clock s1.locals s1.clock)
          rfl (fun _ h => by simp at h) hkc_disj hvs
      let kcStmt : ProgHOL 64 :=
        .call (some (none, none)) (ofString "keccak256")
          [.rfield 0 (.var .local (ofString "r")),
           .rfield 1 (.var .local (ofString "r")),
           .var .local (ofString "h")]
      let tailStmt : ProgHOL 64 :=
        .seq
          (.store (.op .add [.var .local (ofString "node"), .const 24]) (.var .local (ofString "h")))
          (.return (.var .local (ofString "h")))
      let contK : ProgHOL 64 := .seq kcStmt tailStmt
      let contR : ProgHOL 64 := .decCall (ofString "h") .one (ofString "alloc") [.const 32] contK
      change (evaluateHOLFiniteState s1
          (.decCall (ofString "r") (.comb [.one, .one]) (ofString "node_rlp")
            [.var .local (ofString "node")] contR)).1 =
        some (.exception eid0 ev0) at hexn
      have hor_dc : (evaluateHOLFiniteState s1
          (.decCall (ofString "r") (.comb [.one, .one]) (ofString "node_rlp")
            [.var .local (ofString "node")] contR)).1 = none ∨
        Resumes (evaluateHOLFiniteState s1
          (.decCall (ofString "r") (.comb [.one, .one]) (ofString "node_rlp")
            [.var .local (ofString "node")] contR)).1 :=
        Or.inr (Or.inr ⟨eid0, ev0, hexn, hne0⟩)
      rcases eval_decCall_node_rlp_resumes_step s1 Nd "r" (.var .local (ofString "node")) nodew contR
          hc hs1_AR hs1_N hs1_vs hkc_disj hkc_alloc (by simp [evalHOLExact, hs1_node]) hnode_in hor_dc with
        ⟨eid, ev, hne, hex_dc, hs2_c, hs2_loc, heff_s1_s2, hsp_s2, hN_s2, hext_s2, hkc_s2, hvs_s2⟩ |
        ⟨rpw, rlw, mr, hmr_c, hmr_loc, heff_s1_mr, _, hN_mr, _, _, _, hor_mr, hmr_fst, _⟩
      · set s2 := (evaluateHOLFiniteState s1
          (.decCall (ofString "r") (.comb [.one, .one]) (ofString "node_rlp")
            [.var .local (ofString "node")] contR)).2
        have hdc_pair : evaluateHOLFiniteState s1
            (.decCall (ofString "r") (.comb [.one, .one]) (ofString "node_rlp")
              [.var .local (ofString "node")] contR) =
            (some (.exception eid ev), s2) := Prod.ext hex_dc rfl
        have hdc_pair' : evaluateHOLFiniteState s1
            (.decCall (ofString "r") (.comb [.one, .one]) (ofString "node_rlp")
              [.var .local (ofString "node")]
              (.decCall (ofString "h") .one (ofString "alloc") [.const 32]
                (.seq
                  (.call (some (none, none)) (ofString "keccak256")
                    [.rfield 0 (.var .local (ofString "r")),
                     .rfield 1 (.var .local (ofString "r")),
                     .var .local (ofString "h")])
                  (.seq
                    (.store (.op .add [.var .local (ofString "node"), .const 24]) (.var .local (ofString "h")))
                    (.return (.var .local (ofString "h"))))))) =
            (some (.exception eid ev), s2) := hdc_pair
        rw [hdc_pair']; dsimp only
        set s_out : PanSemStateFiniteExact 64 F :=
          { s2 with
            locals := HolFiniteMapExact.resVarEq s2.locals
              (ofString "cached", s.locals.lookup (ofString "cached")) }
        have heff_out : HeapByteEff s s_out
            (nodeCacheIvls Nd ++ keccakBufIvls s ++ [freeGap s]) ["heap_ptr", "scratch_ptr"] :=
          (((HeapByteEff.refl hAR _ _).locals_clock s1.locals s1.clock).trans heff_s1_s2).locals_clock
            s_out.locals s_out.clock
        have hN_out : NodeHeap s_out Nd :=
          (nodeHeap_of_heapByteEff_disj heff_s1_s2.arena hN_s2
            ((HeapByteEff.refl heff_s1_s2.arena [] []).locals_clock s_out.locals s_out.clock)
            (fun _ h => by simp at h)).1
        have hvs_out : NodeHeapValuePtrOK s_out Nd :=
          nodeValuesSafe_of_heapByteEff (extra := []) heff_s1_s2.arena hN_s2
            ((HeapByteEff.refl heff_s1_s2.arena (nodeCacheIvls Nd ++ keccakBufIvls s2 ++ []) []).locals_clock
              s_out.locals s_out.clock)
            rfl (fun _ h => by simp at h)
            (by
              have hkp : globN s2 "keccak_pad" = globN s "keccak_pad" := by
                unfold globN; rw [← heff_s1_s2.globals (ofString "keccak_pad") (by decide)]; rfl
              have hks : globN s2 "keccak_st" = globN s "keccak_st" := by
                unfold globN; rw [← heff_s1_s2.globals (ofString "keccak_st") (by decide)]; rfl
              rw [hext_s2]
              intro o ho; simp only [bufferRegion, hkp, hks]; exact hkc_disj o ho)
            hvs_s2
        exact ⟨eid, ev, hne, rfl, hs2_c, heff_out, hsp_s2, hN_out, hext_s2, hkc_s2, hvs_out⟩
      · exfalso
        rw [hmr_fst] at hexn
        dsimp only [contR] at hexn
        have hnt_dc : (evaluateHOLFiniteState mr
            (.decCall (ofString "h") .one (ofString "alloc") [.const 32] contK)).1 ≠ some .timeOut := by
          rw [hexn]; simp
        obtain ⟨hp, n32, q, m1, hn32_ev, _, _, _, _, _, _, _, hm1_g, _, hm1_loc,
            heff_m1, hnt_m1, hres_m1, hdc_eq⟩ :=
          eval_decCall_alloc_resumes mr "h" (.const 32) contK [] ["heap_ptr"]
            hmr_c heff_s1_mr.arena (by simp) hnt_dc (Or.inr ⟨eid0, ev0, hexn, hne0⟩)
        have hm1_fst := congrArg Prod.fst hdc_eq
        rw [hm1_fst] at hexn
        have hm1_c : m1.code = originalRuntimeCode := heff_m1.arena.1.code
        have hmr_r : mr.locals.lookup (ofString "r") = some (.rStruct [.val (.word rpw), .val (.word rlw)]) := by
          rw [hmr_loc]; simp [HolFiniteMapExact.lookup_update, FUPDATE]
        have hmr_node : mr.locals.lookup (ofString "node") = some (.val (.word nodew)) := by
          rw [hmr_loc]; simp [HolFiniteMapExact.lookup_update, FUPDATE, hs1_node,
            show ofString "r" ≠ ofString "node" by decide]
        have hm1_h : m1.locals.lookup (ofString "h") = some (.val (.word hp)) := by
          rw [hm1_loc]; simp [HolFiniteMapExact.lookup_update, FUPDATE]
        have hm1_r : m1.locals.lookup (ofString "r") = some (.rStruct [.val (.word rpw), .val (.word rlw)]) := by
          rw [hm1_loc]; simp [HolFiniteMapExact.lookup_update, FUPDATE, hmr_r,
            show ofString "h" ≠ ofString "r" by decide]
        have hm1_node : m1.locals.lookup (ofString "node") = some (.val (.word nodew)) := by
          rw [hm1_loc]; simp [HolFiniteMapExact.lookup_update, FUPDATE, hmr_node,
            show ofString "h" ≠ ofString "node" by decide]
        have hcontK_eq := evaluateHOLFiniteState_seq_line780 m1 kcStmt tailStmt
        change evaluateHOLFiniteState m1 contK = _ at hcontK_eq
        rw [hcontK_eq] at hexn hnt_m1
        have hkc_none : (evaluateHOLFiniteState m1 kcStmt).1 = none := by
          rcases hkc0 : evaluateHOLFiniteState m1 kcStmt with ⟨rkc, m2'⟩
          cases rkc with
          | none => rfl
          | some r_kc =>
            exfalso
            rw [hkc0] at hexn; dsimp only at hexn
            injection hexn with hexn'; subst hexn'
            have hkc_ex : (evaluateHOLFiniteState m1 kcStmt).1 = some (.exception eid0 ev0) :=
              congrArg Prod.fst hkc0
            exact evaluate_noAnyExnProg keccakCallees_sc keccakCallees_sc_good kcStmt
              (by decide) m1 hm1_c eid0 ev0 hkc_ex
        let m2 := (evaluateHOLFiniteState m1 kcStmt).2
        have hkc : evaluateHOLFiniteState m1 kcStmt = (none, m2) := Prod.ext hkc_none rfl
        rw [hkc] at hexn; dsimp only [tailStmt] at hexn
        let Rkc : List Ivl :=
          [(hp.toNat, 32), bufferRegion m1 ("keccak_pad", 136), bufferRegion m1 ("keccak_st", 200)]
        have hkc_eff := eval_call_keccak256_heap m1
          (.rfield 0 (.var .local (ofString "r")))
          (.rfield 1 (.var .local (ofString "r")))
          (.var .local (ofString "h"))
          rpw rlw hp Rkc ["heap_ptr"] hm1_c heff_m1.arena
          (by simp [evalHOLExact, hm1_r])
          (by simp [evalHOLExact, hm1_r])
          (by simp [evalHOLExact, hm1_h])
          ⟨(hp.toNat, 32), List.mem_cons_self, le_rfl, le_rfl⟩
          (fun hnz => ⟨bufferRegion m1 ("keccak_pad", 136),
            List.mem_cons_of_mem _ List.mem_cons_self, le_rfl, by simp [bufferRegion, hnz]⟩)
          (fun hnz => ⟨bufferRegion m1 ("keccak_st", 200),
            List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self), le_rfl, by simp [bufferRegion, hnz]⟩)
          (by dsimp only [kcStmt] at hkc; rw [hkc]; simp)
          (by dsimp only [kcStmt] at hkc; rw [hkc]; exact Or.inl rfl)
        dsimp only [kcStmt] at hkc; rw [hkc] at hkc_eff
        obtain ⟨heff_m2_raw, hm2_lg⟩ := hkc_eff
        obtain ⟨hm2_loc, _⟩ := hm2_lg rfl
        have hm2_h : m2.locals.lookup (ofString "h") = some (.val (.word hp)) := by
          rw [hm2_loc]; exact hm1_h
        have hm2_node : m2.locals.lookup (ofString "node") = some (.val (.word nodew)) := by
          rw [hm2_loc]; exact hm1_node
        obtain ⟨_, _, hin_nmr, hw_nmr, _⟩ := hN_mr.1 nodew.toNat hnode_in
        have hsz_nmr := nodeSize_ge32 (memW mr nodew.toNat)
        have hhi_nmr_he : nodew.toNat + nodeSize (memW mr nodew.toNat) ≤ heapEnd := by
          have h1 := hin_nmr.2
          have h2 : globN mr "heap_ptr" ≤ heapLimit := heff_s1_mr.arena.2.2.1
          dsimp [nodeIvl] at h1; omega
        have hw_n_m2 : WordsOK m2 (nodew.toNat, nodeSize (memW mr nodew.toNat)) :=
          P3MptSet.wordsOK_transfer heff_s1_mr.arena.1 heff_m2_raw.arena.1 hw_nmr
        obtain ⟨hst_n, hm3_loc, _, _, _, _⟩ := eval_store_memW_at (s := m2) (base := nodew) (w := hp) (off := 24)
          (len := nodeSize (memW mr nodew.toNat)) (Rl := [(nodew.toNat + 24, 8)]) (gw := [])
          heff_m2_raw.arena hw_n_m2 (by decide) (by omega) hhi_nmr_he
          ⟨(nodew.toNat + 24, 8), List.mem_singleton.2 rfl, le_rfl, le_rfl⟩
          (dstExp := .op .add [.var .local (ofString "node"), .const 24])
          (valExp := .var .local (ofString "h"))
          (by simp [evalHOLExact, evalListHOLExact, hm2_node, wordOpHOL, wordOp, valueIsWord, valueWord, BitVec.add_zero])
          (by simp [evalHOLExact, hm2_h])
        let m3 := (evaluateHOLFiniteState m2
          (.store (.op .add [.var .local (ofString "node"), .const 24]) (.var .local (ofString "h")))).2
        rw [evaluateHOLFiniteState_seq_line780] at hexn
        have hst_pair : evaluateHOLFiniteState m2
            (.store (.op .add [.var .local (ofString "node"), .const 24]) (.var .local (ofString "h"))) =
            (none, m3) := Prod.ext hst_n rfl
        rw [hst_pair] at hexn; dsimp only at hexn
        have hm3_h : m3.locals.lookup (ofString "h") = some (.val (.word hp)) := by
          rw [hm3_loc]; exact hm2_h
        rw [evaluateHOLFiniteState_return] at hexn
        simp [evalHOLExact, hm3_h, shapeOfHOLExact, sizeOfShapeWithContextHOL] at hexn

theorem eval_decCall_node_hash_resumes_step {F : Type}
    (s : PanSemStateFiniteExact 64 F) (Nd : List Nat) (lname : String)
    (nodeExp : ExpHOL 64) (nodew : BitVec 64) (cont : ProgHOL 64)
    (hc : s.code = originalRuntimeCode) (hAR : ArenaReady s) (hN : NodeHeap s Nd)
    (hvs : NodeHeapValuePtrOK s Nd)
    (hkc_disj : ∀ o ∈ nodeExtents s Nd,
      Disj (bufferRegion s ("keccak_pad", 136)) o ∧
      Disj (bufferRegion s ("keccak_st", 200)) o)
    (hkc_alloc : ∀ iv ∈ keccakBufIvls s, 0 < iv.2 →
      iv.1 + iv.2 ≤ globN s "heap_ptr" ∨ globN s "scratch_ptr" ≤ iv.1)
    (hnode_ev : @evalHOLExact 64 F _ s.toExact (fun a => Classical.propDecidable (s.memaddrs a)) nodeExp =
      some (.val (.word nodew)))
    (hnode_in : nodew.toNat ∈ Nd)
    (hor : (evaluateHOLFiniteState s
        (.decCall (ofString lname) .one (ofString "node_hash") [nodeExp] cont)).1 = none ∨
      Resumes (evaluateHOLFiniteState s
        (.decCall (ofString lname) .one (ofString "node_hash") [nodeExp] cont)).1) :
    let out := evaluateHOLFiniteState s
      (.decCall (ofString lname) .one (ofString "node_hash") [nodeExp] cont)
    (∃ eid ev,
      eid ≠ ofString "TrapErr" ∧
      out.1 = some (.exception eid ev) ∧
      out.2.code = originalRuntimeCode ∧
      out.2.locals = HolFiniteMapExact.empty ∧
      HeapByteEff s out.2 (nodeCacheIvls Nd ++ keccakBufIvls s ++ [freeGap s]) ["heap_ptr", "scratch_ptr"] ∧
      globN out.2 "scratch_ptr" ≤ globN s "scratch_ptr" ∧
      NodeHeap out.2 Nd ∧
      nodeExtents out.2 Nd = nodeExtents s Nd ∧
      keccakBufIvls out.2 = keccakBufIvls s ∧
      NodeHeapValuePtrOK out.2 Nd) ∨
    (∃ (hw : BitVec 64) (mid : PanSemStateFiniteExact 64 F),
      mid.code = originalRuntimeCode ∧
      mid.locals = s.locals.update (ofString lname, .val (.word hw)) ∧
      HeapByteEff s mid (nodeCacheIvls Nd ++ keccakBufIvls s) ["heap_ptr", "scratch_ptr"] ∧
      globN mid "scratch_ptr" = globN s "scratch_ptr" ∧
      NodeHeap mid Nd ∧
      nodeExtents mid Nd = nodeExtents s Nd ∧
      NodeHeapValuePtrOK mid Nd ∧
      ((evaluateHOLFiniteState mid cont).1 = none ∨ Resumes (evaluateHOLFiniteState mid cont).1) ∧
      out.1 = (evaluateHOLFiniteState mid cont).1 ∧
      out.2 =
        { (evaluateHOLFiniteState mid cont).2 with
          locals := HolFiniteMapExact.resVarEq (evaluateHOLFiniteState mid cont).2.locals
            (ofString lname, s.locals.lookup (ofString lname)) }) := by
  intro out; dsimp only [out]
  rw [evaluateHOLFiniteState_decCall_fixClockRewrite] at hor ⊢
  have hargs : evalListHOLFinite s (h := fun a => Classical.propDecidable (s.memaddrs a)) [nodeExp] =
      some [.val (.word nodew)] := by
    simp [evalListHOLFinite, evalListHOLExact, hnode_ev]
  have hl := pan_one_word_lookup_any_sc s.code.lookup (ofString "node_hash") (ofString "node")
    (sourceFnBody Guest.Software.guestFn_node_hash) .one nodew
    (by rw [hc]; exact lookup_node_hash_sc)
  rw [hargs] at hor ⊢; dsimp only at hor ⊢; rw [hl] at hor ⊢; dsimp only at hor ⊢
  by_cases hz : s.clock = 0
  · rw [if_pos hz] at hor
    rcases hor with hn | hres
    · cases hn
    · exact False.elim (not_resumes_timeout_sc hres)
  · rw [if_neg hz] at hor ⊢
    set ent := callEntryStateHOLFinite s
      (HolFiniteMapExact.empty.update (ofString "node", .val (.word nodew)))
    have hent_AR : ArenaReady ent := ⟨guestInv_callEntry s _ hAR.1, hAR.2⟩
    have hent_node : ent.locals.lookup (ofString "node") = some (.val (.word nodew)) := by
      simp [ent, callEntryStateHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
    have hres_ent : Resumes (evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn_node_hash)).1 := by
      rcases hrun : evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn_node_hash) with ⟨rb, sb⟩
      rw [hrun] at hor
      cases rb with
      | none => rcases hor with hn | hres <;> [cases hn; exact False.elim (not_resumes_error hres)]
      | some r0 =>
        cases r0 with
        | timeOut => rcases hor with hn | hres <;> [cases hn; exact False.elim (not_resumes_timeout_sc hres)]
        | error => rcases hor with hn | hres <;> [cases hn; exact False.elim (not_resumes_error hres)]
        | «break» => rcases hor with hn | hres <;> [cases hn; exact False.elim (not_resumes_error hres)]
        | «continue» => rcases hor with hn | hres <;> [cases hn; exact False.elim (not_resumes_error hres)]
        | returned rv0 => exact Or.inl ⟨rv0, rfl⟩
        | finalFfi _ => rcases hor with hn | hres <;> [cases hn; exact False.elim (not_resumes_finalFfi_sc hres)]
        | exception eid' ev' =>
          dsimp only at hor
          rcases hor with hn | hres
          · cases hn
          · rcases hres with ⟨_, hrv⟩ | ⟨eid2, ev2, hex2, hne2⟩
            · cases hrv
            · injection hex2 with hex2'; cases hex2'
              exact Or.inr ⟨eid', ev', rfl, hne2⟩
    rcases eval_node_hash_resumes ent Nd nodew hc hent_AR hN hvs hkc_disj hkc_alloc hnode_in hent_node hres_ent with
      ⟨eid, ev, hne, hex_ent, hsb_c, heff_ent, hsp_sb, hN_sb, hext_sb, hkc_sb, hvs_sb⟩ |
      ⟨hw, hret_ent, hsb_c, heff_ent, hsp_sb, hN_sb, hext_sb, hvs_sb⟩
    · left
      set sb := (evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn_node_hash)).2
      have hpair : evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn_node_hash) =
          (some (.exception eid ev), sb) := Prod.ext hex_ent rfl
      rw [hpair]; dsimp only
      have heff_s_ent : HeapByteEff s ent
          (nodeCacheIvls Nd ++ keccakBufIvls s ++ [freeGap s]) ["heap_ptr", "scratch_ptr"] :=
        (HeapByteEff.refl hAR _ _).locals_clock ent.locals ent.clock
      have heff_out : HeapByteEff s sb.emptyLocalsHOLFinite
          (nodeCacheIvls Nd ++ keccakBufIvls s ++ [freeGap s]) ["heap_ptr", "scratch_ptr"] :=
        (heff_s_ent.trans heff_ent).locals_clock HolFiniteMapExact.empty sb.clock
      have hN_out : NodeHeap sb.emptyLocalsHOLFinite Nd :=
        (nodeHeap_of_heapByteEff_disj heff_ent.arena hN_sb
          ((HeapByteEff.refl heff_ent.arena [] []).locals_clock HolFiniteMapExact.empty sb.clock)
          (fun _ h => by simp at h)).1
      have hvs_out : NodeHeapValuePtrOK sb.emptyLocalsHOLFinite Nd :=
        nodeValuesSafe_of_heapByteEff (extra := []) heff_ent.arena hN_sb
          ((HeapByteEff.refl heff_ent.arena (nodeCacheIvls Nd ++ keccakBufIvls sb ++ []) []).locals_clock
            HolFiniteMapExact.empty sb.clock)
          rfl (fun _ h => by simp at h)
          (by
            have hkp : globN sb "keccak_pad" = globN s "keccak_pad" := by
              unfold globN; rw [← heff_ent.globals (ofString "keccak_pad") (by decide)]; rfl
            have hks : globN sb "keccak_st" = globN s "keccak_st" := by
              unfold globN; rw [← heff_ent.globals (ofString "keccak_st") (by decide)]; rfl
            rw [hext_sb]
            intro o ho; simp only [bufferRegion, hkp, hks]; exact hkc_disj o ho)
          hvs_sb
      exact ⟨eid, ev, hne, rfl, hsb_c, rfl, heff_out, hsp_sb, hN_out, hext_sb, hkc_sb, hvs_out⟩
    · right
      set sb := (evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn_node_hash)).2
      have hpair : evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn_node_hash) =
          (some (.returned (.val (.word hw))), sb) := Prod.ext hret_ent rfl
      rw [hpair] at hor ⊢; dsimp only at hor ⊢
      have hsh_one : (shapeEqHOL (shapeOfHOLExact (.val (.word hw) : ValueHOL 64)) .one &&
        shapeEqHOL (shapeOfHOLExact (.val (.word hw) : ValueHOL 64)) .one) = true := by
        simp [shapeOfHOLExact, shapeEqHOL]
      simp only [hsh_one, ↓reduceIte] at hor ⊢
      set mid := setVarHOLFinite (ofString lname) (.val (.word hw))
        { sb with locals := s.locals }
      have heff_s_ent : HeapByteEff s ent (nodeCacheIvls Nd ++ keccakBufIvls s) ["heap_ptr", "scratch_ptr"] :=
        (HeapByteEff.refl hAR _ _).locals_clock ent.locals ent.clock
      have heff_mid : HeapByteEff s mid (nodeCacheIvls Nd ++ keccakBufIvls s) ["heap_ptr", "scratch_ptr"] :=
        (heff_s_ent.trans heff_ent).locals_clock mid.locals mid.clock
      have hN_mid : NodeHeap mid Nd :=
        (nodeHeap_of_heapByteEff_disj heff_ent.arena hN_sb
          ((HeapByteEff.refl heff_ent.arena [] []).locals_clock mid.locals mid.clock)
          (fun _ h => by simp at h)).1
      have hvs_mid : NodeHeapValuePtrOK mid Nd :=
        nodeValuesSafe_of_heapByteEff (extra := []) heff_ent.arena hN_sb
          ((HeapByteEff.refl heff_ent.arena (nodeCacheIvls Nd ++ keccakBufIvls sb ++ []) []).locals_clock
            mid.locals mid.clock)
          rfl (fun _ h => by simp at h)
          (by
            have hkp : globN sb "keccak_pad" = globN s "keccak_pad" := by
              unfold globN; rw [← heff_ent.globals (ofString "keccak_pad") (by decide)]; rfl
            have hks : globN sb "keccak_st" = globN s "keccak_st" := by
              unfold globN; rw [← heff_ent.globals (ofString "keccak_st") (by decide)]; rfl
            rw [hext_sb]
            intro o ho; simp only [bufferRegion, hkp, hks]; exact hkc_disj o ho)
          hvs_sb
      exact ⟨hw, mid, hsb_c, rfl, heff_mid, hsp_sb, hN_mid, hext_sb, hvs_mid, hor, rfl, rfl⟩

/-! ## Strong `MptObj` / `MptKeeps` contracts and `mk_mpt_root_strong` -/

def MptObjInWithStrong {F : Type} (s : PanSemStateFiniteExact 64 F) (S Nm : List Nat) (m : Nat) : Prop :=
  MptObjInWith s S Nm m ∧ NodeHeapValuePtrOK s Nm

def MptObjInStrong {F : Type} (s : PanSemStateFiniteExact 64 F) (S : List Nat) : Prop :=
  ∃ Nm, MptObjInWithStrong s S Nm (locN s "m")

def MptObjAvoidsStrong (R : ∀ {F : Type}, PanSemStateFiniteExact 64 F → List Ivl) :
    ∀ {F : Type}, PanSemStateFiniteExact 64 F → Prop :=
  fun s => ArenaReady s ∧ ∃ S, WorldTyped s S ∧ MptObjInStrong s S ∧ (∀ i ∈ R s,
    (∀ t ∈ S, ∀ j ∈ htabFootprint s t, Disj i j) ∧ ∀ j ∈ fixedObjects s, Disj i j) ∧
    AvoidsTries s S ((locN s "m", 16) :: R s) ∧
    ∃ Nm Nd, MptObjInWithStrong s S Nm (locN s "m") ∧ TriesTypedWith s S Nd ∧
      ∀ o ∈ (locN s "m", 16) :: R s ++ nodeExtents s Nm, ∀ j ∈ nodeExtents s Nd, Disj o j

def MptObjReadyStrong : ∀ {F : Type}, PanSemStateFiniteExact 64 F → Prop :=
  fun s => MptObjAvoidsStrong (fun _ => []) s

def ValuePtrSafe {F : Type} (s : PanSemStateFiniteExact 64 F) (Nm : List Nat)
    (vptr vlen : Nat) : Prop :=
  vlen = 1 →
  ordinaryDomain (panByteAlignHOL (BitVec.ofNat 64 vptr)) →
  (∀ nd ∈ Nm, ¬ InIvl vptr (nd + 8, 24)) ∧
  (∀ iv ∈ keccakBufIvls s, 0 < iv.2 → ¬ InIvl vptr iv) ∧
  ¬ InIvl vptr (freeGap s) ∧
  ¬ InIvl vptr (heapFree s)

def MptSetReadyStrong : ∀ {F : Type}, PanSemStateFiniteExact 64 F → Prop :=
  fun s => MptObjReadyStrong s ∧ locN s "klen" ≤ 32 ∧ locN s "vlen" < 2 ^ 40 ∧
    ∃ S Nm, MptObjInWithStrong s S Nm (locN s "m") ∧ ValuePtrSafe s Nm (locN s "vptr") (locN s "vlen")

def MptObjStepStrong (R : ∀ {F : Type}, PanSemStateFiniteExact 64 F → List Ivl) (gw : List String)
    (keep : List (String × List Nat)) :
    ∀ {F : Type}, PanSemStateFiniteExact 64 F → PanSemStateFiniteExact 64 F → Prop :=
  fun s post =>
    ArenaReady post ∧ globN s "heap_ptr" ≤ globN post "heap_ptr" ∧
    GlobalsKept gw s post ∧ RecordsKept R keep s post ∧
    ∀ S Nd Nm, WorldTypedWith s S Nd → MptObjInWithStrong s S Nm (locN s "m") →
      IvlsDisj ((locN s "m", 16) :: R s ++ nodeExtents s Nm) (nodeExtents s Nd) →
      IvlsDisj (R s) (worldTypedIvls s S Nd ++ mptObjIvls s Nm (locN s "m")) →
      ∃ S' Nd' Nm', (∀ t ∈ S, t ∈ S') ∧ WorldTypedWith post S' Nd' ∧
        MptObjInWithStrong post S' Nm' (locN s "m") ∧
        IvlsDisj ((locN s "m", 16) :: nodeExtents post Nm') (nodeExtents post Nd') ∧
        OwnedGrows s post (worldOwned s S Nd ++ mptObjIvls s Nm (locN s "m"))
          (worldOwned post S' Nd' ++ mptObjIvls post Nm' (locN s "m")) ∧
        FrameOutside s post
          (worldOwned s S Nd ++ mptObjIvls s Nm (locN s "m") ++ R s ++ [freeGap s]) (heapFree s)

def MptKeepsStrong (P : ∀ {F : Type}, PanSemStateFiniteExact 64 F → Prop)
    (R : ∀ {F : Type}, PanSemStateFiniteExact 64 F → List Ivl) (gw : List String)
    (keep : List (String × List Nat)) (fname : MlS) : Prop :=
  FunSpec P (fun s r post => Resumes r → MptObjStepStrong R gw keep s post) fname

theorem MptObjAvoidsStrong.to_weak {F : Type}
    {R : ∀ {F : Type}, PanSemStateFiniteExact 64 F → List Ivl}
    {s : PanSemStateFiniteExact 64 F} (h : MptObjAvoidsStrong R s) :
    MptObjAvoids R s := by
  obtain ⟨hA, S, hWT, ⟨Nm0, hm0, _⟩, hR, hAv, Nm, Nd, ⟨hm, _⟩, hTr, hDj⟩ := h
  exact ⟨hA, S, hWT, ⟨Nm0, hm0⟩, hR, hAv, Nm, Nd, hm, hTr, hDj⟩

theorem MptObjReadyStrong.to_weak {F : Type} {s : PanSemStateFiniteExact 64 F}
    (h : MptObjReadyStrong s) : MptObjReady s :=
  MptObjAvoidsStrong.to_weak h

theorem MptSetReadyStrong.to_weak {F : Type} {s : PanSemStateFiniteExact 64 F}
    (h : MptSetReadyStrong s) : MptSetReady s :=
  ⟨MptObjReadyStrong.to_weak h.1, h.2.1, h.2.2.1⟩

structure MptEffStrong {F : Type}
    (R : ∀ {F : Type}, PanSemStateFiniteExact 64 F → List Ivl)
    (B : List (String × Nat))
    (gw : List String)
    (s post : PanSemStateFiniteExact 64 F) : Prop where
  arena   : ArenaReady post
  grows   : AllocatorGrows s post
  gw_kept : GlobalsKept gw s post
  dom_wr  : ∀ a : BitVec 64, post.memory a ≠ s.memory a → s.memaddrs a
  write_frame : ∀ Nm : List Nat,
    Allocated s (locN s "m", 16) →
    WordsOK s (locN s "m", 16) →
    NodeHeap s Nm →
    NodeHeapValuePtrOK s Nm →
    RootIn Nm (memW s (locN s "m")) →
    (∀ o ∈ nodeExtents s Nm, Disj o (locN s "m", 16) ∧ ∀ gs ∈ B, Disj o (bufferRegion s gs)) →
    (∀ gs ∈ B, Disj (locN s "m", 16) (bufferRegion s gs)) →
    (∀ a : BitVec 64, post.memory a ≠ s.memory a →
      (∃ ivl ∈ R s, Fast_C08WkShard03.CellHitsPos a.toNat ivl) ∨
      (∃ gs ∈ B, Fast_C08WkShard03.CellHitsPos a.toNat (bufferRegion s gs)) ∨
      (∃ o ∈ mptObjIvls s Nm (locN s "m"), Fast_C08WkShard03.CellHitsPos a.toNat o) ∨
      Fast_C08WkShard03.CellHitsPos a.toNat (freeGap s) ∨
      Fast_C08WkShard03.CellHitsPos a.toNat (heapFree s)) ∧
    (∀ b : Nat, b < 2 ^ 64 → memB post b ≠ memB s b →
      (∃ ivl ∈ R s, InIvl b ivl) ∨
      (∃ gs ∈ B, InIvl b (bufferRegion s gs)) ∨
      (∃ o ∈ mptObjIvls s Nm (locN s "m"), InIvl b o) ∨
      InIvl b (freeGap s) ∨
      InIvl b (heapFree s))
  obj_pres : ∀ Nm : List Nat,
    Allocated s (locN s "m", 16) →
    WordsOK s (locN s "m", 16) →
    NodeHeap s Nm →
    NodeHeapValuePtrOK s Nm →
    RootIn Nm (memW s (locN s "m")) →
    (∀ o ∈ nodeExtents s Nm, Disj o (locN s "m", 16) ∧ ∀ gs ∈ B, Disj o (bufferRegion s gs)) →
    (∀ gs ∈ B, Disj (locN s "m", 16) (bufferRegion s gs)) →
    IvlsDisj (R s) (mptObjIvls s Nm (locN s "m")) →
    ∃ Nm' : List Nat,
      NodeHeap post Nm' ∧
      NodeHeapValuePtrOK post Nm' ∧
      RootIn Nm' (memW post (locN s "m")) ∧
      (∀ o ∈ nodeExtents post Nm',
        o = (0, 0) ∨
        (∃ j ∈ nodeExtents s Nm, Inside o j.1 (j.1 + j.2)) ∨
        Inside o (globN s "heap_ptr") (globN post "heap_ptr"))

theorem MptEffStrong.to_mptObjStepStrong {F : Type}
    {R : ∀ {F : Type}, PanSemStateFiniteExact 64 F → List Ivl}
    {B : List (String × Nat)} {gw : List String}
    {s post : PanSemStateFiniteExact 64 F}
    (hMpt : MptObjReadyStrong s)
    (hB_ok : ∀ gs ∈ B, gs ∈ globalBuffers ∧ gs.1 ∉ typedRecords.map Prod.fst)
    (hgw_sub : ∀ g ∈ gw, ofString g = ofString "heap_ptr" ∨ ofString g = ofString "scratch_ptr")
    (heff : MptEffStrong R B gw s post) :
    MptObjStepStrong R gw Fast_C08WkShard03.stdKeep s post := by
  have hAs : ArenaReady s := hMpt.1
  have hAp : ArenaReady post := heff.arena
  have hag : AllocatorGrows s post := heff.grows
  obtain ⟨S0, hWT0, ⟨Nm0, hm0, hvs0⟩, _⟩ := hMpt.2
  obtain ⟨Nd0, hWTW0⟩ := (worldTyped_iff_with s S0).1 hWT0
  have hcore_out : ∀ g ∈ Fast_C08WkShard03.coreWorldGlobals, ofString g ∉ gw.map ofString := by
    intro g hg
    have hne : ofString g ≠ ofString "heap_ptr" ∧ ofString g ≠ ofString "scratch_ptr" := by
      revert g hg; decide
    intro hm
    obtain ⟨g', hg', heq⟩ := List.mem_map.1 hm
    rcases hgw_sub g' hg' with h1 | h2
    · exact hne.1 (heq.symm.trans h1)
    · exact hne.2 (heq.symm.trans h2)
  have hcore : ∀ g ∈ Fast_C08WkShard03.coreWorldGlobals, globN post g = globN s g :=
    fun g hg => Fast_C08WkShard03.globN_eq_of_lookup (heff.gw_kept (ofString g) (hcore_out g hg))
  have hbuf : Fast_C08WkShard03.FreshBufsOK s post :=
    R13MptKeepsTwin.freshBufsOK_of_gw_alloc heff.gw_kept hgw_sub
  have hlow : memW post 8 = memW s 8 ∧ memW post 16 = memW s 16 :=
    ⟨Fast_C08WkShard03.mem_low_eq_of_domain_writes heff.dom_wr hAs.1 (by rw [sourceBase_val]; omega),
     Fast_C08WkShard03.mem_low_eq_of_domain_writes heff.dom_wr hAs.1 (by rw [sourceBase_val]; omega)⟩
  have hbuf_fo : ∀ gs, gs ∈ globalBuffers → bufferRegion s gs ∈ fixedObjects s := by
    intro gs hgb
    unfold fixedObjects
    apply List.mem_append_left; apply List.mem_append_left; apply List.mem_append_left
    exact List.mem_map.2 ⟨gs, hgb, rfl⟩
  have hRecKept : RecordsKept R Fast_C08WkShard03.stdKeep s post := by
    have hF0 := hWTW0.2.2.1
    obtain ⟨hm0_al, hm0_w, hm0_tab, hm0_fix, hm0_nh, hm0_root, hm0_ext⟩ := hm0
    obtain ⟨hcell0, _⟩ := heff.write_frame Nm0 hm0_al hm0_w hm0_nh hvs0 hm0_root
      (fun o ho => ⟨(hm0_ext o ho).1, fun gs hgs => (hm0_ext o ho).2.2 _ (hbuf_fo gs (hB_ok gs hgs).1)⟩)
      (fun gs hgs => hm0_fix _ (hbuf_fo gs (hB_ok gs hgs).1))
    intro rec hrec hgnz k hk hnoR
    have hrec_sz : ∃ sz, (rec.1, sz) ∈ typedRecords ∧ k % 8 = 0 ∧ k + 8 ≤ sz := by
      simp only [Fast_C08WkShard03.stdKeep, List.mem_cons, List.not_mem_nil, or_false] at hrec
      rcases hrec with rfl | rfl | rfl | rfl
      · refine ⟨40, by simp [typedRecords], ?_⟩; simp at hk; omega
      · refine ⟨80, by simp [typedRecords], ?_⟩; simp at hk; omega
      · refine ⟨72, by simp [typedRecords], ?_⟩; simp at hk; omega
      · refine ⟨88, by simp [typedRecords], ?_⟩; simp at hk; omega
    obtain ⟨sz, htr, hk8, hksz⟩ := hrec_sz
    have hmf := Fast_C08WkShard03.typedRecord_mem_fixedObjects s htr
    have hmf_nz : (globN s rec.1, sz) ∈ fixedObjects s := by simpa [hgnz] using hmf
    have hwti_rec : (globN s rec.1, sz) ∈ worldTypedIvls s S0 Nd0 := by
      unfold worldTypedIvls
      apply List.mem_append.2; left; apply List.mem_append.2; left; apply List.mem_append.2; left
      apply List.mem_append.2; left; apply List.mem_append.2; right
      exact List.mem_map.2 ⟨(rec.1, sz), htr, by simp [hgnz]⟩
    rcases hF0.1 _ hmf_nz with h0 | ⟨hal, _⟩
    · omega
    · have hhi := (Fast_C08WkShard03.ivl_allocated_bound hAs.2 hal).2
      have ha_lt : globN s rec.1 + k < 2 ^ 64 := by dsimp at hhi; omega
      unfold memW
      have hmem_eq : post.memory (BitVec.ofNat 64 (globN s rec.1 + k)) =
          s.memory (BitVec.ofNat 64 (globN s rec.1 + k)) := by
        by_contra hne
        have hcases := hcell0 _ hne
        rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt ha_lt] at hcases
        have hin_rec : globN s rec.1 + k ≥ globN s rec.1 ∧ globN s rec.1 + k + 8 ≤ globN s rec.1 + sz :=
          ⟨by omega, by omega⟩
        rcases hcases with ⟨ivl, hivl, _, hhit⟩ | ⟨gs, hgs, hhit⟩ | ⟨o, ho, hhit⟩ | hfg | hhf
        · exact hnoR ivl hivl hhit
        · obtain ⟨hgs_gb, hgs_nt⟩ := hB_ok gs hgs
          have hdj := Disj.flip (Fast_C08WkShard03.untypedBuf_disj_worldTypedIvls hWTW0 gs hgs_gb hgs_nt _ hwti_rec)
          exact Fast_C08WkShard03.not_cellHitsPos_of_disj hin_rec hdj hhit
        · have hdj_o : Disj (globN s rec.1, sz) o := by
            rcases List.mem_cons.1 ho with rfl | ho_ne
            · exact Disj.flip (hm0_fix _ hmf_nz)
            · exact Disj.flip ((hm0_ext o ho_ne).2.2 _ hmf_nz)
          exact Fast_C08WkShard03.not_cellHitsPos_of_disj hin_rec hdj_o hhit
        · exact Fast_C08WkShard03.not_cellHitsPos_of_disj hin_rec
            (Fast_C08WkShard03.disj_allocated_freeGap hAs.2 hal) hfg
        · exact Fast_C08WkShard03.not_cellHitsPos_of_disj hin_rec
            (Fast_C08WkShard03.disj_allocated_heapFree hAs.2 hal) hhf
      rw [hmem_eq]
  refine ⟨hAp, hag.1, heff.gw_kept, hRecKept, fun S Nd Nm hWT hMptInS hDisjRNmNd hDisjRAll => ?_⟩
  obtain ⟨hMptIn, hvs_Nm⟩ := hMptInS
  obtain ⟨hT, hJ, hF, hTr⟩ := hWT
  obtain ⟨hm_al, hm_w, hm_tab, hm_fix, hm_nh, hm_root, hm_ext⟩ := hMptIn
  have hDisjR_wti : IvlsDisj (R s) (worldTypedIvls s S Nd) :=
    fun r hr j hj => hDisjRAll r hr j (List.mem_append_left _ hj)
  have hDisjR_obj : IvlsDisj (R s) (mptObjIvls s Nm (locN s "m")) :=
    fun r hr j hj => hDisjRAll r hr j (List.mem_append_right _ hj)
  have hDisjObj_Nd : IvlsDisj ((locN s "m", 16) :: nodeExtents s Nm) (nodeExtents s Nd) := by
    intro o ho j hj
    rcases List.mem_cons.1 ho with rfl | ho_ne
    · exact hDisjRNmNd (locN s "m", 16) List.mem_cons_self j hj
    · exact hDisjRNmNd o (List.mem_cons_of_mem _ (List.mem_append_right _ ho_ne)) j hj
  have hNm_B : ∀ o ∈ nodeExtents s Nm, Disj o (locN s "m", 16) ∧ ∀ gs ∈ B, Disj o (bufferRegion s gs) :=
    fun o ho => ⟨(hm_ext o ho).1,
      fun gs hgs => (hm_ext o ho).2.2 _ (hbuf_fo gs (hB_ok gs hgs).1)⟩
  have hm_B : ∀ gs ∈ B, Disj (locN s "m", 16) (bufferRegion s gs) :=
    fun gs hgs => hm_fix _ (hbuf_fo gs (hB_ok gs hgs).1)
  obtain ⟨hcell, hbyte⟩ := heff.write_frame Nm hm_al hm_w hm_nh hvs_Nm hm_root hNm_B hm_B
  obtain ⟨Nm', hNH_Nm', hVS_Nm', hRoot_Nm', hExt_Nm'⟩ :=
    heff.obj_pres Nm hm_al hm_w hm_nh hvs_Nm hm_root hNm_B hm_B hDisjR_obj
  let keep0 : List Ivl := R s ++ B.map (bufferRegion s) ++ mptObjIvls s Nm (locN s "m") ++ [freeGap s]
  have hfr_pos : ∀ a : BitVec 64, post.memory a ≠ s.memory a →
      (∃ j ∈ keep0, Fast_C08WkShard03.CellHitsPos a.toNat j) ∨
      Fast_C08WkShard03.CellHitsPos a.toNat (heapFree s) := by
    intro a hne
    rcases hcell a hne with ⟨ivl, hivl, hhit⟩ | ⟨gs, hgs, hhit⟩ | ⟨o, ho, hhit⟩ | hfg | hhf
    · left; refine ⟨ivl, ?_, hhit⟩
      simp only [keep0, List.mem_append]; exact Or.inl (Or.inl (Or.inl hivl))
    · left; refine ⟨bufferRegion s gs, ?_, hhit⟩
      simp only [keep0, List.mem_append]; exact Or.inl (Or.inl (Or.inr (List.mem_map.2 ⟨gs, hgs, rfl⟩)))
    · left; refine ⟨o, ?_, hhit⟩
      simp only [keep0, List.mem_append]; exact Or.inl (Or.inr ho)
    · left; refine ⟨freeGap s, ?_, hfg⟩
      simp only [keep0, List.mem_append, List.mem_singleton]; exact Or.inr trivial
    · exact Or.inr hhf
  have hm_obj_disj : ∀ o ∈ mptObjIvls s Nm (locN s "m"), ∀ i ∈ worldTypedIvls s S Nd, Disj o i := by
    intro o ho i hi
    unfold worldTypedIvls at hi
    simp only [List.mem_append] at hi
    have ho_fix_tab : (∀ t ∈ S, ∀ j ∈ htabFootprint s t, Disj o j) ∧ ∀ j ∈ fixedObjects s, Disj o j := by
      rcases List.mem_cons.1 ho with rfl | ho_ne
      · exact ⟨hm_tab, hm_fix⟩
      · exact (hm_ext o ho_ne).2
    rcases hi with ((((h1 | h2) | h3) | h4) | h5) | h6
    · obtain ⟨t, ht, hfp⟩ := List.mem_flatMap.1 h1
      exact ho_fix_tab.1 t ht i hfp
    · obtain ⟨r, hr, rfl⟩ := List.mem_map.1 h2
      exact ho_fix_tab.2 _ (Fast_C08WkShard03.typedRecord_mem_fixedObjects s hr)
    · simp only [List.mem_singleton] at h3; subst h3
      have hj_fo : (if globN s "journal_cap" = 0 then 0 else globN s "journal", 32 * globN s "journal_cap") ∈
          fixedObjects s := by
        unfold fixedObjects
        apply List.mem_append_left; apply List.mem_append_left; apply List.mem_append_right
        exact List.mem_singleton.2 rfl
      exact ho_fix_tab.2 _ hj_fo
    · have hfo : i ∈ fixedObjects s := by
        unfold fixedObjects; apply List.mem_append_left; apply List.mem_append_right; exact h4
      exact ho_fix_tab.2 _ hfo
    · have hfo : i ∈ fixedObjects s := by
        unfold fixedObjects; exact List.mem_append_right _ h5
      exact ho_fix_tab.2 _ hfo
    · exact hDisjObj_Nd o ho i h6
  have hu_wti_aligned : ∀ i ∈ worldTypedIvls s S Nd, Allocated s i → i.1 % 8 = 0 → i.2 % 8 = 0 →
      Fast_C08WkShard03.IvlUnhit s post i := by
    intro i hi hal hi1 hi2
    refine Fast_C08WkShard03.ivlUnhit_of_cellHitsPos hi1 hi2 hfr_pos (fun j hj => ?_)
      (Fast_C08WkShard03.disj_allocated_heapFree hAs.2 hal)
    simp only [keep0, List.mem_append, List.mem_singleton] at hj
    rcases hj with ((hjR | hjB) | hjM) | rfl
    · exact Disj.flip (hDisjR_wti j hjR i hi)
    · obtain ⟨gs, hgs, rfl⟩ := List.mem_map.1 hjB
      obtain ⟨hgs_gb, hgs_nt⟩ := hB_ok gs hgs
      exact Disj.flip (Fast_C08WkShard03.untypedBuf_disj_worldTypedIvls ⟨hT, hJ, hF, hTr⟩ gs hgs_gb hgs_nt i hi)
    · exact Disj.flip (hm_obj_disj j hjM i hi)
    · exact Fast_C08WkShard03.disj_allocated_freeGap hAs.2 hal
  have hu_fix_wti : ∀ i ∈ worldTypedIvls s S Nd, i ∈ fixedObjects s → i.2 ≠ 0 →
      Fast_C08WkShard03.IvlUnhit s post i := by
    intro i hwti hfi hpos
    rcases hF.1 i hfi with h0 | ⟨hal, hw⟩
    · exact absurd h0 hpos
    · exact hu_wti_aligned i hwti hal hw.1 hw.2.1
  have hu_tab : ∀ t ∈ S, ∀ i ∈ htabFootprint s t, Fast_C08WkShard03.IvlUnhit s post i := by
    intro t ht i hi
    have hal := ((hT.2.1 t ht).2 i hi).1
    have hw := ((hT.2.1 t ht).1.1 i hi).2
    refine hu_wti_aligned i ?_ hal hw.1 hw.2.1
    unfold worldTypedIvls
    apply List.mem_append.2; left; apply List.mem_append.2; left; apply List.mem_append.2; left
    apply List.mem_append.2; left; apply List.mem_append.2; left
    exact List.mem_flatMap.2 ⟨t, ht, hi⟩
  have hu_ws : globN s "ws" ≠ 0 → Fast_C08WkShard03.IvlUnhit s post (globN s "ws", 40) := fun hnz =>
    hu_fix_wti _
      (by unfold worldTypedIvls; apply List.mem_append.2; left; apply List.mem_append.2; left
          apply List.mem_append.2; left; apply List.mem_append.2; left; apply List.mem_append.2; right
          exact List.mem_map.2 ⟨("ws", 40), by simp [typedRecords], by simp [hnz]⟩)
      (by simpa [hnz] using Fast_C08WkShard03.typedRecord_mem_fixedObjects s (r := ("ws", 40)) (by simp [typedRecords]))
      (by simp)
  have hu_bs : globN s "bs" ≠ 0 → Fast_C08WkShard03.IvlUnhit s post (globN s "bs", 80) := fun hnz =>
    hu_fix_wti _
      (by unfold worldTypedIvls; apply List.mem_append.2; left; apply List.mem_append.2; left
          apply List.mem_append.2; left; apply List.mem_append.2; left; apply List.mem_append.2; right
          exact List.mem_map.2 ⟨("bs", 80), by simp [typedRecords], by simp [hnz]⟩)
      (by simpa [hnz] using Fast_C08WkShard03.typedRecord_mem_fixedObjects s (r := ("bs", 80)) (by simp [typedRecords]))
      (by simp)
  have hu_ts : globN s "ts" ≠ 0 → Fast_C08WkShard03.IvlUnhit s post (globN s "ts", 72) := fun hnz =>
    hu_fix_wti _
      (by unfold worldTypedIvls; apply List.mem_append.2; left; apply List.mem_append.2; left
          apply List.mem_append.2; left; apply List.mem_append.2; left; apply List.mem_append.2; right
          exact List.mem_map.2 ⟨("ts", 72), by simp [typedRecords], by simp [hnz]⟩)
      (by simpa [hnz] using Fast_C08WkShard03.typedRecord_mem_fixedObjects s (r := ("ts", 72)) (by simp [typedRecords]))
      (by simp)
  have hu_bo : globN s "bo" ≠ 0 → Fast_C08WkShard03.IvlUnhit s post (globN s "bo", 88) := fun hnz =>
    hu_fix_wti _
      (by unfold worldTypedIvls; apply List.mem_append.2; left; apply List.mem_append.2; left
          apply List.mem_append.2; left; apply List.mem_append.2; left; apply List.mem_append.2; right
          exact List.mem_map.2 ⟨("bo", 88), by simp [typedRecords], by simp [hnz]⟩)
      (by simpa [hnz] using Fast_C08WkShard03.typedRecord_mem_fixedObjects s (r := ("bo", 88)) (by simp [typedRecords]))
      (by simp)
  have hu_jr : globN s "journal_cap" ≠ 0 →
      Fast_C08WkShard03.IvlUnhit s post (globN s "journal", 32 * globN s "journal_cap") := by
    intro hnz
    refine hu_fix_wti _ ?_ ?_ (by omega)
    · unfold worldTypedIvls
      apply List.mem_append.2; left; apply List.mem_append.2; left; apply List.mem_append.2; left
      apply List.mem_append.2; right
      simp [hnz]
    · unfold fixedObjects
      apply List.mem_append.2; left; apply List.mem_append.2; left; apply List.mem_append.2; right
      simp [hnz]
  have hu_bo_lst : ∀ i ∈ blockOutObjects s, i.2 = 24 → Fast_C08WkShard03.IvlUnhit s post i :=
    fun i hi h24 => hu_fix_wti i
      (by unfold worldTypedIvls; apply List.mem_append.2; left; apply List.mem_append.2; left
          apply List.mem_append.2; right; exact hi)
      (by unfold fixedObjects; apply List.mem_append.2; left; apply List.mem_append.2; right; exact hi)
      (by omega)
  have hu_bal : ∀ i ∈ balObjects s, i.2 ≠ 0 → Fast_C08WkShard03.IvlUnhit s post i :=
    fun i hi hpos => hu_fix_wti i
      (by unfold worldTypedIvls; apply List.mem_append.2; left; apply List.mem_append.2; right; exact hi)
      (by unfold fixedObjects; exact List.mem_append.2 (Or.inr hi))
      hpos
  have hu_nd_rec : ∀ n ∈ Nd, Fast_C08WkShard03.IvlUnhit s post (nodeIvl s n) := fun n hn => by
    have hal := (hTr.1.1 n hn).2.1
    have hw := (hTr.1.1 n hn).2.2.2.1
    refine hu_wti_aligned _ ?_ hal hw.1 hw.2.1
    unfold worldTypedIvls; refine List.mem_append.2 (Or.inr ?_)
    unfold nodeExtents; exact List.mem_flatMap.2 ⟨n, hn, by simp [nodeIvl]⟩
  have hu_nd_byte : ∀ n ∈ Nd, (memW s n = 1 ∨ memW s n = 2) → memW s (n + 40) ≠ 0 →
      ∀ k, k < memW s (n + 40) → memB post (memW s (n + 32) + k) = memB s (memW s (n + 32) + k) := by
    intro n hn h12 hlen0 k hk
    have h264 : heapLimit ≤ 2 ^ 64 := by decide
    rcases (hTr.1.1 n hn).2.2.2.2.2.2.1 h12 with h0 | ⟨_, hal_p, hin_p, _⟩
    · exact absurd h0 hlen0
    · have hp_ne : (memW s (n + 32), memW s (n + 40)) ∈ nodeExtents s Nd := by
        unfold nodeExtents; exact List.mem_flatMap.2 ⟨n, hn, by simp [nodePath, h12, hlen0]⟩
      have hp_wti : (memW s (n + 32), memW s (n + 40)) ∈ worldTypedIvls s S Nd := by
        unfold worldTypedIvls; exact List.mem_append.2 (Or.inr hp_ne)
      by_contra hne_b
      have ha_lt : memW s (n + 32) + k < 2 ^ 64 := by have := hin_p.2; dsimp at this; omega
      rcases hbyte _ ha_lt hne_b with ⟨ivl, hivl, hin_ivl⟩ | ⟨gs, hgs, hin_gs⟩ | ⟨o, ho, hin_o⟩ | hfg | hhf
      · have hdj := hDisjR_wti ivl hivl _ hp_wti
        unfold InIvl at hin_ivl; rcases hdj with h0 | h0 | h1 | h2 <;> (dsimp at *; omega)
      · obtain ⟨hgs_gb, hgs_nt⟩ := hB_ok gs hgs
        have hdj := Fast_C08WkShard03.untypedBuf_disj_worldTypedIvls ⟨hT, hJ, hF, hTr⟩ gs hgs_gb hgs_nt _ hp_wti
        unfold InIvl at hin_gs; rcases hdj with h0 | h0 | h1 | h2 <;> (dsimp at *; omega)
      · have hdj := hDisjObj_Nd o ho _ hp_ne
        unfold InIvl at hin_o; rcases hdj with h0 | h0 | h1 | h2 <;> (dsimp at *; omega)
      · have hdj := Fast_C08WkShard03.disj_allocated_freeGap hAs.2 hal_p
        unfold InIvl at hfg; rcases hdj with h0 | h0 | h1 | h2 <;> (dsimp at *; omega)
      · have hdj := Fast_C08WkShard03.disj_allocated_heapFree hAs.2 hal_p
        unfold InIvl at hhf; rcases hdj with h0 | h0 | h1 | h2 <;> (dsimp at *; omega)
  have hbo_eq := (Fast_C08WkShard03.blockOutObjects_eq_of_bo_unhit hAs.2 hF (hcore "bo" (by decide))
    hT.2.2.2.2.2.2.2.2.2.2.1 hu_bo hu_bo_lst).1
  have hbal_eq := (Fast_C08WkShard03.balObjects_eq_of_unhit hAs.2 hT hF (hcore "bal_accounts" (by decide))
    hu_tab hu_bal hlow).1
  obtain ⟨hF_post, hfix_new⟩ := Fast_C08WkShard03.fixedTyped_of_freshBufsOK hAs hAp hag hF
    (hcore "journal" (by decide)) (hcore "journal_cap" (by decide)) hbo_eq hbal_eq hbuf
  obtain ⟨hWT_post, hOG_world, hne_eq, hfp_eq⟩ := Fast_C08WkShard03.worldTypedWith_congr_w1 hAs hAp hag hcore
    ⟨hT, hJ, hF, hTr⟩ hu_tab hu_ws hu_bs hu_ts hu_bo hu_jr hu_bo_lst hu_bal hu_nd_rec hu_nd_byte
    hlow hF_post hfix_new
  have hfix_eq : fixedObjects post = fixedObjects s := by
    unfold fixedObjects
    rw [hbo_eq, hbal_eq, hcore "journal" (by decide), hcore "journal_cap" (by decide)]
    congr 3
    apply List.map_congr_left
    intro gn hgn
    have hne : ofString gn.1 ≠ ofString "heap_ptr" ∧ ofString gn.1 ≠ ofString "scratch_ptr" := by
      revert gn hgn; decide
    have heq : globN post gn.1 = globN s gn.1 := by
      apply Fast_C08WkShard03.globN_eq_of_lookup
      apply heff.gw_kept
      intro hm
      obtain ⟨g, hg_mem, hg_eq'⟩ := List.mem_map.1 hm
      rcases hgw_sub g hg_mem with h1 | h2
      · exact hne.1 (hg_eq'.symm.trans h1)
      · exact hne.2 (hg_eq'.symm.trans h2)
    rw [heq]
  have hMptIn_post : MptObjInWithStrong post S Nm' (locN s "m") := by
    refine ⟨⟨hag.allocated hm_al, Fast_C08WkShard03.wordsOK_transfer hAs.1 hAp.1 hm_w,
      ?_, ?_, hNH_Nm', hRoot_Nm', ?_⟩, hVS_Nm'⟩
    · intro t ht i hi
      rw [hfp_eq t ht] at hi
      exact hm_tab t ht i hi
    · rw [hfix_eq]; exact hm_fix
    · intro o ho
      rcases hExt_Nm' o ho with rfl | ⟨j, hj, hin_j⟩ | hin_fr
      · exact ⟨Or.inl rfl, fun _ _ _ _ => Or.inl rfl, fun _ _ => Or.inl rfl⟩
      · refine ⟨R13MptKeepsTwin.disj_inside_left hin_j (hm_ext j hj).1, ?_, ?_⟩
        · intro t ht i hi
          rw [hfp_eq t ht] at hi
          exact R13MptKeepsTwin.disj_inside_left hin_j ((hm_ext j hj).2.1 t ht i hi)
        · rw [hfix_eq]
          intro f hf
          exact R13MptKeepsTwin.disj_inside_left hin_j ((hm_ext j hj).2.2 f hf)
      · refine ⟨R13MptKeepsTwin.disj_fresh_heap_allocated hAs.2 hAp.2 hin_fr (Or.inr hm_al), ?_, ?_⟩
        · intro t ht i hi
          rw [hfp_eq t ht] at hi
          exact R13MptKeepsTwin.disj_fresh_heap_allocated hAs.2 hAp.2 hin_fr
            (Or.inr (((hT.2.1 t ht).2 i hi).1))
        · rw [hfix_eq]
          intro f hf
          exact R13MptKeepsTwin.disj_fresh_heap_allocated hAs.2 hAp.2 hin_fr
            ((hF.1 f hf).elim Or.inl (fun h => Or.inr h.1))
  have hDisjPost : IvlsDisj ((locN s "m", 16) :: nodeExtents post Nm') (nodeExtents post Nd) := by
    rw [hne_eq]
    intro o ho p hp
    have hp_al : p.2 = 0 ∨ Allocated s p := by
      unfold nodeExtents at hp
      obtain ⟨n, hn, hnp⟩ := List.mem_flatMap.1 hp
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hnp
      rcases hnp with rfl | rfl
      · exact Or.inr (hTr.1.1 n hn).2.1
      · unfold nodePath
        split
        · rename_i hcond
          rcases (hTr.1.1 n hn).2.2.2.2.2.2.1 hcond.1 with h0 | ⟨_, hal, _⟩
          · exact absurd h0 hcond.2
          · exact Or.inr hal
        · exact Or.inl rfl
    rcases List.mem_cons.1 ho with rfl | ho_ne
    · exact hDisjObj_Nd (locN s "m", 16) List.mem_cons_self p hp
    · rcases hExt_Nm' o ho_ne with rfl | ⟨j, hj, hin_j⟩ | hin_fr
      · exact Or.inl rfl
      · exact R13MptKeepsTwin.disj_inside_left hin_j (hDisjObj_Nd j (List.mem_cons_of_mem _ hj) p hp)
      · exact R13MptKeepsTwin.disj_fresh_heap_allocated hAs.2 hAp.2 hin_fr hp_al
  have hOG_all : OwnedGrows s post
      (worldOwned s S Nd ++ mptObjIvls s Nm (locN s "m"))
      (worldOwned post S Nd ++ mptObjIvls post Nm' (locN s "m")) := by
    intro o ho
    rcases List.mem_append.1 ho with ho_w | ho_m
    · rcases hOG_world o ho_w with rfl | ⟨j, hj, hin⟩ | hfr
      · exact Or.inl rfl
      · exact Or.inr (Or.inl ⟨j, List.mem_append_left _ hj, hin⟩)
      · exact Or.inr (Or.inr hfr)
    · rcases List.mem_cons.1 ho_m with rfl | ho_ne
      · exact Or.inr (Or.inl ⟨(locN s "m", 16), List.mem_append_right _ List.mem_cons_self,
          Nat.le_refl _, Nat.le_refl _⟩)
      · rcases hExt_Nm' o ho_ne with rfl | ⟨j, hj, hin_j⟩ | hfr
        · exact Or.inl rfl
        · exact Or.inr (Or.inl ⟨j, List.mem_append_right _ (List.mem_cons_of_mem _ hj), hin_j⟩)
        · exact Or.inr (Or.inr hfr)
  refine ⟨S, Nd, Nm', fun _ ht => ht, hWT_post, hMptIn_post, hDisjPost, hOG_all, ?_⟩
  intro a hkeep hfresh
  by_contra hne
  rcases hcell a hne with ⟨ivl, hivl, _, hhit⟩ | ⟨gs, hgs, _, hhit⟩ | ⟨o, ho, _, hhit⟩ | ⟨_, hfg⟩ | ⟨_, hhf⟩
  · exact hkeep ivl (List.mem_append_left _ (List.mem_append_right _ hivl)) hhit
  · have hfo_gs := hbuf_fo gs (hB_ok gs hgs).1
    have hwo_gs : bufferRegion s gs ∈ worldOwned s S Nd := by
      unfold worldOwned; exact List.mem_append_left _ (List.mem_append_right _ hfo_gs)
    exact hkeep _ (List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _ hwo_gs))) hhit
  · exact hkeep o (List.mem_append_left _ (List.mem_append_left _ (List.mem_append_right _ ho))) hhit
  · exact hkeep (freeGap s) (List.mem_append_right _ List.mem_cons_self) hfg
  · exact hfresh hhf

private abbrev mptRootB : List (String × Nat) :=
  [("keccak_pad", 136), ("keccak_st", 200)]

private abbrev mptRootR {F : Type} (s : PanSemStateFiniteExact 64 F) : List Ivl :=
  [(locN s "out", 32),
   (globN s "keccak_pad", if globN s "keccak_pad" = 0 then 0 else 136),
   (globN s "keccak_st", if globN s "keccak_st" = 0 then 0 else 200)]

private theorem mptRootB_ok :
    ∀ gs ∈ mptRootB, gs ∈ globalBuffers ∧ gs.1 ∉ typedRecords.map Prod.fst := by
  decide

private theorem mptRoot_gw_sub :
    ∀ g ∈ (["heap_ptr", "scratch_ptr"] : List String),
      ofString g = ofString "heap_ptr" ∨ ofString g = ofString "scratch_ptr" := by
  intro g hg
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

private theorem mpt_root_params_unpack {F : Type}
    (s : PanSemStateFiniteExact 64 F) {body : ProgHOL 64} {retShape : ShapeHOL}
    (hinstalled : originalRuntimeCode.lookup (ofString "mpt_root") =
      some ([(ofString "m", .one), (ofString "out", .one)], body, retShape))
    (hshape : ∃ values, lookupCodeHOLFinite originalRuntimeCode.lookup (ofString "mpt_root") values =
      some (body, s.locals, retShape)) :
    ∃ wm wout : BitVec 64,
      s.locals.lookup (ofString "m") = some (.val (.word wm)) ∧
      s.locals.lookup (ofString "out") = some (.val (.word wout)) := by
  obtain ⟨values, hl⟩ := hshape
  have hraw := PanSemStateFiniteExact.lookupCodeHOLFinite_eq_some
    originalRuntimeCode.lookup (ofString "mpt_root") values body s.locals retShape hl
  unfold lookupCodeHOLExact at hraw
  rw [hinstalled] at hraw
  dsimp only at hraw
  split at hraw
  · rename_i hcond
    obtain ⟨_, hlen, hall⟩ := hcond
    rcases values with _ | ⟨v1, _ | ⟨v2, _ | _⟩⟩ <;> try (simp at hlen)
    simp only [List.zip, List.zipWith, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true] at hall
    obtain ⟨hs1, hs2⟩ := hall
    have word_of_one : ∀ v : ValueHOL 64, shapeEqHOL .one (shapeOfHOLExact v) = true →
        ∃ w : BitVec 64, v = .val (.word w) := by
      intro v hv
      rcases v with x | fs | ⟨nm, fs⟩
      · cases x with | word w => exact ⟨w, rfl⟩
      · simp [shapeOfHOLExact, shapeEqHOL] at hv
      · simp [shapeOfHOLExact, shapeEqHOL] at hv
    obtain ⟨wm, rfl⟩ := word_of_one v1 hs1
    obtain ⟨wout, rfl⟩ := word_of_one v2 hs2
    have hloc_fn := (Prod.mk.inj (Prod.mk.inj (Option.some.inj hraw)).2).1
    have hget : ∀ k, s.locals.lookup k =
        List.foldl (fun map (entry : MlS × ValueHOL 64) current =>
          if current = entry.1 then some entry.2 else map current) (fun _ => none)
          ((List.map Prod.fst [(ofString "m", ShapeHOL.one), (ofString "out", .one)]).zip
            [.val (.word wm), .val (.word wout)]) k :=
      fun k => congrFun hloc_fn.symm k
    refine ⟨wm, wout, ?_, ?_⟩
    · rw [hget]; simp [List.zip, List.foldl, show ofString "m" ≠ ofString "out" by decide]
    · rw [hget]; simp [List.zip, List.foldl]
  · cases hraw

private theorem keccakBufIvls_alloc_of_mptObjReadyStrong {F : Type}
    {s : PanSemStateFiniteExact 64 F} (hMpt : MptObjReadyStrong s) :
    ∀ iv ∈ keccakBufIvls s, 0 < iv.2 →
      iv.1 + iv.2 ≤ globN s "heap_ptr" ∨ globN s "scratch_ptr" ≤ iv.1 := by
  obtain ⟨_, S0, hWT0, _⟩ := hMpt
  obtain ⟨Nd0, _, _, hF0, _⟩ := (worldTyped_iff_with s S0).1 hWT0
  intro iv hiv hpos
  have hfo : iv ∈ fixedObjects s := by
    unfold fixedObjects
    apply List.mem_append_left; apply List.mem_append_left; apply List.mem_append_left
    simp only [keccakBufIvls, List.mem_cons, List.not_mem_nil, or_false] at hiv
    rcases hiv with rfl | rfl
    · exact List.mem_map.2 ⟨("keccak_pad", 136), by decide, rfl⟩
    · exact List.mem_map.2 ⟨("keccak_st", 200), by decide, rfl⟩
  rcases hF0.1 iv hfo with hz | ⟨hal, _⟩
  · omega
  · rcases hal with ⟨_, hhi⟩ | ⟨hlo, _⟩
    · exact Or.inl hhi
    · exact Or.inr hlo

private theorem mptRoot_frame_of_heapByteEff {F : Type}
    {s post : PanSemStateFiniteExact 64 F} {Nm : List Nat}
    (hN : NodeHeap s Nm)
    (heff : HeapByteEff s post
      (nodeCacheIvls Nm ++ keccakBufIvls s ++ [(locN s "out", 32)] ++ [freeGap s])
      ["heap_ptr", "scratch_ptr"]) :
    (∀ a : BitVec 64, post.memory a ≠ s.memory a →
      (∃ ivl ∈ mptRootR s, Fast_C08WkShard03.CellHitsPos a.toNat ivl) ∨
      (∃ gs ∈ mptRootB, Fast_C08WkShard03.CellHitsPos a.toNat (bufferRegion s gs)) ∨
      (∃ o ∈ mptObjIvls s Nm (locN s "m"), Fast_C08WkShard03.CellHitsPos a.toNat o) ∨
      Fast_C08WkShard03.CellHitsPos a.toNat (freeGap s) ∨
      Fast_C08WkShard03.CellHitsPos a.toNat (heapFree s)) ∧
    (∀ b : Nat, b < 2 ^ 64 → memB post b ≠ memB s b →
      (∃ ivl ∈ mptRootR s, InIvl b ivl) ∨
      (∃ gs ∈ mptRootB, InIvl b (bufferRegion s gs)) ∨
      (∃ o ∈ mptObjIvls s Nm (locN s "m"), InIvl b o) ∨
      InIvl b (freeGap s) ∨
      InIvl b (heapFree s)) := by
  refine ⟨fun a hne => ?_, fun b hb hne => ?_⟩
  · rcases heff.cell_frame a hne with ⟨iv, hiv, hhit⟩ | hfg | hhf
    · simp only [List.mem_append, List.mem_singleton] at hiv
      rcases hiv with ((hnc | hkc) | rfl) | rfl
      · obtain ⟨n, hn, rfl⟩ := List.mem_map.1 hnc
        have hsz := (R16Shards.nodeSize_bounds (memW s n)).1
        have hhit_ni : Fast_C08WkShard03.CellHitsPos a.toNat (nodeIvl s n) := by
          obtain ⟨hp, h1, h2⟩ := hhit
          exact ⟨by dsimp [nodeIvl]; omega, by dsimp [nodeIvl]; omega, by dsimp [nodeIvl]; omega⟩
        exact Or.inr (Or.inr (Or.inl ⟨nodeIvl s n,
          List.mem_cons_of_mem _ (List.mem_flatMap.2 ⟨n, hn, by simp⟩), hhit_ni⟩))
      · simp only [keccakBufIvls, List.mem_cons, List.not_mem_nil, or_false] at hkc
        rcases hkc with rfl | rfl
        · exact Or.inr (Or.inl ⟨("keccak_pad", 136), by simp [mptRootB], hhit⟩)
        · exact Or.inr (Or.inl ⟨("keccak_st", 200), by simp [mptRootB], hhit⟩)
      · exact Or.inl ⟨(locN s "out", 32), List.mem_cons_self, hhit⟩
      · exact Or.inr (Or.inr (Or.inr (Or.inl hhit)))
    · exact Or.inr (Or.inr (Or.inr (Or.inl hfg)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr hhf)))
  · rcases heff.byte_frame b hb hne with ⟨iv, hiv, hin⟩ | hfg | hhf
    · simp only [List.mem_append, List.mem_singleton] at hiv
      rcases hiv with ((hnc | hkc) | rfl) | rfl
      · obtain ⟨n, hn, rfl⟩ := List.mem_map.1 hnc
        have hsz := (R16Shards.nodeSize_bounds (memW s n)).1
        have hin_ni : InIvl b (nodeIvl s n) := by
          obtain ⟨h1, h2⟩ := hin
          exact ⟨by dsimp [nodeIvl]; omega, by dsimp [nodeIvl]; omega⟩
        exact Or.inr (Or.inr (Or.inl ⟨nodeIvl s n,
          List.mem_cons_of_mem _ (List.mem_flatMap.2 ⟨n, hn, by simp⟩), hin_ni⟩))
      · simp only [keccakBufIvls, List.mem_cons, List.not_mem_nil, or_false] at hkc
        rcases hkc with rfl | rfl
        · exact Or.inr (Or.inl ⟨("keccak_pad", 136), by simp [mptRootB], hin⟩)
        · exact Or.inr (Or.inl ⟨("keccak_st", 200), by simp [mptRootB], hin⟩)
      · exact Or.inl ⟨(locN s "out", 32), List.mem_cons_self, hin⟩
      · exact Or.inr (Or.inr (Or.inr (Or.inl hin)))
    · exact Or.inr (Or.inr (Or.inr (Or.inl hfg)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr hhf)))

private theorem mpt_root_body_eff {F : Type}
    (s : PanSemStateFiniteExact 64 F) (wm wout : BitVec 64)
    (hc : s.code = originalRuntimeCode)
    (hMpt : MptObjReadyStrong s)
    (hlk_m : s.locals.lookup (ofString "m") = some (.val (.word wm)))
    (hlk_out : s.locals.lookup (ofString "out") = some (.val (.word wout)))
    (hres : Resumes (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_mpt_root)).1) :
    MptEffStrong mptRootR mptRootB ["heap_ptr", "scratch_ptr"]
      s (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_mpt_root)).2 := by
  have hAR : ArenaReady s := hMpt.1
  have hkc_alloc := keccakBufIvls_alloc_of_mptObjReadyStrong hMpt
  obtain ⟨S0, hWT0, ⟨Nm0, hm0, hvs0⟩, _⟩ := hMpt.2
  have hloc_m : locN s "m" = wm.toNat := by simp [locN, hlk_m]
  have hloc_out : locN s "out" = wout.toNat := by simp [locN, hlk_out]
  let mcZero : ProgHOL 64 :=
    .call (some (none, none)) (ofString "memcpy")
      [.var .local (ofString "out"), .var .global (ofString "empty_trie_root"), .const 32]
  let mcHash : ProgHOL 64 :=
    .call (some (none, none)) (ofString "memcpy")
      [.var .local (ofString "out"), .var .local (ofString "h"), .const 32]
  let body1 : ProgHOL 64 :=
    .seq
      (.ite (.cmp .equal (.var .local (ofString "root")) (.const 0))
        (.seq mcZero (.return (.const 0)))
        .skip)
      (.decCall (ofString "h") .one (ofString "node_hash") [.var .local (ofString "root")]
        (.seq mcHash (.return (.const 0))))
  have hbody : sourceFnBody Guest.Software.guestFn_mpt_root =
      .dec (ofString "root") .one (.load .one (.op .add [.var .local (ofString "m"), .const 0])) body1 := rfl
  rw [hbody] at hres ⊢
  -- Evaluate `load .one (m + 0)` using `hm0.2.1 : WordsOK s (locN s "m", 16)`
  have hwm_hi : wm.toNat + 16 ≤ heapEnd := by
    have hhl_he : heapLimit ≤ heapEnd := by decide
    have hse_he : scratchEnd ≤ heapEnd := by decide
    have hhp_hl := hAR.2.2.1
    have hsp_se := hAR.2.2.2.2.2.1
    rcases hloc_m ▸ hm0.1 with ⟨_, hhi⟩ | ⟨_, hhi⟩ <;> (dsimp at hhi; omega)
  have hwm_w : WordsOK s (wm.toNat, 16) := hloc_m ▸ hm0.2.1
  have h264 : heapEnd < 2 ^ 64 := by rw [heapEnd_val]; decide
  obtain ⟨rootw, hload_ev, hroot_nat⟩ :=
    eval_load_memW_of_wordsOK (s := s) (base := wm) (off := 0) (len := 16)
      hwm_w (by simp) (by decide) (by omega)
      (e := .op .add [.var .local (ofString "m"), .const 0])
      (by simp [evalHOLExact, evalListHOLExact, hlk_m, wordOpHOL, wordOp, valueIsWord, valueWord, BitVec.add_zero])
  have hroot_memW : memW s (locN s "m") = rootw.toNat := by
    rw [hloc_m]; simpa using hroot_nat.symm
  have hdec_eq := evaluateHOLFiniteState_dec_total s (ofString "root") .one
    (.load .one (.op .add [.var .local (ofString "m"), .const 0])) body1
  dsimp only at hdec_eq
  rw [hload_ev] at hdec_eq; dsimp only at hdec_eq
  have hsh_root : shapeEqHOL .one (shapeOfHOLExact (.val (.word rootw) : ValueHOL 64)) = true := by
    simp [shapeOfHOLExact, shapeEqHOL]
  rw [if_pos hsh_root] at hdec_eq
  rw [hdec_eq] at hres ⊢
  let s1 := setVarHOLFinite (ofString "root") (.val (.word rootw)) s
  have hs1_c : s1.code = originalRuntimeCode := hc
  have hs1_AR : ArenaReady s1 := ⟨guestInv_setVar _ _ _ hAR.1, hAR.2⟩
  have hs1_root : s1.locals.lookup (ofString "root") = some (.val (.word rootw)) := by
    simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
  have hs1_out : s1.locals.lookup (ofString "out") = some (.val (.word wout)) := by
    simp [s1, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hlk_out,
      show ofString "root" ≠ ofString "out" by decide]
  have hev_cmp : @evalHOLExact 64 F _ s1.toExact (fun a => Classical.propDecidable (s1.memaddrs a))
      (.cmp .equal (.var .local (ofString "root")) (.const 0)) =
      some (.val (.word (if rootw = 0#64 then 1 else 0))) := by
