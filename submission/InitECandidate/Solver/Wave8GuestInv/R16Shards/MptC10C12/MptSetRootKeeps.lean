    (hres : Resumes (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_new_ext)).1) :
    let r := (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_new_ext)).1
    let post := (evaluateHOLFiniteState s (sourceFnBody Guest.Software.guestFn_node_new_ext)).2
    ∃ wext : BitVec 64,
      r = some (.returned (.val (.word wext))) ∧
      wext.toNat = globN s "heap_ptr" ∧
      ValExtNodeStep K V s post Nd (wext.toNat :: Nd) ∧
      RootIn (wext.toNat :: Nd) wext.toNat := by
  intro r post
  obtain ⟨wext, hr, hwext_hp, hext, hroot⟩ :=
    node_new_ext_body_ext (K := K) s Nd wnib wnlen wchild hcode hAR hNd
      hlk_nib hlk_nlen hlk_child hKey hch hProv hres
  -- Note: `node_new_ext` allocates 56 bytes (`hp + 56 = globN post "heap_ptr"`), so `nodeSize (memW post wext.toNat)`
  -- must fit inside `[globN s "heap_ptr", globN post "heap_ptr")` — wait: `nodeSize 1 = 64` and `nodeSize 3 = 176`,
