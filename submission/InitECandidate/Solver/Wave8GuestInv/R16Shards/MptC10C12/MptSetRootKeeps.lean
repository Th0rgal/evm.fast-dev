        NodeHeap out.2 Nd ∧ nodeExtents out.2 Nd = nodeExtents s Nd ∧ NodeHeapValuePtrOK out.2 Nd) := by
  intro out; dsimp only [out]
  let stCont : ProgHOL 64 :=
    .seq
      (.store (.op .add [.var .local (ofString "m"), .const 0]) (.var .local (ofString "root_node")))
      (.seq
        (.store (.op .add [.var .local (ofString "m"), .const 8]) (.var .local (ofString "secured")))
        (.return (.var .local (ofString "m"))))
