    rcases res with ⟨rb, sb⟩
    cases rb with
    | none => simp at hret
    | some rb' =>
      cases rb' with
      | returned rv =>
        have hent_AR : ArenaReady ent := localsFree_arenaReady s _ _ hAR
        have hent_node : ent.locals.lookup (ofString "node") = some (.val (.word nodew)) := by
          simp [ent, callEntryStateHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE]
        obtain ⟨rpw, rlw, hrv, hsb_c, heff_ent, hsp_sb, hN_sb, hext_sb, hkc_sb, hvs_sb, _, _⟩ :=
          eval_node_rlp_returned ent Nd nodew rv hc hent_AR hN hvs hkc_disj hkc_alloc
            hnode_in hent_node (congrArg Prod.fst hrun)
        have hsb_eq : (evaluateHOLFiniteState ent (sourceFnBody Guest.Software.guestFn_node_rlp)).2 = sb :=
          congrArg Prod.snd hrun
        rw [hsb_eq] at hsb_c heff_ent hsp_sb hN_sb hext_sb hkc_sb hvs_sb
        subst hrv
        dsimp only at hret ⊢
        let rv_pair : ValueHOL 64 := .rStruct [.val (.word rpw), .val (.word rlw)]
        have hsh_comb : (shapeEqHOL (shapeOfHOLExact rv_pair) (.comb [.one, .one]) &&
          shapeEqHOL (shapeOfHOLExact rv_pair) (.comb [.one, .one])) = true := by
