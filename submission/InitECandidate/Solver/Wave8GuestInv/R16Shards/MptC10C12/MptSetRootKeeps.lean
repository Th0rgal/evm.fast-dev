    have hs0_vptr : s0.locals.lookup (ofString "vptr") = some (.val (.word wvptr)) := by
      simp [s0, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hlk_vptr, show ofString "nd" ≠ ofString "vptr" by decide]
    have hs0_vlen : s0.locals.lookup (ofString "vlen") = some (.val (.word wvlen)) := by
      simp [s0, setVarHOLFinite, HolFiniteMapExact.lookup_update, FUPDATE, hlk_vlen, show ofString "nd" ≠ ofString "vlen" by decide]
    have hdom_slot : ∀ k : Nat, k < 64 → k % 8 = 0 → s.memaddrs (hp + BitVec.ofNat 64 k) := by
      intro k hk hk8
      rw [hG.memaddrs, (hhp_add k (by omega)).1]
