  have hmid_W : WordsOK mid (hp.toNat, 16) :=
    InitECandidate.Solver.Wave8Contracts.M26.wordsOK_of_guestInv mid heff_mid.arena.1 hp.toNat 16 hhp8 (by decide) hhp_lo hhp_hi
  have hmid_m : mid.locals.lookup (ofString "m") = some (.val (.word hp)) := by
    rw [hmid_loc]; simp [HolFiniteMapExact.lookup_update, FUPDATE]
  have hmid_rn : mid.locals.lookup (ofString "root_node") = some (.val (.word w_rn)) := by
    rw [hmid_loc]; simp [HolFiniteMapExact.lookup_update, FUPDATE, hrn,
