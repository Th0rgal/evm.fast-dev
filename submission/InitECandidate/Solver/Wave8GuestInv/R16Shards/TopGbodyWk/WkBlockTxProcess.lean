  intro hnz
  obtain ⟨halloc, hhead, hentry⟩ := h hnz
  exact ⟨halloc, fun i hi j hj => hhead i hi j (hsub j hj),
    fun k hk i hi j hj => hentry k hk i hi j (hsub j hj)⟩

theorem retFrameResultStrong_logsDisjFixed {F : Type}
