      hsr.2.1.1 hdom
      ⟨rfl, rfl, rfl, rfl, rfl, rfl, fun a hne => by unfold pmcUpdW; exact if_neg hne⟩
      hWT_p
      (fun j hj => disj_of_inside_right (j' := (w_out.toNat, 96)) ⟨hx_in.1, hx_in.2⟩
