    rw [hseq] at hnt hres ⊢
    have hmid_eq : mid = { s with locals := mid.locals, clock := s.clock } := rfl
    have hws0 : WorldStep (fun _ => []) ["heap_ptr"] stdKeep NoExtra s none s :=
