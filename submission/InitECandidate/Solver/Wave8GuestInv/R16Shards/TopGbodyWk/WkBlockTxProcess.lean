              have hMA_dep2 : R10Shards.Fast_GbodyC17ToC21.MsgReadyAt s_dep
                  (S0_dep2 ++ [memW s (locN s "msg" + 152), memW s (locN s "msg" + 160)]) Nd_dep2 :=
