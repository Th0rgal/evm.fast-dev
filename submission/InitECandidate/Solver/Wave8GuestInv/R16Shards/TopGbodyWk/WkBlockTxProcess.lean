        rcases hk with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> omega
      rw [R13Shards.rec_word_eq_of_unhit hAp_mid.2 hF_m "bs" 80 (by decide) (hg_pm_post "bs") hnz (hu_bs_m hnz) hbk.1 hbk.2]
