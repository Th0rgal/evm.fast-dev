    · obtain ⟨t, ht, hi⟩ := List.mem_flatMap.1 ho_tab
      rw [(htab_fp_hdr t ht).2, M13.htabFootprint_eq hcell_mid ht (hT.2.1 t ht).1] at hi
      refine Or.inr (Or.inl ⟨o, ?_, le_refl _, le_refl _⟩)
      unfold worldOwned
