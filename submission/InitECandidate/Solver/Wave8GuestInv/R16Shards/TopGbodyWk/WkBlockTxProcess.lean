        · exact disj_zero_right x
        · rcases hal_j with ⟨_, hhi_j⟩ | ⟨hlo_j, _⟩
          · exact Or.inr (Or.inr (Or.inr (Nat.le_trans hhi_j hx_fresh.1)))
          · exact Or.inr (Or.inr (Or.inl (by
