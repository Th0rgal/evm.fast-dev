  have hlw_nz_nat : lw.toNat ≠ 0 := fun h => hlw_nz (BitVec.eq_of_toNat_eq (by simpa using h))
  rw [htot]; dsimp only
  exact ptxBlockOutUnhit_of_bre_arr hW hlw_nz_nat (Or.inr (Or.inr rfl)) horig hbre_emp

