  obtain ⟨Nd_en, hWT_en⟩ := (worldTyped_iff_with entry S_en).1 hWT_en0
  obtain ⟨hAs, hhp, hG, hK, hW⟩ := hstep
  have hx_ord : x.toNat % 8 = 0 ∧ sourceBase ≤ x.toNat ∧ x.toNat < heapEnd := by
