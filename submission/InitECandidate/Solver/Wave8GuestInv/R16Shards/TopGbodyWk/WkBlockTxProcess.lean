      Inside (w.toNat, 280) (globN post "scratch_ptr") scratchEnd ∧
      IvlsDisj [(w.toNat, 280)] (worldOwned post S Nd) ∧
      PmcLogsLiveOwned post S Nd (memW post (w.toNat + 88)) ∧
      PmcLogsDisjOut s post (memW post (w.toNat + 88))

