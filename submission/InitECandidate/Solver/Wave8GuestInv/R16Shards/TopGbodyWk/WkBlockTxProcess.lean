  obtain ⟨Nd_ok, hWT_ok⟩ := (worldTyped_iff_with s1 S_ok).1 hWT_ok0
  have hrec_not_fresh : ∀ rec ∈ pmcKeep, globN s1 rec.1 ≠ 0 → ∀ off ∈ rec.2,
