  obtain ⟨S_p, Nd_p, _, hWT_p, _, _, hout_ow_p, hlive_p⟩ := hsr.2.1.2.2.2.2 S_en Nd_en hMA_en.2.1 hT_en hD_en
  have hx_lt : w_out.toNat + 16 < 2 ^ 64 := by omega
