              have hout_ow_dep_at : IvlsDisj [(w_out.toNat, 96)]
                  (worldOwned s_dep (S0_dep2 ++ [memW s (locN s "msg" + 152), memW s (locN s "msg" + 160)]) Nd_dep2) := by
                intro x hx j hj
                simp only [List.mem_singleton] at hx; subst hx
