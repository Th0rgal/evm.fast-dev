  obtain ⟨ck, heval⟩ := ptx_release_calls_exact s_cur mExp fExp w_mark w_fmark hcode hA_cur hm hf hnt
  exact ⟨ck, heval, worldTypedWith_release_marks_ptx hA_pmc hA_cur hWT_pmc hWT_cur hOG hhp_le
