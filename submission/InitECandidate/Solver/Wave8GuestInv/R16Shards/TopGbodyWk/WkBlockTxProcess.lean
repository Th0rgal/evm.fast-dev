/-- Ordinary table merging composes with any withdrawal-framed continuation. -/
theorem progWithdrawalStepBo_union_bs_then (off : BitVec 64)
    (hoff : off.toNat ∈ [8, 16, 24, 40, 48]) (src : ExpHOL 64)
