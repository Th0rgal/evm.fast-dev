    {r1 r2 : Option (PanSemResultExact 64)}
    {w_out : BitVec 64}
    (hA1 : ArenaReady s1)
    (hWOK1 : WorldOK s1)
    (hR1_sub : ∀ j ∈ R1 s1, j ∈ bufRegions pmcBufs s1 ∨
      Inside j (globN s1 "heap_ptr") (globN s2 "heap_ptr"))
    (hR2_sub : ∀ j ∈ R2 s2, j ∈ bufRegions pmcBufs s2 ∨
      Inside j (globN s1 "heap_ptr") (globN s3 "heap_ptr"))
