  obtain ⟨S_en, Nd_en, hMA_en⟩ := R10Shards.Fast_GbodyC17ToC21.msgReadyAt_of_msgReady hM0
  have hT_en : ∀ t ∈ pmcTables entry, t ∈ S_en := by
